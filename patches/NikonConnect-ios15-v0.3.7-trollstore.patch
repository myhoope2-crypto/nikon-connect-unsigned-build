+            else { result = try await remote.cameraParameters(only: codes) }
+            guard connection.activeSession?.id == sessionID else { return }
+            acceptParameters(result, replacing: full ? nil : codes)
+        } catch {
+            guard connection.activeSession?.id == sessionID else { return }
+            // 错误后停止轮询，保留取景连接；由用户刷新重试，避免持续占用相机。
+            autoParameterRefresh = false
+            parameterStatus = "参数同步失败，显示值可能已过期。请刷新重试。"
+            shell.appendLog("相机参数读取失败：\(shell.userFacingMessage(for: error))")
