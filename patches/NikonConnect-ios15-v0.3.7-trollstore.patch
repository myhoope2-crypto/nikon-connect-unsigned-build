@@ -0,0 +1,58 @@
+import SwiftUI
+
+struct ConnectionProgressView: View {
+    @ObservedObject private var progress = CameraConnectionProgress.shared
+    var body: some View {
+        if progress.attemptID != nil {
+            CustomCard {
+                VStack(alignment: .leading, spacing: 12) {
+                    HStack {
+                        Label("连接进度", systemImage: "point.topleft.down.curvedto.point.bottomright.up").font(.headline)
+                        Spacer()
+                        Text("\(progress.elapsedSeconds) 秒").font(.caption).foregroundColor(AppTheme.inkMuted)
+                    }
+                    Text(progress.cameraName).font(.subheadline.bold())
+                    ForEach(CameraConnectionStep.allCases) { step in
+                        HStack(spacing: 10) {
+                            if progress.states[step] == .running { ProgressView().frame(width: 20) }
+                            else { Image(systemName: symbol(progress.states[step] ?? .pending)).frame(width: 20) }
+                            Text(step.title)
+                            Spacer()
+                            Text(label(progress.states[step] ?? .pending)).font(.caption)
+                        }.foregroundColor(color(progress.states[step] ?? .pending))
+                    }
+                    Text(progress.detail).font(.footnote).fixedSize(horizontal: false, vertical: true)
+                    Text("显示真实阶段；“未经过”表示此连接无需该步骤，或当前路径未单独执行该步骤。")
+                        .font(.caption).foregroundColor(AppTheme.inkMuted)
+                }.foregroundColor(AppTheme.ink)
+            }.accessibilityElement(children: .contain)
+        }
+    }
+    private func symbol(_ state: CameraConnectionProgress.State) -> String {
+        switch state {
+        case .completed: return "checkmark.circle.fill"
+        case .skipped: return "minus.circle"
+        case .failed: return "exclamationmark.circle.fill"
+        case .cancelled: return "stop.circle"
+        default: return "circle"
+        }
+    }
+    private func label(_ state: CameraConnectionProgress.State) -> String {
+        switch state {
+        case .pending: return "等待"
+        case .running: return "进行中"
+        case .completed: return "完成"
+        case .skipped: return "未经过"
+        case .failed: return "失败"
+        case .cancelled: return "已停止"
+        }
+    }
+    private func color(_ state: CameraConnectionProgress.State) -> Color {
+        switch state {
+        case .completed: return AppTheme.success
+        case .failed: return AppTheme.danger
+        case .running: return AppTheme.accentStrong
+        default: return AppTheme.inkMuted
+        }
+    }
+}
