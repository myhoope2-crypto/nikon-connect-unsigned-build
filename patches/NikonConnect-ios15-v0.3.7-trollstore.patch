+import Security
+
+enum NearbyCameraBrand: String, Codable, Sendable {
+    case fuji, nikon, sony, canon, panasonic, ricoh, pentax, olympus, leica, hasselblad, unknown
+    var title: String { switch self {
+        case .fuji: return "富士"; case .nikon: return "尼康"; case .sony: return "索尼"; case .canon: return "佳能"
+        case .panasonic: return "松下"; case .ricoh: return "理光"; case .pentax: return "宾得"
+        case .olympus: return "奥林巴斯／OM"; case .leica: return "徕卡"; case .hasselblad: return "哈苏"; case .unknown: return "身份待确认"
+    } }
+    var mode: CameraTransportMode? { switch self {
+        case .fuji: return .experimentalFuji; case .nikon: return .experimentalNikon
+        case .sony: return .experimentalSony; case .canon: return .experimentalCanon
+        case .panasonic: return .experimentalPanasonic; case .ricoh, .pentax: return .experimentalRicoh
+        case .olympus: return .experimentalOlympus; case .leica, .hasselblad, .unknown: return nil
+    } }
+}
+struct NearbyCamera: Identifiable, Codable, Equatable, Sendable {
+    var id: UUID
+    var name: String
+    var brand: NearbyCameraBrand
+    var signal: Int?
