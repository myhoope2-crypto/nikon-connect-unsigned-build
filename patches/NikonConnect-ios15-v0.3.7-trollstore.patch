+        ("NOT3", CBUUID(string: "7170fd5a-56d9-4c19-b043-7a7047d8e1a0")),
+        ("网络名称", wifiSSID),
+        ("NOT5", CBUUID(string: "75823784-fbb7-4b71-abae-cd9a34072e3c")),
+        ("NOT6", CBUUID(string: "e6692c5c-b7cd-44f4-95fc-eda07ce32560")),
+        ("NOT7", CBUUID(string: "aab609c4-94dd-4d89-bc60-665d5090b828")),
