+                    return
+                }
+                discovery.remember(camera)
+                try Task.checkCancellation()
+                if await withTaskCancellationHandler(operation:{ await connectionViewModel.connect(progressID: progressID) },onCancel:{ Task { @MainActor in connectionViewModel.stopConnecting() } }) {
