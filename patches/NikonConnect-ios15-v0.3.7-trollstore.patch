+    ].map { value in
+        let choices = value.2.enumerated().map { CameraParameterChoice(data: Data([UInt8($0.offset)]), title: $0.element) }
+        return CameraParameter(id: value.0, title: value.1, current: choices[0], choices: choices, writable: true)
+    }
+
+    @MainActor static func resetIfRequested() {
