diff --git a/Services/CameraConnectionProgress.swift b/Services/CameraConnectionProgress.swift
new file mode 100644
index 0000000..50a1d48
--- /dev/null
+++ b/Services/CameraConnectionProgress.swift
@@ -0,0 +1,83 @@
+import Foundation
+
+enum CameraConnectionStep: Int, CaseIterable, Identifiable {
+    case preparation, bluetooth, hotspot, joining, address, handshake, connected
+    var id: Int { rawValue }
+    var title: String {
+        switch self {
+        case .preparation: return "确认所选相机"
+        case .bluetooth: return "蓝牙配对 / 启动热点"
+        case .hotspot: return "发现相机 Wi-Fi"
+        case .joining: return "加入相机 Wi-Fi"
+        case .address: return "确认网络地址"
+        case .handshake: return "建立相机协议会话"
+        case .connected: return "连接完成"
+        }
+    }
+}
+
+@MainActor
+final class CameraConnectionProgress: ObservableObject {
+    enum State: Equatable { case pending, running, completed, skipped, failed, cancelled }
+    static let shared = CameraConnectionProgress()
+    @Published private(set) var attemptID: UUID?
+    @Published private(set) var cameraName = ""
+    @Published private(set) var states: [CameraConnectionStep: State] = [:]
+    @Published private(set) var detail = ""
+    @Published private(set) var elapsedSeconds = 0
+    @Published private(set) var isRunning = false
+    private var clockTask: Task<Void, Never>?
+
+    @discardableResult
+    func begin(camera: String, bluetooth: Bool) -> UUID {
+        clockTask?.cancel()
+        let id = UUID(); attemptID = id; cameraName = camera
+        states = Dictionary(uniqueKeysWithValues: CameraConnectionStep.allCases.map { ($0, .pending) })
+        if !bluetooth { states[.bluetooth] = .skipped }
+        states[.preparation] = .running; detail = "正在确认连接方式…"
+        elapsedSeconds = 0; isRunning = true
+        let started = Date()
+        clockTask = Task { [weak self] in
+            while !Task.isCancelled {
+                do { try await Task.sleep(nanoseconds: 1_000_000_000) } catch { return }
+                guard let self, self.attemptID == id, self.isRunning else { return }
+                self.elapsedSeconds = Int(Date().timeIntervalSince(started))
+            }
+        }
+        return id
+    }
+
+    func advance(_ step: CameraConnectionStep, id: UUID?, detail: String) {
+        guard let id, attemptID == id, isRunning else { return }
+        for earlier in CameraConnectionStep.allCases where earlier.rawValue < step.rawValue {
+            if states[earlier] == .running { states[earlier] = .completed }
+            // 未执行的阶段保留为“未经过”，不伪装成已经成功。
+            else if states[earlier] == .pending { states[earlier] = .skipped }
+        }
+        states[step] = .running; self.detail = detail
+    }
+
+    func complete(id: UUID?) {
+        advance(.connected, id: id, detail: "相机协议握手成功，可以使用已开放的功能。")
+        guard let id, attemptID == id, isRunning else { return }
+        states[.connected] = .completed; finish()
+    }
+
+    func fail(id: UUID?, message: String, cancelled: Bool = false) {
+        guard let id, attemptID == id, isRunning else { return }
+        for step in CameraConnectionStep.allCases where states[step] == .running {
+            states[step] = cancelled ? .cancelled : .failed
+        }
+        detail = message; finish()
+    }
+
+    func waitForUser(id: UUID?, message: String) {
+        guard let id, attemptID == id, isRunning else { return }
+        detail = message
+        for step in CameraConnectionStep.allCases where states[step] == .running { states[step] = .pending }
+        finish()
+    }
+
+    private func finish() { isRunning = false; clockTask?.cancel(); clockTask = nil }
+    func reset() { finish(); attemptID = nil; states = [:]; detail = "" }
+}
diff --git a/Services/CameraHTTPClient.swift b/Services/CameraHTTPClient.swift
new file mode 100644
index 0000000..9847ea0
--- /dev/null
+++ b/Services/CameraHTTPClient.swift
@@ -0,0 +1,162 @@
+import Foundation
+
+enum CameraJSON: Codable, Sendable {
+    case object([String: CameraJSON]), array([CameraJSON]), string(String), number(Double), bool(Bool), null
+    init(from decoder: any Decoder) throws {
+        let c = try decoder.singleValueContainer()
+        if c.decodeNil() { self = .null }
+        else if let v = try? c.decode(Bool.self) { self = .bool(v) }
+        else if let v = try? c.decode(String.self) { self = .string(v) }
+        else if let v = try? c.decode(Double.self) { self = .number(v) }
+        else if let v = try? c.decode([String: CameraJSON].self) { self = .object(v) }
+        else { self = .array(try c.decode([CameraJSON].self)) }
+    }
+    func encode(to encoder: any Encoder) throws {
+        var c = encoder.singleValueContainer()
+        switch self {
+        case .object(let v): try c.encode(v); case .array(let v): try c.encode(v)
+        case .string(let v): try c.encode(v); case .number(let v): try c.encode(v)
+        case .bool(let v): try c.encode(v); case .null: try c.encodeNil()
+        }
+    }
+    subscript(_ key: String) -> CameraJSON { if case .object(let v) = self { return v[key] ?? .null }; return .null }
+    var string: String? { if case .string(let v) = self { return v }; return nil }
+    var array: [CameraJSON] { if case .array(let v) = self { return v }; return [] }
+    var object: [String: CameraJSON] { if case .object(let v) = self { return v }; return [:] }
+    var integer: Int64? {
+        if case .number(let v) = self, v.isFinite, v >= Double(Int64.min), v < Double(Int64.max) { return Int64(v) }
+        if let string { return Int64(string) }; return nil
+    }
+}
+
+final class CameraHTTPClient: @unchecked Sendable {
+    let baseURL: URL
+    private let session: URLSession
+    init(host: String, port: Int, headers:[String:String] = [:]) throws {
+        var components = URLComponents(); components.scheme = "http"; components.host = host; components.port = port
+        guard (1...65535).contains(port), let url = components.url else { throw CameraAppError.invalidPort }
+        baseURL = url
+        let config = URLSessionConfiguration.ephemeral
+        config.allowsCellularAccess = !(UserDefaults.standard.object(forKey: "cameraWiFiOnly.v1") as? Bool ?? true)
+        config.waitsForConnectivity = false; config.timeoutIntervalForRequest = 15
+        config.timeoutIntervalForResource = 1800; config.urlCache = nil
+        config.httpAdditionalHeaders = headers
+        session = URLSession(configuration: config, delegate: CameraHTTPRedirectGuard(host: host, port: port), delegateQueue: nil)
+    }
+    func close() { session.invalidateAndCancel() }
+    func jpegFrame(_ reference:String) async throws -> Data {
+        let config = URLSessionConfiguration.ephemeral; config.timeoutIntervalForRequest = 5; config.timeoutIntervalForResource = 8
+        config.allowsCellularAccess = !(UserDefaults.standard.object(forKey: "cameraWiFiOnly.v1") as? Bool ?? true)
+        let stream = URLSession(configuration:config,delegate:CameraHTTPRedirectGuard(host:baseURL.host ?? "",port:baseURL.port ?? 80),delegateQueue:nil)
+        defer { stream.invalidateAndCancel() }
+        let (bytes,response) = try await stream.bytes(for:URLRequest(url:url(reference)))
+        try validate(response); var data = Data(); var last:UInt8 = 0
+        for try await byte in bytes {
+            try Task.checkCancellation(); guard data.count < 4*1024*1024 else { throw PTPIPError.malformedPayload("实时画面过大") }
+            data.append(byte)
+            if last == 0xff && byte == 0xd9, data.count > 4 { return try CameraMediaFormat.jpeg(in:data) }
+            last = byte
+        }
+        throw CameraAppError.unsupportedOperation("相机未返回完整实时画面。")
+    }
+    func data(_ reference: String, method: String = "GET", body: Data? = nil,
+              query: String? = nil, headers: [String:String] = [:]) async throws -> Data {
+        var request = URLRequest(url: try url(reference,query:query)); request.httpMethod = method; request.httpBody = body
+        for (key,value) in headers { request.setValue(value,forHTTPHeaderField:key) }
+        return try await boundedData(request)
+    }
+    func url(_ reference: String, query: String? = nil) throws -> URL {
+        guard let result = URL(string: reference, relativeTo: baseURL)?.absoluteURL,
+              result.host?.lowercased() == baseURL.host?.lowercased(),
+              result.port == baseURL.port, result.scheme == baseURL.scheme,
+              result.user == nil, result.password == nil, result.fragment == nil,
+              !result.path.components(separatedBy: "/").contains("..") else {
+            throw CameraAppError.unsupportedOperation("相机返回了不属于当前连接的文件地址。")
+        }
+        if let query {
+            var c = URLComponents(url: result, resolvingAgainstBaseURL: false)!
+            c.query = query; return c.url!
+        }
+        return result
+    }
+    func json(_ reference: String, method: String = "GET", body: CameraJSON? = nil, query: String? = nil) async throws -> CameraJSON {
+        var request = URLRequest(url: try url(reference, query: query)); request.httpMethod = method
+        if let body { request.httpBody = try JSONEncoder().encode(body); request.setValue("application/json", forHTTPHeaderField: "Content-Type") }
+        let data = try await boundedData(request)
+        return try JSONDecoder().decode(CameraJSON.self, from: data)
+    }
+    func thumbnail(_ reference: String, query: String) async throws -> Data {
+        let data = try await boundedData(URLRequest(url: url(reference, query: query)))
+        guard !data.isEmpty, data.count <= 8 * 1024 * 1024 else { throw PTPIPError.malformedPayload("缩略图大小无效") }
+        return data
+    }
+    private func boundedData(_ request: URLRequest) async throws -> Data {
+        let (bytes, response) = try await session.bytes(for: request)
+        try validate(response)
+        var data = Data()
+        for try await byte in bytes {
+            guard data.count < 8 * 1024 * 1024 else { throw PTPIPError.malformedPayload("相机列表或缩略图超过大小限制") }
+            data.append(byte)
+        }
+        return data
+    }
+    func download(_ reference: String, expectedSize: Int64,
+        progress: (@Sendable (DownloadTransferProgress) async -> Void)?) async throws -> URL {
+        let delegate = CameraHTTPProgress(expectedSize: expectedSize, progress: progress)
+        let (temporary, response) = try await session.download(for: URLRequest(url: url(reference)), delegate: delegate)
+        do {
+            try validate(response); try Task.checkCancellation()
+            let target = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString + ".camera")
+            try FileManager.default.moveItem(at: temporary, to: target)
+            return target
+        } catch { try? FileManager.default.removeItem(at: temporary); throw error }
+    }
+    private func validate(_ response: URLResponse) throws {
+        guard let http = response as? HTTPURLResponse, http.statusCode == 200 else {
+            let code = (response as? HTTPURLResponse)?.statusCode ?? 0
+            throw CameraAppError.networkProbeFailed(code == 401 ? "相机要求身份验证，当前通道尚不支持该认证方式。" : "相机 HTTP 响应码：\(code)。")
+        }
+    }
+    static func date(_ value: String?) -> Date {
+        guard let value else { return .distantPast }
+        let iso = ISO8601DateFormatter()
+        if let date = iso.date(from: value) { return date }
+        iso.formatOptions.insert(.withFractionalSeconds)
+        if let date = iso.date(from: value) { return date }
+        let f = DateFormatter(); f.locale = Locale(identifier: "en_US_POSIX")
+        f.dateFormat = "EEE, dd MMM yyyy HH:mm:ss Z"; return f.date(from: value) ?? .distantPast
+    }
+}
+
+private final class CameraHTTPRedirectGuard: NSObject, URLSessionTaskDelegate, @unchecked Sendable {
+    let host: String; let port: Int
+    init(host: String, port: Int) { self.host = host; self.port = port }
+    func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse,
+        newRequest request: URLRequest, completionHandler: @escaping @Sendable (URLRequest?) -> Void) {
+        let allowed = request.url?.host == host && request.url?.port == port && request.url?.scheme == "http"
+        completionHandler(allowed ? request : nil)
+    }
+}
+
+private final class CameraHTTPProgress: NSObject, URLSessionDownloadDelegate, @unchecked Sendable {
+    let expectedSize: Int64
+    let progress: (@Sendable (DownloadTransferProgress) async -> Void)?
+    init(expectedSize: Int64, progress: (@Sendable (DownloadTransferProgress) async -> Void)?) {
+        self.expectedSize = expectedSize; self.progress = progress
+    }
+    func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse,
+        newRequest request: URLRequest, completionHandler: @escaping @Sendable (URLRequest?) -> Void) {
+        let origin = task.originalRequest?.url
+        let allowed = request.url?.host == origin?.host && request.url?.port == origin?.port
+            && request.url?.scheme == origin?.scheme && request.url?.user == nil && request.url?.password == nil
+        completionHandler(allowed ? request : nil)
+    }
+    func urlSession(_ session: URLSession, downloadTask: URLSessionDownloadTask, didFinishDownloadingTo location: URL) {}
+    func urlSession(_ session: URLSession, downloadTask: URLSessionDownloadTask, didWriteData bytesWritten: Int64,
+        totalBytesWritten: Int64, totalBytesExpectedToWrite: Int64) {
+        let update = DownloadTransferProgress(bytesTransferred: totalBytesWritten,
+            totalBytes: max(expectedSize, max(totalBytesExpectedToWrite, totalBytesWritten)), resumedCount: 0,
+            currentOffset: totalBytesWritten, chunkSize: bytesWritten)
+        if let progress { Task { await progress(update) } }
+    }
+}
diff --git a/Services/CameraNetworkDiscovery.swift b/Services/CameraNetworkDiscovery.swift
new file mode 100644
index 0000000..6c00bec
--- /dev/null
+++ b/Services/CameraNetworkDiscovery.swift
@@ -0,0 +1,197 @@
+import Foundation
+import CryptoKit
+import Darwin
+@preconcurrency import Network
+
+// Wi-Fi 发现只使用公开的 Bonjour 和当前网络单播，不依赖需要苹果单独批准的组播权限。
+@MainActor
+final class CameraNetworkDiscovery: NSObject, @preconcurrency NetServiceBrowserDelegate, @preconcurrency NetServiceDelegate {
+    static let shared = CameraNetworkDiscovery()
+    private var task: Task<Void,Never>?
+    private var token = UUID()
+    private var browsers: [NetServiceBrowser] = []
+    private var services: [NetService] = []
+    private var onFound: ((NearbyCamera)->Void)?
+    private var onStatus: ((String)->Void)?
+    private var probing: Set<String> = []
+    func start(saved:[NearbyCamera],onFound:@escaping (NearbyCamera)->Void,onStatus:@escaping (String)->Void) {
+        stop(); self.onFound = onFound; self.onStatus = onStatus; let id = token
+        guard let network = Self.wifiHosts() else { onStatus("未检测到可用 Wi-Fi 地址，蓝牙搜索仍可继续。纯 Wi-Fi 相机请先加入其网络。"); return }
+        onStatus("正在搜索当前 Wi-Fi 的邻近网段及相机服务…")
+        #if TROLLSTORE
+        // 富士的命令端口留给用户选定后的完整握手，不先短连后断开。
+        // 热点名称和保存记录仅提供候选，不能视为协议认证。
+        if let ssid = TrollWiFiBridge.shared().currentSSID(),
+           TrollWiFiNetwork.brand(forSSID: ssid) == .fuji || CameraWiFiCoordinator.shared.profiles.contains(where: {
+               $0.ssid == ssid && ($0.mode == .experimentalFuji || $0.mode == .experimentalFujiLegacy)
+           }), network.contains("192.168.0.1") {
+            onFound(Self.candidate("192.168.0.1", 55740, .fuji, "富士热点名称候选（待握手确认）", .experimentalFuji))
+        }
+        #endif
+        for type in ["_ptp._tcp.","_http._tcp."] {
+            let browser = NetServiceBrowser(); browser.delegate = self; browsers.append(browser)
+            browser.searchForServices(ofType:type,inDomain:"local.")
+        }
+        var hosts = Set(network)
+        for value in saved { if let host = value.connectionHost, Self.isLocal(host) { hosts.insert(host) } }
+        // 主动探测限于当前 Wi-Fi 的至多 254 个地址；更大子网仍可经 Bonjour 发现或高级地址连接。
+        let list = hosts.sorted()
+        task = Task {
+            for start in stride(from:0,to:list.count,by:16) {
+                guard !Task.isCancelled, token == id else { return }
+                let chunk = Array(list[start..<min(start+16,list.count)])
+                await withTaskGroup(of:[NearbyCamera].self) { group in
+                    for host in chunk { group.addTask { await Self.probe(host) } }
+                    for await items in group {
+                        guard !Task.isCancelled, token == id else { group.cancelAll(); break }
+                        for item in items { self.onFound?(item) }
+                    }
+                }
+            }
+            guard token == id, !Task.isCancelled else { return }
+            #if TROLLSTORE
+            self.onStatus?("当前 Wi-Fi 网段搜索完成；附近未加入的热点显示在巨魔热点列表。")
+            #else
+            self.onStatus?("当前 Wi-Fi 网段搜索完成；无法扫描尚未加入的其他 Wi-Fi 热点。更大网段可使用高级地址或 Bonjour。")
+            #endif
+        }
+    }
+    func stop() {
+        token = UUID(); task?.cancel(); task = nil
+        for browser in browsers { browser.stop() }; browsers = []
+        for service in services { service.stop() }; services = []; probing = []
+        onFound = nil; onStatus = nil
+    }
+    func netServiceBrowser(_ browser:NetServiceBrowser,didFind service:NetService,moreComing:Bool) {
+        services.append(service); service.delegate = self; service.resolve(withTimeout:3)
+    }
+    func netServiceDidResolveAddress(_ sender:NetService) {
+        guard let host = sender.hostName, host.hasSuffix(".local."), !probing.contains(host) else { return }
+        #if TROLLSTORE
+        if sender.port == 55740 {
+            probing.insert(host)
+            onFound?(Self.candidate(host, 55740, .fuji, "富士服务广播候选（待握手确认）", .experimentalFuji))
+            return
+        }
+        #endif
+        probing.insert(host); let id = token; let port = sender.port
+        Task {
+            let items = await Self.probe(host,advertisedPort:port)
+            guard token == id else { return }; for item in items { onFound?(item) }
+        }
+    }
+    nonisolated static func isLocal(_ host:String) -> Bool {
+        let values = host.split(separator:".").compactMap { Int($0) }
+        guard values.count == 4, values.allSatisfy({ (0...255).contains($0) }) else { return host.hasSuffix(".local.") || host.hasSuffix(".local") }
+        return values[0] == 10 || (values[0] == 192 && values[1] == 168) ||
+            (values[0] == 172 && (16...31).contains(values[1])) || (values[0] == 169 && values[1] == 254)
+    }
+    nonisolated private static func wifiHosts() -> [String]? {
+        var pointer: UnsafeMutablePointer<ifaddrs>?
+        guard getifaddrs(&pointer) == 0 else { return nil }; defer { freeifaddrs(pointer) }
+        var current = pointer
+        while let item = current {
+            defer { current = item.pointee.ifa_next }
+            guard String(cString:item.pointee.ifa_name) == "en0", let address = item.pointee.ifa_addr,
+                  address.pointee.sa_family == UInt8(AF_INET), let mask = item.pointee.ifa_netmask else { continue }
+            let ip = address.withMemoryRebound(to:sockaddr_in.self,capacity:1) { UInt32(bigEndian:$0.pointee.sin_addr.s_addr) }
+            let netmask = mask.withMemoryRebound(to:sockaddr_in.self,capacity:1) { UInt32(bigEndian:$0.pointee.sin_addr.s_addr) }
+            let boundedMask = netmask | 0xffffff00
+            let low = ip & boundedMask; let high = low | ~boundedMask
+            guard high > low + 1 else { return [] }
+            return ((low+1)..<high).filter { $0 != ip }.map { value in "\((value >> 24)&255).\((value >> 16)&255).\((value >> 8)&255).\(value&255)" }
+        }
+        return nil
+    }
+    nonisolated private static func probe(_ host:String,advertisedPort:Int? = nil) async -> [NearbyCamera] {
+        guard isLocal(host), !Task.isCancelled else { return [] }
+        let ports = Set([80,8080,60606,15740,55740] + (advertisedPort.map { [$0] } ?? []))
+        return await withTaskGroup(of:[NearbyCamera].self,returning:[NearbyCamera].self) { group in
+            for port in ports where (1...65535).contains(port) {
+                #if TROLLSTORE
+                if port == 55740 { continue }
+                #endif
+                group.addTask {
+                    guard await CameraPortProbe.open(host:host,port:port), !Task.isCancelled else { return [] }
+                    if port == 15740 { return [candidate(host,port,.unknown,"PTP 无线相机候选",nil)] }
+                    if port == 55740 { return [candidate(host,port,.fuji,"富士无线相机候选",.experimentalFuji)] }
+                    var result: [NearbyCamera] = []
+                    if port == 60606, let data = await read(host,port,"/Lumix/Server0/ddd"), let xml = try? CameraXML.parse(data),
+                       (xml.first("manufacturer") ?? "").uppercased().contains("PANASONIC") {
+                        result.append(candidate(host,80,.panasonic,xml.first("friendlyName") ?? xml.first("modelNumber") ?? "LUMIX",.experimentalPanasonic))
+                    }
+                    if let data = await read(host,port,"/ccapi"), let json = try? JSONDecoder().decode(CameraJSON.self,from:data),
+                       json.object.values.flatMap(\.array).contains(where:{ $0["url"].string?.hasSuffix("/deviceinformation") == true }) {
+                        result.append(candidate(host,port,.canon,"佳能 CCAPI 相机",.experimentalCanon))
+                    }
+                    if port == 80 {
+                        if let data = await read(host,port,"/v1/props"), let json = try? JSONDecoder().decode(CameraJSON.self,from:data),
+                           let model = json["model"].string, (json["manufacturer"].string ?? "").uppercased().contains("RICOH") || model.uppercased().contains("PENTAX") {
+                            result.append(candidate(host,port,model.uppercased().contains("PENTAX") ? .pentax : .ricoh,model,.experimentalRicoh))
+                        }
+                        if let data = await read(host,port,"/get_caminfo.cgi"), let xml = try? CameraXML.parse(data),
+                           let model = xml.first("model"), !model.isEmpty, xml.first("version") != nil || xml.first("serial") != nil {
+                            result.append(candidate(host,port,.olympus,model,.experimentalOlympus))
+                        }
+                    }
+                    return result
+                }
+            }
+            var result: [NearbyCamera] = []; for await items in group { result += items }; return result
+        }
+    }
+    nonisolated private static func read(_ host:String,_ port:Int,_ path:String) async -> Data? {
+        var components = URLComponents(); components.scheme = "http"; components.host = host; components.port = port; components.path = path
+        guard let url = components.url else { return nil }
+        let config = URLSessionConfiguration.ephemeral; config.timeoutIntervalForRequest = 1; config.timeoutIntervalForResource = 2
+        config.allowsCellularAccess = false
+        config.urlCache = nil; config.connectionProxyDictionary = [:]
+        let session = URLSession(configuration:config,delegate:DiscoveryRedirectGuard(),delegateQueue:nil); defer { session.invalidateAndCancel() }
+        var request = URLRequest(url:url); request.setValue("OI.Share v2",forHTTPHeaderField:"User-Agent")
+        do {
+            let (bytes,response) = try await session.bytes(for:request)
+            guard (response as? HTTPURLResponse)?.statusCode == 200 else { return nil }
+            var result = Data()
+            for try await byte in bytes { guard result.count < 512*1024 else { return nil }; result.append(byte) }
+            return result
+        } catch { return nil }
+    }
+    nonisolated private static func candidate(_ host:String,_ port:Int,_ brand:NearbyCameraBrand,_ name:String,_ mode:CameraTransportMode?) -> NearbyCamera {
+        let hex = SHA256.hash(data:Data("\(host):\(port)".utf8)).prefix(16).map { String(format:"%02x",$0) }.joined()
+        let id = "\(hex.prefix(8))-\(hex.dropFirst(8).prefix(4))-\(hex.dropFirst(12).prefix(4))-\(hex.dropFirst(16).prefix(4))-\(hex.suffix(12))"
+        return NearbyCamera(id:UUID(uuidString:id)!,name:name,brand:brand,signal:nil,connectionHost:host,servicePort:port,networkMode:mode)
+    }
+}
+private final class DiscoveryRedirectGuard:NSObject,URLSessionTaskDelegate,@unchecked Sendable {
+    func urlSession(_ session:URLSession,task:URLSessionTask,willPerformHTTPRedirection response:HTTPURLResponse,newRequest request:URLRequest,completionHandler:@escaping @Sendable (URLRequest?)->Void) { completionHandler(nil) }
+}
+private final class CameraPortProbe: @unchecked Sendable {
+    private let lock = NSLock()
+    private var continuation: CheckedContinuation<Bool,Never>?
+    private var finished = false
+    private var connection: NWConnection?
+    static func open(host:String,port:Int) async -> Bool {
+        let probe = CameraPortProbe()
+        return await withTaskCancellationHandler {
+            await withCheckedContinuation { continuation in probe.begin(host:host,port:port,continuation:continuation) }
+        } onCancel: { probe.finish(false) }
+    }
+    private func begin(host:String,port:Int,continuation:CheckedContinuation<Bool,Never>) {
+        lock.lock()
+        guard !finished else { lock.unlock(); continuation.resume(returning:false); return }
+        self.continuation = continuation
+        let params = NWParameters.tcp; params.requiredInterfaceType = .wifi
+        let connection = NWConnection(host:NWEndpoint.Host(host),port:NWEndpoint.Port(rawValue:UInt16(port))!,using:params)
+        self.connection = connection; lock.unlock()
+        connection.stateUpdateHandler = { [weak self] state in
+            switch state { case .ready: self?.finish(true); case .failed,.cancelled: self?.finish(false); default: break }
+        }
+        connection.start(queue:.global(qos:.utility))
+        DispatchQueue.global(qos:.utility).asyncAfter(deadline:.now()+0.6) { self.finish(false) }
+    }
+    private func finish(_ result:Bool) {
+        lock.lock(); guard !finished else { lock.unlock(); return }; finished = true
+        let pending = continuation; continuation = nil; let connection = connection; self.connection = nil; lock.unlock()
+        connection?.cancel(); pending?.resume(returning:result)
+    }
+}
