+            } catch {
+                selectionStatus = "连接未完成：\(shell.userFacingMessage(for:error))"
+                CameraConnectionProgress.shared.fail(id: progressID, message: selectionStatus)
+            }
+        }
+    }
+    private func identifyPTPCamera(host:String,port:Int) async throws -> CameraTransportMode {
+        let peer = PTPIPSession(host:host,port:UInt16(port))
+        do {
+            let info = try await withTaskCancellationHandler { try await peer.establishConnection() } onCancel: { Task { await peer.abortConnection() } }
+            await peer.closeSessionTransport(); try Task.checkCancellation()
+            let manufacturer = (info.manufacturer ?? "").uppercased()
+            if manufacturer.contains("NIKON") { return .experimentalNikon }
+            if manufacturer.contains("SONY") { return .experimentalSony }
+            throw CameraAppError.unsupportedOperation("已读取相机身份，但本版尚未接入 \(info.manufacturer ?? "该厂商") 的此种无线协议。")
+        } catch { await peer.abortConnection(); throw error }
+    }
+    private func connectAndRead() {
+        Task { if await connectionViewModel.connect() { await galleryViewModel.refreshPhotos() } }
     }
 }
 
