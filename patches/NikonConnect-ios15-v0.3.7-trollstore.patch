+++ b/Services/PTPIPSession+RemoteControl.swift
@@ -0,0 +1,216 @@
+import Foundation
+
+extension PTPIPSession {
+    func remoteData(_ code: PTPOperationCode, parameters: [UInt32] = []) async throws -> Data {
+        try await withExclusiveCommandChannelAccess {
+            try ensureOpen()
+            return try await requestDataInDirect(operation: code, transactionID: consumeTransactionID(), parameters: parameters)
+        }
+    }
+
+    func remoteCommand(_ code: PTPOperationCode, parameters: [UInt32] = []) async throws {
+        try await withExclusiveCommandChannelAccess {
+            try ensureOpen()
+            _ = try await requestResponseOnlyDirect(operation: code, transactionID: consumeTransactionID(), parameters: parameters)
+        }
+    }
+
+    func setRemoteProperty(_ code: UInt16, data: Data) async throws {
+        try await withExclusiveCommandChannelAccess {
+            try ensureOpen()
+            let transaction = consumeTransactionID()
+            try await commandConnection.send(PTPIPBinary.encodeOperationRequest(operation: .setDevicePropValue,
+                transactionID: transaction, parameters: [UInt32(code)], dataPhase: .dataOut))
+            var start = Data(); start.appendUInt32LE(transaction); start.appendUInt64LE(UInt64(data.count))
+            try await commandConnection.send(PTPIPBinary.encodePacket(type: .startData, payload: start))
+            var payload = Data(); payload.appendUInt32LE(transaction); payload.append(data)
+            try await commandConnection.send(PTPIPBinary.encodePacket(type: .endData, payload: payload))
+            let packet = try await commandConnection.receivePacket()
+            try Self.validateResponse(PTPIPBinary.parseResponsePacket(packet), expectedTransactionID: transaction)
+        }
+    }
+
+    func photoAssetForValidation(_ info: PTPIPObjectInfo, cameraSession: CameraSession) throws -> PhotoAsset {
+        guard case .asset(let asset) = classifyObject(info, hintedKind: nil, hintedCaptureDate: nil) else {
+            throw CameraAppError.unsupportedOperation("相机原对象已不再是可下载照片。")
+        }
+        return asset.scoped(to: cameraSession)
+    }
+
+    func resetCaptureWatch() { watchSeenHandles = nil; pendingAddedHandles.removeAll() }
+
+    func newCaptureAssets() async throws -> [PhotoAsset] {
+        let storage = try await loadStorageIDs()
+        let discovery = try await loadObjectHandles(storageIDs: storage)
+        let handles = Set(discovery.handles)
+        guard let baseline = watchSeenHandles else {
+            watchSeenHandles = handles
+            pendingAddedHandles.removeAll()
+            return []
+        }
+        let added = handles.subtracting(baseline).union(pendingAddedHandles)
+        var result: [PhotoAsset] = []
+        for handle in added.sorted().prefix(60) {
+            try Task.checkCancellation()
+            let info = try await fetchObjectInfo(handle: handle)
+            if case .asset(let asset) = classifyObject(info, hintedKind: nil, hintedCaptureDate: nil) {
+                result.append(asset)
+            }
+            watchSeenHandles?.insert(handle)
+            pendingAddedHandles.remove(handle)
+        }
+        return result
+    }
+}
+
+extension ExperimentalNikonTransport {
+    func startLiveView() async throws {
+        guard let session else { throw CameraAppError.notConnected }
+        if await session.deviceInfo?.operationsSupported.contains(0x90c2) == true {
+            try await session.remoteCommand(.nikonChangeCameraMode, parameters: [1])
+        }
+        try await session.remoteCommand(.vendor9201)
+    }
+
+    func liveViewFrame() async throws -> Data {
+        guard let session else { throw CameraAppError.notConnected }
+        let data = try await session.remoteData(.nikonGetLiveView)
+        // 尼康实时帧元数据的图像坐标范围为大端 UInt16；仅在头部长度及尺寸合理时开放点击对焦。
+        if CameraSettingCatalog.isNikonZ(await session.deviceInfo?.model ?? ""),
+           let jpeg = data.range(of: Data([0xff, 0xd8, 0xff])), jpeg.lowerBound >= 24 {
+            let width = UInt16(data[4]) << 8 | UInt16(data[5])
+            let height = UInt16(data[6]) << 8 | UInt16(data[7])
+            if (64...16000).contains(width), (64...16000).contains(height) {
+                focusCoordinateSize = (width, height)
+            } else { focusCoordinateSize = nil }
+        } else { focusCoordinateSize = nil }
+        return try CameraMediaFormat.jpeg(in: data)
+    }
+
+    func stopLiveView() async {
+        focusCoordinateSize = nil
+        guard let session else { return }
+        try? await session.remoteCommand(.vendor9202)
+        if await session.deviceInfo?.operationsSupported.contains(0x90c2) == true {
+            try? await session.remoteCommand(.nikonChangeCameraMode, parameters: [0])
+        }
+    }
+
+    func releaseShutter() async throws {
+        guard let session else { throw CameraAppError.notConnected }
+        // 0xfffffffe：自动对焦；0：保存到相机卡，不使用临时 SDRAM 对象。
+        try await session.remoteCommand(.nikonCaptureToCard, parameters: [0xfffffffe, 0])
+    }
+
+    func cameraParameters() async throws -> [CameraParameter] {
+        try await loadCameraParameters(only: nil)
+    }
+    func cameraParameters(only codes: Set<UInt16>) async throws -> [CameraParameter] {
+        try await loadCameraParameters(only: codes)
+    }
+    private func discoverRemoteProperties(session: PTPIPSession, info: PTPIPDeviceInfo?) async throws {
+        guard !remotePropertyDiscoveryCompleted else { return }
+        var discovered = info?.propertiesSupported ?? []
+        var receivedVendorList = false
+        // 标准 DeviceInfo 经常不含尼康厂商属性。只调用机身明确宣告的扩展操作。
+        for operation in [PTPOperationCode.nikonGetVendorPropCodes, .nikonGetVendorCodes] {
+            guard info?.supportsOperation(operation) == true else { continue }
+            do {
+                let extended = operation == .nikonGetVendorCodes
+                let data = try await session.remoteData(operation, parameters: extended ? [0x0d] : [])
+                var reader = PTPDataReader(data: data)
+                let count = try reader.readUInt32()
+                let width = extended ? 4 : 2
+                guard UInt64(count) <= UInt64(reader.remainingCount / width) else {
+                    throw PTPIPError.malformedPayload("尼康扩展参数列表长度无效。")
+                }
+                for _ in 0..<Int(count) {
+                    let code: UInt32
+                    if extended { code = try reader.readUInt32() }
+                    else { code = UInt32(try reader.readUInt16()) }
+                    // 32 位属性需要另一套描述协议，不能截断为 16 位后写入同号属性。
+                    if code <= UInt32(UInt16.max) { discovered.insert(UInt16(code)) }
+                }
+                receivedVendorList = true
+            } catch let error as PTPIPError {
+                if case .unexpectedResponse(let code) = error, code == 0x2005 { continue }
+                throw error
+            }
+        }
+        remoteAdvertisedProperties = discovered
+        remoteVendorPropertiesAdvertised = receivedVendorList
+        remotePropertyDiscoveryCompleted = true
+    }
+    private func loadCameraParameters(only codes: Set<UInt16>?) async throws -> [CameraParameter] {
+        guard let session else { throw CameraAppError.notConnected }
+        let info = await session.deviceInfo
+        try await discoverRemoteProperties(session: session, info: info)
+        let model = info?.model ?? ""
+        var result: [CameraParameter] = []
+        for (code, title) in CameraParameterDecoder.definitions(profile: .nikon) {
+            if let codes, !codes.contains(code) { continue }
+            if remoteUnsupportedProperties.contains(code) { continue }
+            if !remoteAdvertisedProperties.contains(code) {
+                // 未开放扩展发现的机身只有限探测本应用目录内的厂商属性，并缓存明确的不支持响应。
+                if code >= 0xd000 {
+                    if remoteVendorPropertiesAdvertised { continue }
+                } else if info?.propertiesSupported != nil { continue }
+            }
+            do {
+                let data = try await session.remoteData(.getDevicePropDesc, parameters: [UInt32(code)])
+                do { result.append(try CameraParameterDecoder.decode(data, code: code, title: title, profile: .nikon, model: model)) }
+                catch CameraAppError.unsupportedOperation(let reason) {
+                    result.append(CameraParameter(id: code, title: title,
+                        current: .init(data: Data(), title: "数据格式未支持", recognized: false), choices: [], writable: false,
+                        profile: .nikon, unavailableReason: reason))
+                }
+            } catch let error as PTPIPError {
+                if case .unexpectedResponse(let response) = error, [0x2005, 0x200a].contains(response) {
+                    remoteUnsupportedProperties.insert(code); continue
+                }
+                throw error
+            }
+        }
+        return CameraParameterDecoder.preferred(result, profile: .nikon)
+    }
+    func setCameraParameter(_ parameter: UInt16, to choice: CameraParameterChoice) async throws {
+        guard let session else { throw CameraAppError.notConnected }
+        let available = try await cameraParameters(only: [parameter])
+        guard let current = available.first(where: { $0.id == parameter }), current.canChange,
+              current.editableChoices.contains(where: { $0.data == choice.data }) else {
+            throw CameraAppError.unsupportedOperation("相机当前模式不允许设置这个值，或值的含义尚未确认。请刷新参数。")
+        }
+        if current.current.data == choice.data { return }
+        try await session.setRemoteProperty(parameter, data: choice.data)
+    }
+    func focusCapabilities() async -> CameraFocusCapabilities {
+        guard let session, let info = await session.deviceInfo else { return CameraFocusCapabilities() }
+        let autofocus = info.operationsSupported.contains(0x90c1)
+        let touch = info.operationsSupported.contains(0x9205) && focusCoordinateSize != nil
+        return CameraFocusCapabilities(autofocus: autofocus, touchFocus: touch,
+            reason: touch ? "点击画面移动焦点；对焦结果以机身为准。" :
+                "点击对焦需要相机开放 0x9205 并返回有效画面坐标；当前未满足。")
+    }
+    func focus(at point: CameraFocusPoint?) async throws {
+        guard let session else { throw CameraAppError.notConnected }
+        let capabilities = await focusCapabilities()
+        if let point {
+            guard capabilities.touchFocus, let size = focusCoordinateSize,
+                  point.x.isFinite, point.y.isFinite, (0...1).contains(point.x), (0...1).contains(point.y) else {
+                throw CameraAppError.unsupportedOperation(capabilities.reason)
+            }
+            let x = UInt32((point.x * Double(size.width - 1)).rounded())
+            let y = UInt32((point.y * Double(size.height - 1)).rounded())
+            try await session.remoteCommand(.nikonChangeFocusArea, parameters: [x, y])
+        }
+        if capabilities.autofocus { try await session.remoteCommand(.nikonAutofocus) }
+        else if point == nil { throw CameraAppError.unsupportedOperation("相机未开放自动对焦命令。") }
+    }
+
+    func beginCaptureWatch() async { await session?.resetCaptureWatch() }
+
+    func newlyCapturedAssets(in cameraSession: CameraSession) async throws -> [PhotoAsset] {
+        guard let session else { throw CameraAppError.notConnected }
+        return try await session.newCaptureAssets().map { $0.scoped(to: cameraSession) }
+    }
+}
