+                    .font(.footnote).foregroundColor(AppTheme.inkMuted)
+                #endif
+            }.navigationTitle("加入相机 Wi-Fi").navigationBarTitleDisplayMode(.inline)
+                .toolbar { ToolbarItem(placement:.cancellationAction) { Button("关闭") { dismiss() }.disabled(busy) } }
+        }.navigationViewStyle(.stack)
+    }
