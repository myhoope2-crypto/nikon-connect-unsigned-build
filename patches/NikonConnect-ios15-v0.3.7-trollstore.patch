+    @State private var busy = false
+    @State private var message = ""
+    let onJoined:()->Void
+    var body:some View {
+        NavigationView {
+            Form {
+                Section(header:Text("加入后自动搜索，无需选择品牌")) {
+                    Text("适用于已开启热点的纯 Wi-Fi 相机。填写机身显示的网络信息，应用请求加入后会搜索并识别相机。")
+                        .foregroundColor(AppTheme.inkMuted)
+                    TextField("相机 Wi-Fi 名称",text:$ssid).textInputAutocapitalization(.never).disableAutocorrection(true)
