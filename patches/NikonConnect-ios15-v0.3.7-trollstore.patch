diff --git a/Services/TrollStore/TrollWiFiBridge.m b/Services/TrollStore/TrollWiFiBridge.m
new file mode 100644
index 0000000..53a7695
--- /dev/null
+++ b/Services/TrollStore/TrollWiFiBridge.m
@@ -0,0 +1,265 @@
+#import "TrollWiFiBridge.h"
+#import <CoreFoundation/CoreFoundation.h>
+#import <dlfcn.h>
+
+// 按公开的 MobileWiFi C 接口独立编写；动态加载，缺少接口时返回错误。
+// 不读取系统保存的其他网络密码，不修改无线开关，不申请 root 或解除沙箱。
+typedef CFTypeRef MWRef;
+typedef void (*MWScanCallback)(MWRef, CFArrayRef, int, const void *);
+typedef void (*MWJoinCallback)(MWRef, MWRef, CFDictionaryRef, int, const void *);
+static MWRef (*mwCreate)(CFAllocatorRef, int);
+static CFArrayRef (*mwDevices)(MWRef);
+static void (*mwSchedule)(MWRef, CFRunLoopRef, CFStringRef);
+static void (*mwUnschedule)(MWRef);
+static int (*mwScan)(MWRef, CFDictionaryRef, MWScanCallback, const void *);
+static int (*mwJoin)(MWRef, MWRef, MWJoinCallback, CFDictionaryRef);
+static void (*mwCancelJoin)(MWRef);
+static MWRef (*mwCurrent)(MWRef);
+static CFStringRef (*mwSSID)(MWRef);
+static CFTypeRef (*mwProperty)(MWRef, CFStringRef);
+static void (*mwPassword)(MWRef, CFStringRef);
+static Boolean (*mwRequiresPassword)(MWRef);
+static Boolean (*mwIsEAP)(MWRef);
+static Boolean (*mwIsWEP)(MWRef);
+static int (*mwPower)(MWRef);
+static void scanDone(MWRef device, CFArrayRef networks, int error, const void *token);
+static void joinDone(MWRef device, MWRef network, CFDictionaryRef info, int error, const void *token);
+
+// 关联接口末参数是配置字典，并非调用方上下文。每次操作使用独立 manager/device，
+// 按回调的 device 找回代次；取消后的迟到回调不能结束下一次操作。
+@interface MWOperation : NSObject
+@property(nonatomic) MWRef manager;
+@property(nonatomic) MWRef device;
+@property(nonatomic) MWRef network;
+@property(nonatomic) uintptr_t token;
+@end
+@implementation MWOperation
+- (void)dealloc {
+    if (_manager && mwUnschedule) mwUnschedule(_manager);
+    if (_network) CFRelease(_network);
+    if (_device) CFRelease(_device);
+    if (_manager) CFRelease(_manager);
+}
+@end
+static NSMutableDictionary<NSValue *, MWOperation *> *pendingOperations;
+
+@interface TrollWiFiBridge () {
+    MWRef _manager;
+    MWRef _device;
+    uintptr_t _generation;
+    BOOL _joining;
+    BOOL _scanning;
+}
+@property(nonatomic, strong) NSMutableDictionary<NSString *, id> *networks;
+@property(nonatomic, strong, nullable) MWOperation *operation;
+@property(nonatomic, copy, nullable) NSString *lastScanDetail;
+@property(nonatomic, copy, nullable) void (^scanCompletion)(NSString * _Nullable, NSError * _Nullable);
+@property(nonatomic, copy, nullable) void (^joinCompletion)(NSError * _Nullable);
+- (void)finishScan:(CFArrayRef)networks code:(int)code token:(uintptr_t)token;
+- (void)finishJoin:(int)code token:(uintptr_t)token;
+@end
+
+@implementation TrollWiFiBridge
++ (instancetype)shared { static TrollWiFiBridge *value; static dispatch_once_t once; dispatch_once(&once, ^{ value = [TrollWiFiBridge new]; }); return value; }
+- (NSError *)failure:(NSString *)text code:(NSInteger)code {
+    return [NSError errorWithDomain:@"CameraConnect.TrollWiFi" code:code userInfo:@{NSLocalizedDescriptionKey:text}];
+}
+- (NSError *)prepare {
+    NSAssert([NSThread isMainThread], @"MobileWiFi operations require the main run loop");
+    if (_device) return nil;
+    static void *library;
+    if (!library) library = dlopen("/System/Library/PrivateFrameworks/MobileWiFi.framework/MobileWiFi", RTLD_NOW | RTLD_LOCAL);
+    if (!library) return [self failure:@"本系统无法加载无线接口，请使用手动加入方式。" code:1];
+#define MW_LOAD(variable, name) variable = dlsym(library, name)
+    MW_LOAD(mwCreate, "WiFiManagerClientCreate"); MW_LOAD(mwDevices, "WiFiManagerClientCopyDevices");
+    MW_LOAD(mwSchedule, "WiFiManagerClientScheduleWithRunLoop"); MW_LOAD(mwScan, "WiFiDeviceClientScanAsync");
+    MW_LOAD(mwUnschedule, "WiFiManagerClientUnscheduleFromRunLoop");
+    MW_LOAD(mwJoin, "WiFiDeviceClientAssociateAsync"); MW_LOAD(mwCancelJoin, "WiFiDeviceClientAssociateCancel");
+    MW_LOAD(mwCurrent, "WiFiDeviceClientCopyCurrentNetwork"); MW_LOAD(mwSSID, "WiFiNetworkGetSSID");
+    MW_LOAD(mwProperty, "WiFiNetworkGetProperty"); MW_LOAD(mwPassword, "WiFiNetworkSetPassword");
+    MW_LOAD(mwRequiresPassword, "WiFiNetworkRequiresPassword"); MW_LOAD(mwIsEAP, "WiFiNetworkIsEAP");
+    MW_LOAD(mwIsWEP, "WiFiNetworkIsWEP"); MW_LOAD(mwPower, "WiFiDeviceClientGetPower");
+#undef MW_LOAD
+    if (!mwCreate || !mwDevices || !mwSchedule || !mwScan || !mwJoin || !mwCancelJoin || !mwCurrent || !mwSSID || !mwProperty || !mwPassword || !mwRequiresPassword || !mwIsEAP || !mwIsWEP)
+        return [self failure:@"本系统无线接口不完整，已停用直接入网。" code:2];
+    MWRef manager = mwCreate(kCFAllocatorDefault, 0);
+    if (!manager) return [self failure:@"无线管理权限不可用，请确认安装的是巨魔专用包。" code:3];
+    CFArrayRef devices = mwDevices(manager);
+    if (!devices || !CFArrayGetCount(devices)) {
+        if (devices) CFRelease(devices); CFRelease(manager);
+        return [self failure:@"无法访问无线设备。请开启 Wi-Fi，并确认巨魔安装保留了无线管理权限。" code:4];
+    }
+    MWRef selected = NULL;
+    // 手机通常仅一个 STA 接口；优先 en0，避免把其他无线虚拟设备当作主接口。
+    CFStringRef (*getInterface)(MWRef) = dlsym(library, "WiFiDeviceClientGetInterfaceName");
+    for (CFIndex i = 0; i < CFArrayGetCount(devices); i++) {
+        MWRef device = CFArrayGetValueAtIndex(devices, i);
+        if (!selected) selected = device;
+        if (getInterface && [(__bridge NSString *)getInterface(device) isEqualToString:@"en0"]) { selected = device; break; }
+    }
+    _manager = manager; _device = CFRetain(selected); CFRelease(devices);
+    self.networks = [NSMutableDictionary new];
+    mwSchedule(_manager, CFRunLoopGetMain(), kCFRunLoopCommonModes);
+    return nil;
+}
+- (MWOperation *)newOperation {
+    if (!pendingOperations) pendingOperations = [NSMutableDictionary new];
+    // 不回调的系统请求至多保留八个，避免无限积累；普通完成会立即释放。
+    if (pendingOperations.count >= 8) return nil;
+    MWRef manager = mwCreate(kCFAllocatorDefault, 0); if (!manager) return nil;
+    CFArrayRef devices = mwDevices(manager);
+    if (!devices || !CFArrayGetCount(devices)) { if (devices) CFRelease(devices); CFRelease(manager); return nil; }
+    MWOperation *op = [MWOperation new]; op.manager = manager;
+    op.device = CFRetain(CFArrayGetValueAtIndex(devices, 0)); CFRelease(devices);
+    if (pendingOperations[[NSValue valueWithPointer:op.device]]) return nil;
+    op.token = ++_generation;
+    mwSchedule(op.manager, CFRunLoopGetMain(), kCFRunLoopCommonModes);
+    pendingOperations[[NSValue valueWithPointer:op.device]] = op; self.operation = op;
+    return op;
+}
+- (NSString *)currentSSID {
+    if ([self prepare]) return nil;
+    MWRef network = mwCurrent(_device); if (!network) return nil;
+    NSString *value = [(__bridge NSString *)mwSSID(network) copy]; CFRelease(network); return value;
+}
+- (NSString *)currentBSSID {
+    if ([self prepare]) return nil;
+    MWRef network = mwCurrent(_device); if (!network) return nil;
+    id value = (__bridge id)mwProperty(network, CFSTR("BSSID"));
+    NSString *result = [value isKindOfClass:NSString.class] ? [value lowercaseString] : nil;
+    CFRelease(network); return result;
+}
+- (NSString *)diagnostics {
+    // 只读取本进程的签名权限。读取到 true 不代表无线服务一定接受请求。
+    CFTypeRef (*createTask)(CFAllocatorRef) = dlsym(RTLD_DEFAULT, "SecTaskCreateFromSelf");
+    CFTypeRef (*copyEntitlement)(CFTypeRef, CFStringRef, CFErrorRef *) = dlsym(RTLD_DEFAULT, "SecTaskCopyValueForEntitlement");
+    NSString *permission = @"无法读取（诊断接口不可用）";
+    CFTypeRef task = createTask ? createTask(kCFAllocatorDefault) : NULL;
+    if (task && copyEntitlement) {
+        CFErrorRef error = NULL;
+        CFTypeRef value = copyEntitlement(task, CFSTR("com.apple.wifi.manager-access"), &error);
+        if (value) {
+            permission = CFEqual(value, kCFBooleanTrue) ? @"已包含" : @"未启用";
+            CFRelease(value);
+        } else if (!error) permission = @"未包含，请用巨魔安装专用包";
+        else permission = [NSString stringWithFormat:@"读取失败（%ld）", (long)CFErrorGetCode(error)];
+        if (error) CFRelease(error);
+    }
+    if (task) CFRelease(task);
+    return [NSString stringWithFormat:@"当前进程的无线管理权限：%@\n无线设备：%@\n%@\n权限声明与实际扫描结果分别判断；不会通过授权弹窗申请这项私有权限。",
+            permission, _device ? @"已取得" : @"尚未取得", self.lastScanDetail ?: @"尚未收到扫描结果"];
+}
+- (void)scanWithCompletion:(void (^)(NSString *, NSError *))completion {
+    self.lastScanDetail = @"正在准备无线扫描";
+    NSError *error = [self prepare];
+    if (error) { self.lastScanDetail = error.localizedDescription; completion(nil, error); return; }
+    if (_scanning || _joining) { completion(nil, [self failure:@"上一条无线操作正在结束，请稍后重试。" code:5]); return; }
+    if (mwPower && !mwPower(_device)) { completion(nil, [self failure:@"请先在控制中心或设置中开启 Wi-Fi。" code:6]); return; }
+    MWOperation *op = [self newOperation];
+    if (!op) { completion(nil, [self failure:@"无法建立新的无线请求。请退出应用后重试。" code:12]); return; }
+    _scanning = YES; self.scanCompletion = completion; uintptr_t token = op.token;
+    self.lastScanDetail = @"扫描请求已提交，等待系统回调";
+    int result = mwScan(op.device, (__bridge CFDictionaryRef)@{}, scanDone, NULL);
+    if (result != 0) { [self finishScan:NULL code:result token:token]; [pendingOperations removeObjectForKey:[NSValue valueWithPointer:op.device]]; return; }
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 18 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+        if (self->_scanning && self->_generation == token) {
+            self.lastScanDetail = @"系统未在 18 秒内返回扫描回调";
+            self.scanCompletion = nil; [self cancel]; completion(nil, [self failure:@"扫描超时。无线权限可能未生效，可重试或手动加入相机网络。" code:7]);
+        }
+    });
+}
+- (void)finishScan:(CFArrayRef)results code:(int)code token:(uintptr_t)token {
+    if (!_scanning || token != _generation) return;
+    _scanning = NO; self.operation = nil; void (^completion)(NSString *, NSError *) = self.scanCompletion; self.scanCompletion = nil;
+    if (code) {
+        self.lastScanDetail = [NSString stringWithFormat:@"无线接口返回错误码：%d", code];
+        completion(nil, [self failure:[NSString stringWithFormat:@"扫描失败（%d）。可展开无线诊断查看权限；此错误码本身不能证明是权限问题。", code] code:code]); return;
+    }
+    NSMutableArray *values = [NSMutableArray new]; [self.networks removeAllObjects];
+    if (results && CFGetTypeID(results) == CFArrayGetTypeID()) for (CFIndex i = 0; i < CFArrayGetCount(results); i++) {
+        MWRef network = CFArrayGetValueAtIndex(results, i); if (!network) continue;
+        NSString *ssid = (__bridge NSString *)mwSSID(network);
+        if (![ssid isKindOfClass:NSString.class] || !ssid.length) continue;
+        id rawBSSID = (__bridge id)mwProperty(network, CFSTR("BSSID"));
+        NSString *bssid = [rawBSSID isKindOfClass:NSString.class] ? [rawBSSID lowercaseString] : @"";
+        NSString *identifier = bssid.length ? bssid : [@"ssid:" stringByAppendingString:ssid];
+        if (self.networks[identifier]) continue;
+        self.networks[identifier] = (__bridge id)network;
+        BOOL enterprise = mwIsEAP(network), wep = mwIsWEP(network), requiresPassword = mwRequiresPassword(network);
+        // MobileWiFi 的 Boolean 是数值类型，C 的 || 表达式也是 int。
+        // 直接 @() 会生成 JSON 的 0/1，Swift Bool 只接受 true/false。
+        NSMutableDictionary *row = [@{@"id":identifier, @"ssid":ssid, @"bssid":bssid,
+            @"requiresPassword":(__bridge id)(requiresPassword ? kCFBooleanTrue : kCFBooleanFalse),
+            @"unsupportedSecurity":(__bridge id)((enterprise || wep) ? kCFBooleanTrue : kCFBooleanFalse),
+            @"security":enterprise ? @"企业网络" : (wep ? @"WEP" : (requiresPassword ? @"加密网络" : @"开放网络"))} mutableCopy];
+        id channel = (__bridge id)mwProperty(network, CFSTR("CHANNEL"));
+        if ([channel isKindOfClass:NSNumber.class] && [channel intValue] > 0) row[@"channel"] = @([channel intValue]);
+        id rssi = (__bridge id)mwProperty(network, CFSTR("RSSI"));
+        if ([rssi isKindOfClass:NSDictionary.class]) rssi = rssi[@"RSSI_CTL_AGR"] ?: rssi[@"RSSI"];
+        if ([rssi isKindOfClass:NSNumber.class] && [rssi intValue] < 0 && [rssi intValue] >= -127) row[@"signal"] = @([rssi intValue]);
+        [values addObject:row];
+    }
+    NSError *jsonError; NSData *data = [NSJSONSerialization dataWithJSONObject:values options:0 error:&jsonError];
+    self.lastScanDetail = [NSString stringWithFormat:@"系统扫描回调成功，原始记录 %ld 条，可显示热点 %lu 个%@",
+        (long)((results && CFGetTypeID(results) == CFArrayGetTypeID()) ? CFArrayGetCount(results) : 0),
+        (unsigned long)values.count, data ? @"；已生成热点数据" : @"；生成热点数据失败"];
+    completion(data ? [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] : nil,
+        data ? nil : [self failure:@"系统已返回扫描结果，但应用生成热点数据失败。请保留无线诊断信息。" code:13]);
+}
+- (void)joinIdentifier:(NSString *)identifier password:(NSString *)password completion:(void (^)(NSError *))completion {
+    NSError *error = [self prepare]; if (error) { completion(error); return; }
+    if (_scanning || _joining) { completion([self failure:@"无线操作尚未结束，请稍后重试。" code:5]); return; }
+    id value = self.networks[identifier]; if (!value) { completion([self failure:@"热点扫描记录已失效，请重新搜索。" code:8]); return; }
+    MWRef network = (__bridge MWRef)value;
+    if (mwIsEAP(network) || mwIsWEP(network)) { completion([self failure:@"此网络的认证方式暂不支持直接加入，请使用系统设置。" code:9]); return; }
+    if (mwRequiresPassword(network) && !password.length) { completion([self failure:@"首次连接该加密热点需要相机 Wi-Fi 密码。" code:10]); return; }
+    if (password.length) mwPassword(network, (__bridge CFStringRef)password);
+    MWOperation *op = [self newOperation];
+    if (!op) { completion([self failure:@"无法建立新的无线请求。请退出应用后重试。" code:12]); return; }
+    op.network = CFRetain(network);
+    _joining = YES; self.joinCompletion = completion; uintptr_t token = op.token;
+    // 直接关联不会调用 NEHotspotConfiguration，因此不主动弹出它的“加入”确认。
+    // 不先断开当前网络：目标无效时避免额外中断用户连接。
+    int result = mwJoin(op.device, network, joinDone, NULL);
+    if (result != 0) { [self finishJoin:result token:token]; [pendingOperations removeObjectForKey:[NSValue valueWithPointer:op.device]]; return; }
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 25 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+        if (self->_joining && self->_generation == token) {
+            self.joinCompletion = nil; [self cancel]; completion([self failure:@"直接加入超时，已请求停止关联。请核对热点和密码，或关闭免确认连接后重试。" code:11]);
+        }
+    });
+}
+- (void)finishJoin:(int)code token:(uintptr_t)token {
+    if (!_joining || token != _generation) return;
+    _joining = NO; self.operation = nil; void (^completion)(NSError *) = self.joinCompletion; self.joinCompletion = nil;
+    completion(code ? [self failure:[NSString stringWithFormat:@"直接加入失败（%d）。请核对密码、相机热点或使用系统加入方式。", code] code:code] : nil);
+}
+- (void)cancel {
+    ++_generation; BOOL joining = _joining;
+    _joining = NO; _scanning = NO;
+    void (^scanBlock)(NSString *, NSError *) = self.scanCompletion;
+    void (^joinBlock)(NSError *) = self.joinCompletion;
+    self.scanCompletion = nil; self.joinCompletion = nil;
+    if (joining && mwCancelJoin && self.operation) mwCancelJoin(self.operation.device);
+    // 扫描无已确认可用的取消接口；仅忽略结果，保留其上下文直到系统回调。
+    self.operation = nil;
+    NSError *error = [self failure:@"已停止无线操作。" code:NSUserCancelledError];
+    if (scanBlock) scanBlock(nil, error); if (joinBlock) joinBlock(error);
+}
+@end
+
+static void scanDone(MWRef device, CFArrayRef results, int error, const void *token) {
+    if (results) CFRetain(results);
+    dispatch_async(dispatch_get_main_queue(), ^{
+        NSValue *key = [NSValue valueWithPointer:device]; MWOperation *op = pendingOperations[key];
+        if (op) [[TrollWiFiBridge shared] finishScan:results code:error token:op.token];
+        [pendingOperations removeObjectForKey:key];
+        if (results) CFRelease(results);
+    });
+}
+static void joinDone(MWRef device, MWRef network, CFDictionaryRef info, int error, const void *token) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        NSValue *key = [NSValue valueWithPointer:device]; MWOperation *op = pendingOperations[key];
+        if (op) [[TrollWiFiBridge shared] finishJoin:error token:op.token];
+        [pendingOperations removeObjectForKey:key];
+    });
+}
diff --git a/Services/TrollStoreBackgroundExecution.swift b/Services/TrollStoreBackgroundExecution.swift
new file mode 100644
index 0000000..2e11aa3
--- /dev/null
+++ b/Services/TrollStoreBackgroundExecution.swift
@@ -0,0 +1,47 @@
+#if TROLLSTORE
+import Foundation
+
+@MainActor
+final class TrollStoreBackgroundExecution: ObservableObject {
+    static let shared = TrollStoreBackgroundExecution()
+    @Published var enabled = UserDefaults.standard.object(forKey: "trollBackground.enabled.v1") as? Bool ?? true {
+        didSet {
+            UserDefaults.standard.set(enabled, forKey: "trollBackground.enabled.v1")
+            restart()
+        }
+    }
+    @Published private(set) var isGranted = false
+    @Published private(set) var status = "等待下载或边拍边传任务，空闲时不保活。"
+    private let bridge = TrollBackgroundBridge()
+    private var reasons: Set<String> = []
+    private var requested = false
+    private var generation = UUID()
+
+    func setActive(_ active: Bool, reason: String) {
+        if active { reasons.insert(reason) } else { reasons.remove(reason) }
+        reconcile()
+    }
+    func retry() { restart() }
+    private func restart() {
+        generation = UUID(); bridge.end(); requested = false
+        isGranted = false
+        reconcile()
+    }
+    private func reconcile() {
+        guard enabled, !reasons.isEmpty else {
+            generation = UUID(); bridge.end(); requested = false; isGranted = false
+            status = enabled ? "等待下载或边拍边传任务，空闲时不保活。" : "已关闭实验保活，使用普通后台宽限时间。"
+            return
+        }
+        guard !requested else { return }
+        requested = true; let id = generation
+        status = "正在向系统申请后台运行（实验）…"
+        bridge.begin { [weak self] granted, message in
+            Task { @MainActor in
+                guard let self, self.generation == id else { return }
+                self.status = message; self.isGranted = granted
+            }
+        }
+    }
+}
+#endif
diff --git a/Services/TrollStoreWiFi.swift b/Services/TrollStoreWiFi.swift
new file mode 100644
index 0000000..8702a57
--- /dev/null
+++ b/Services/TrollStoreWiFi.swift
@@ -0,0 +1,256 @@
+#if TROLLSTORE
+import Foundation
+import CryptoKit
+import Darwin
+import Security
+
+struct TrollWiFiNetwork: Codable, Identifiable, Equatable, Sendable {
+    let id: String
+    let ssid: String
+    let bssid: String
+    let requiresPassword: Bool
+    let unsupportedSecurity: Bool
+    let security: String
+    let signal: Int?
+    let channel: Int?
+    private enum CodingKeys: String, CodingKey {
+        case id, ssid, bssid, requiresPassword, unsupportedSecurity, security, signal, channel
+    }
+    init(from decoder: Decoder) throws {
+        let values = try decoder.container(keyedBy: CodingKeys.self)
+        id = try values.decode(String.self, forKey: .id)
+        ssid = try values.decode(String.self, forKey: .ssid)
+        bssid = try values.decode(String.self, forKey: .bssid)
+        requiresPassword = try Self.decodeFlag(.requiresPassword, from: values)
+        unsupportedSecurity = try Self.decodeFlag(.unsupportedSecurity, from: values)
+        security = try values.decode(String.self, forKey: .security)
+        signal = try values.decodeIfPresent(Int.self, forKey: .signal)
+        channel = try values.decodeIfPresent(Int.self, forKey: .channel)
+    }
+    private static func decodeFlag(_ key: CodingKeys, from values: KeyedDecodingContainer<CodingKeys>) throws -> Bool {
+        if let flag = try? values.decode(Bool.self, forKey: key) { return flag }
+        // 兼容旧桥接器的 0/1；其他值仍报错，避免把未知认证方式当作开放网络。
+        if let flag = try? values.decode(Int.self, forKey: key), flag == 0 || flag == 1 { return flag == 1 }
+        throw DecodingError.dataCorruptedError(forKey: key, in: values, debugDescription: "热点标志必须是布尔值或 0/1")
+    }
+    var brand: NearbyCameraBrand? {
+        Self.brand(forSSID: ssid)
+    }
+    static func brand(forSSID ssid: String) -> NearbyCameraBrand? {
+        let name = ssid.uppercased()
+        if name.contains("NIKON") || name.hasPrefix("Z6_") || name.hasPrefix("Z6III") { return .nikon }
+        if name.contains("FUJI") || name.hasPrefix("X-T") || name.hasPrefix("X-S") || name.hasPrefix("GFX") || name.hasPrefix("X100") { return .fuji }
+        if name.contains("SONY") || name.contains("ILCE-") || name.contains("ILME-") || name.contains("DSC-") || name.contains("ZV-") { return .sony }
+        if name.contains("CANON") || name.contains("EOS") || name.contains("POWERSHOT") { return .canon }
+        if name.contains("LUMIX") || name.contains("PANASONIC") || name.hasPrefix("DC-") || name.hasPrefix("DMC-") { return .panasonic }
+        if name.contains("RICOH") || name.hasPrefix("GR_") || name.hasPrefix("GRIII") || name.hasPrefix("GRIV") { return .ricoh }
+        if name.contains("PENTAX") { return .pentax }
+        if name.contains("OLYMPUS") || name.contains("OM SYSTEM") || name.hasPrefix("OM-1") || name.hasPrefix("OM-3") || name.hasPrefix("OM-5") { return .olympus }
+        if name.contains("LEICA") { return .leica }
+        if name.contains("HASSELBLAD") || name.hasPrefix("X2D") { return .hasselblad }
+        return nil
+    }
+}
+
+@MainActor
+final class TrollStoreWiFi: ObservableObject {
+    static let shared = TrollStoreWiFi()
+    @Published private(set) var networks: [TrollWiFiNetwork] = []
+    @Published private(set) var isScanning = false
+    @Published private(set) var isJoining = false
+    @Published private(set) var hasScanFailure = false
+    @Published private(set) var scanDiagnostics = "尚未扫描。"
+    @Published private(set) var status = "巨魔版可扫描尚未加入的热点；点击具体网络才会连接。"
+    @Published var directJoinEnabled: Bool = UserDefaults.standard.object(forKey:"trollWiFi.direct.v1") as? Bool ?? true {
+        didSet { UserDefaults.standard.set(directJoinEnabled,forKey:"trollWiFi.direct.v1") }
+    }
+    private let bridge = TrollWiFiBridge.shared()
+    private var discoveryTask: Task<Void,Never>?
+    private var discoveryID = UUID()
+    private var operationID: UUID?
+    private var bridgeOperationID: UUID?
+    private var lastScan: Date = .distantPast
+    private struct Credential: Codable { let password: String; let open: Bool }
+
+    func startDiscovery() {
+        guard !isJoining, !isScanning else { return }
+        stopDiscovery(); let id = UUID(); discoveryID = id
+        status = "正在扫描附近 Wi-Fi 热点，等待系统返回结果…"
+        hasScanFailure = false
+        discoveryTask = Task {
+            do {
+                _ = try await scan()
+                guard discoveryID == id, !Task.isCancelled else { return }
+                status = "热点扫描完成，共 \(networks.count) 个。名称仅用于筛选候选，连接后才校验相机身份。"
+            } catch {
+                guard discoveryID == id, !Task.isCancelled else { return }
+                hasScanFailure = true
+                status = error.localizedDescription
+            }
+            if discoveryID == id { discoveryTask = nil }
+        }
+    }
+    func stopDiscovery() {
+        discoveryID = UUID(); discoveryTask?.cancel(); discoveryTask = nil
+        if isScanning { bridge.cancel() }
+    }
+    func cancelConnection() {
+        if isJoining || isScanning { bridge.cancel() }
+    }
+    private func scan() async throws -> [TrollWiFiNetwork] {
+        try Task.checkCancellation()
+        guard !isScanning else { throw failure("无线扫描尚未结束，请稍后重试。") }
+        isScanning = true; networks = []
+        defer { isScanning = false; scanDiagnostics = bridge.diagnostics() }
+        let id = UUID(); bridgeOperationID = id
+        defer { if bridgeOperationID == id { bridgeOperationID = nil } }
+        let json: String = try await withTaskCancellationHandler {
+            try await withCheckedThrowingContinuation { continuation in
+                bridge.scan { text, error in
+                    if let error { continuation.resume(throwing:error) }
+                    else if let text { continuation.resume(returning:text) }
+                    else { continuation.resume(throwing:CameraAppError.unsupportedOperation("无线扫描未返回结果。")) }
+                }
+            }
+        } onCancel: { Task { @MainActor in TrollStoreWiFi.shared.cancelBridge(id) } }
+        try Task.checkCancellation()
+        let decoded: [TrollWiFiNetwork]
+        do {
+            decoded = try JSONDecoder().decode([TrollWiFiNetwork].self,from:Data(json.utf8))
+        } catch let error as DecodingError {
+            let path: [CodingKey]
+            switch error {
+            case .typeMismatch(_, let context), .valueNotFound(_, let context), .dataCorrupted(let context):
+                path = context.codingPath
+            case .keyNotFound(let key, let context): path = context.codingPath + [key]
+            @unknown default: path = []
+            }
+            let fields = ["requiresPassword":"加密标志", "unsupportedSecurity":"认证支持标志", "signal":"信号强度", "channel":"信道", "ssid":"热点名称", "bssid":"热点地址", "id":"热点标识", "security":"认证方式"]
+            let field = path.last.flatMap { fields[$0.stringValue] } ?? "热点列表"
+            throw failure("系统已返回热点数据，但应用解析失败（\(field)）。这不等于权限被拒绝；请展开无线诊断并反馈。")
+        } catch {
+            throw failure("系统已返回热点数据，但应用无法解析。请展开无线诊断并反馈。")
+        }
+        networks = decoded.sorted {
+            if ($0.brand != nil) != ($1.brand != nil) { return $0.brand != nil }
+            if ($0.signal ?? -128) != ($1.signal ?? -128) { return ($0.signal ?? -128) > ($1.signal ?? -128) }
+            return $0.id < $1.id
+        }
+        lastScan = Date(); return networks
+    }
+    func credentials(for network: TrollWiFiNetwork) -> (password:String,open:Bool)? {
+        var query = credentialQuery(network.ssid,network.bssid)
+        query[kSecReturnData as String] = true; query[kSecMatchLimit as String] = kSecMatchLimitOne
+        var result: CFTypeRef?
+        if SecItemCopyMatching(query as CFDictionary,&result) == errSecSuccess, let data = result as? Data,
+           let value = try? JSONDecoder().decode(Credential.self,from:data), value.open == !network.requiresPassword {
+            return (value.password,value.open)
+        }
+        return CameraWiFiCoordinator.shared.savedCredentials(ssid:network.ssid)
+    }
+    func forgetCredentials(for network:TrollWiFiNetwork) {
+        SecItemDelete(credentialQuery(network.ssid,network.bssid) as CFDictionary)
+        status = "已删除本应用为该热点单独保存的密码；按机型保存的网络可在高级排障中删除。"
+    }
+    func join(ssid:String,password:String,open:Bool,bssid:String? = nil,progressID:UUID? = nil) async throws {
+        try Task.checkCancellation()
+        guard !isJoining else { throw failure("上一条无线连接仍在结束，请稍后重试。") }
+        guard !ssid.isEmpty,ssid.utf8.count <= 32, open || (8...63).contains(password.utf8.count) || (password.count == 64 && password.allSatisfy(\.isHexDigit)) else {
+            throw failure("请输入有效的 Wi-Fi 名称和 WPA 密码。")
+        }
+        isJoining = true; let id = UUID(); operationID = id
+        defer { if operationID == id { operationID = nil; isJoining = false } }
+        // 停止搜索与连接相机是分开的操作。连接阶段才会改动当前无线关联。
+        stopDiscovery()
+        if isScanning {
+            for _ in 0..<20 { try Task.checkCancellation(); if !isScanning { break }; try await Task.sleep(nanoseconds:50_000_000) }
+        }
+        let expectedBSSID = bssid?.lowercased()
+        if bridge.currentSSID() == ssid, expectedBSSID == nil || expectedBSSID == bridge.currentBSSID() {
+            CameraConnectionProgress.shared.advance(.address, id: progressID, detail: "已在所选热点，正在确认本机地址…")
+            try await awaitNetwork(ssid:ssid,bssid:expectedBSSID)
+            status = "已在所选 Wi-Fi 网络，准备识别相机。"; return
+        }
+        status = "正在查找 \(ssid)…"
+        CameraConnectionProgress.shared.advance(.hotspot, id: progressID, detail: "正在搜索蓝牙启动或已保存的相机热点…")
+        var matches = networks.filter { $0.ssid == ssid && (expectedBSSID == nil || $0.bssid == expectedBSSID) }
+        // 蓝牙刚启动的热点可能需要数秒；有限次重扫，不后台无限切网。
+        if matches.isEmpty || Date().timeIntervalSince(lastScan) > 12 {
+            for attempt in 0..<3 {
+                let values = try await scan()
+                matches = values.filter { $0.ssid == ssid && (expectedBSSID == nil || $0.bssid == expectedBSSID) }
+                if !matches.isEmpty { break }
+                if attempt < 2 { try await Task.sleep(nanoseconds:1_500_000_000) }
+            }
+        }
+        try Task.checkCancellation()
+        guard matches.count == 1, let network = matches.first else {
+            throw failure(matches.isEmpty ? "未发现这台相机的热点，请确认机身已开启 Wi-Fi 后重试。" : "发现多个同名热点，请在附近列表选择具体 BSSID（热点地址），避免连接到另一台设备。")
+        }
+        guard !network.unsupportedSecurity else { throw failure("该热点认证方式暂不支持直接加入，请使用系统 Wi-Fi 设置。") }
+        guard open == !network.requiresPassword else { throw failure("保存的加密方式与热点不同，请核对密码和开放网络开关。") }
+        status = "正在直接加入 \(ssid)，使用巨魔免确认连接…"
+        CameraConnectionProgress.shared.advance(.joining, id: progressID, detail: "正在通过巨魔直接加入选定热点…")
+        let bridgeID = UUID(); bridgeOperationID = bridgeID
+        defer { if bridgeOperationID == bridgeID { bridgeOperationID = nil } }
+        try await withTaskCancellationHandler {
+            try await withCheckedThrowingContinuation { (continuation:CheckedContinuation<Void,Error>) in
+                bridge.joinIdentifier(network.id,password:password) { error in
+                    if let error { continuation.resume(throwing:error) } else { continuation.resume() }
+                }
+            }
+        } onCancel: { Task { @MainActor in TrollStoreWiFi.shared.cancelBridge(bridgeID) } }
+        try Task.checkCancellation()
+        status = "无线关联已完成，正在确认热点地址与本机 IP…"
+        CameraConnectionProgress.shared.advance(.address, id: progressID, detail: "正在核对热点身份，并等待有效的 Wi-Fi 地址…")
+        try await awaitNetwork(ssid:ssid,bssid:network.bssid.isEmpty ? nil : network.bssid)
+        try Task.checkCancellation()
+        do { try saveCredential(Credential(password:password,open:open),ssid:ssid,bssid:network.bssid) }
+        catch { status = "已加入网络，但密码保存失败，下次可能需重新输入。"; return }
+        status = "已直接加入 \(ssid)，尚需相机协议握手确认。"
+    }
+    private func awaitNetwork(ssid:String,bssid:String?) async throws {
+        var stableSamples = 0
+        for _ in 0..<40 {
+            try Task.checkCancellation()
+            if bridge.currentSSID() == ssid, bssid == nil || bridge.currentBSSID() == bssid, Self.hasWiFiAddress() {
+                stableSamples += 1
+                if stableSamples >= 5 {
+                    NearbyCameraDiscovery.shared.noteNetworkConnection("已加入所选热点并取得 Wi-Fi 地址，尚需相机协议握手确认。")
+                    return
+                }
+            } else { stableSamples = 0 }
+            try await Task.sleep(nanoseconds:250_000_000)
+        }
+        throw failure("无线请求已结束，但目标热点或本机 IP 未确认。不会把这次请求当作相机连接成功，请重试。")
+    }
+    private static func hasWiFiAddress() -> Bool {
+        var pointer:UnsafeMutablePointer<ifaddrs>?
+        guard getifaddrs(&pointer) == 0 else { return false }; defer { freeifaddrs(pointer) }
+        var current = pointer
+        while let item = current {
+            defer { current = item.pointee.ifa_next }
+            guard String(cString:item.pointee.ifa_name) == "en0", let addr = item.pointee.ifa_addr,addr.pointee.sa_family == UInt8(AF_INET) else { continue }
+            let ip = addr.withMemoryRebound(to:sockaddr_in.self,capacity:1) { UInt32(bigEndian:$0.pointee.sin_addr.s_addr) }
+            if ip != 0, ip >> 16 != 0xa9fe { return true }
+        }
+        return false
+    }
+    private func credentialQuery(_ ssid:String,_ bssid:String) -> [String:Any] {
+        let account = SHA256.hash(data:Data((ssid+"\0"+bssid).utf8)).map { String(format:"%02x",$0) }.joined()
+        return [kSecClass as String:kSecClassGenericPassword,kSecAttrService as String:"CameraConnect.TrollWiFi.v1",kSecAttrAccount as String:account]
+    }
+    private func saveCredential(_ value:Credential,ssid:String,bssid:String) throws {
+        let query = credentialQuery(ssid,bssid), data = try JSONEncoder().encode(value)
+        var code = SecItemUpdate(query as CFDictionary,[kSecValueData as String:data] as CFDictionary)
+        if code == errSecItemNotFound {
+            var entry = query; entry[kSecValueData as String] = data
+            entry[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+            code = SecItemAdd(entry as CFDictionary,nil)
+        }
+        guard code == errSecSuccess else { throw failure("保存热点密码失败。") }
+    }
+    private func failure(_ text:String) -> CameraAppError { .unsupportedOperation(text) }
+    private func cancelBridge(_ id:UUID) { if bridgeOperationID == id { bridge.cancel() } }
+}
+#endif
