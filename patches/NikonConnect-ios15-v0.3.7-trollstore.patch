+        let oldWrites = writes; writes = [:]; for pending in oldWrites.values { pending.1.resume(throwing:CancellationError()) }
+    }
+    func centralManagerDidUpdateState(_ central:CBCentralManager) {
+        if central.state == .unauthorized || central.state == .unsupported || central.state == .poweredOff { failureText = "蓝牙未开启、未授权或不可用。" }
+    }
+    func centralManager(_ central:CBCentralManager,didConnect peripheral:CBPeripheral) { if peripheral === peer { peripheral.discoverServices(nil) } }
+    func centralManager(_ central:CBCentralManager,didFailToConnect peripheral:CBPeripheral,error:Error?) { if peripheral === peer { failureText = "无法连接已选择的相机蓝牙。" } }
+    func centralManager(_ central:CBCentralManager,didDisconnectPeripheral peripheral:CBPeripheral,error:Error?) {
+        guard peripheral === peer else { return }; if !expectedDisconnect { failureText = "相机蓝牙已断开，请在机身确认配对。" }
+        let old = reads; reads = [:]; for pending in old.values { pending.1.resume(throwing:self.error("相机在读取网络信息时断开。")) }
+        let oldWrites = writes; writes = [:]; for pending in oldWrites.values { pending.1.resume(throwing:self.error("相机未确认蓝牙写入。")) }
+    }
+    func peripheral(_ peripheral:CBPeripheral,didDiscoverServices error:Error?) {
