+struct AppearanceFixtureFactory: CameraTransportFactoryProtocol {
+    func makeTransport() -> any CameraTransport { AppearanceFixtureTransport() }
+}
+
+actor AppearanceFixtureTransport: CameraRemoteControlling, CameraConnectionChecking {
+    func connect(using config: CameraConnectionConfig) async throws -> CameraSession {
+        try await Task.sleep(nanoseconds: 6_000_000_000)
+        return CameraSession(cameraName: "外观验证相机", connectedHost: config.host, port: config.port,
+            capabilities: Set(CameraCapability.allCases), persistentIdentity: AppearanceFixtures.identity)
+    }
+    func fetchAssetsPage(for session: CameraSession, resetTraversal: Bool, limit: Int) async throws -> PhotoAssetPage {
+        PhotoAssetPage(assets: resetTraversal ? AppearanceFixtures.assets : [], hasMore: false)
+    }
+    func downloadThumbnail(_ asset: PhotoAsset, from session: CameraSession) async throws -> Data? {
+        await AppearanceFixtures.jpeg(light: asset.remoteIdentifier == "1" || asset.remoteIdentifier == "4")
+    }
+    func downloadAsset(_ asset: PhotoAsset, from session: CameraSession) async throws -> Data {
+        await AppearanceFixtures.jpeg(light: asset.remoteIdentifier == "1")
+    }
+    func consumeDiagnostics() async -> [String] { [] }
+    func disconnect() async {}
+    func checkConnection() async throws {}
+    func startLiveView() async throws {}
+    func stopLiveView() async {}
+    func liveViewFrame() async throws -> Data { await AppearanceFixtures.jpeg(light: false) }
+    func releaseShutter() async throws { throw CameraAppError.unsupportedOperation("外观验证：模拟相机无法实际拍照。") }
+    private var parameterValues = AppearanceFixtures.parameters
+    func cameraParameters() async throws -> [CameraParameter] { parameterValues }
+    func setCameraParameter(_ parameter: UInt16, to choice: CameraParameterChoice) async throws {
+        guard let index = parameterValues.firstIndex(where: { $0.id == parameter }) else { return }
+        let old = parameterValues[index]
+        parameterValues[index] = CameraParameter(id: old.id, title: old.title, current: choice, choices: old.choices, writable: old.writable)
+    }
+    func newlyCapturedAssets(in session: CameraSession) async throws -> [PhotoAsset] { [] }
+}
+#endif
