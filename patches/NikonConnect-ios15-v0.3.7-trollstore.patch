+    var body: some View {
+        ScrollView {
+            VStack(alignment: .leading, spacing: 18) {
+                CustomCard {
+                    VStack(alignment: .leading, spacing: 12) {
+                        Toggle("相机通信限定 Wi-Fi", isOn: $wifiOnly)
+                            .toggleStyle(SwitchToggleStyle(tint: AppTheme.accentStrong))
+                        Text("默认启用：PTP 相机连接限定 Wi-Fi，HTTP 相机连接禁止蜂窝数据。修改后请重新连接相机。此选项只控制本应用相机通信，不能指定其他应用的上网出口。")
+                            .font(.footnote).foregroundColor(AppTheme.inkMuted)
+                    }
+                }
+                Text("相机 Wi-Fi + 蜂窝上网").font(.title2.bold())
+                Text("相机热点通常只能连接相机。若它成为手机的默认上网出口，其他应用也可能无法联网。目标是让相机局域网走 Wi-Fi，互联网走蜂窝；不需要手机同时连接两个 Wi-Fi。")
+                Text("可以尝试的设置").font(.headline)
+                Text("1. 开启蜂窝数据，并允许需要上网的软件使用蜂窝数据。\n\n2. 连接相机热点，打开系统“设置 → Wi-Fi → 该热点右侧 ⓘ”，先截图记录当前 IP 地址、子网掩码和路由器。\n\n3. 将“配置 IP”改为“手动”，填写刚记录的本机 IP 地址与子网掩码；将“路由器”留空，再保存。不要把相机 IP 当作手机 IP。\n\n4. 回到本应用连接相机，再切到浏览器检查蜂窝上网是否恢复。")
+                Text("这是根据路由原理提供的尝试方法，尚未在你的机身和 iOS 15.4.1 上实测。部分相机依赖 DHCP 租约，可能不接受手动地址；无默认路由的 Wi-Fi 也可能在锁屏后被系统断开。若连接异常，将“配置 IP”恢复为“自动”。")
+                    .font(.footnote).foregroundColor(AppTheme.inkMuted)
+                Link("Apple 关于相机热点与默认路由的说明（英文）", destination: URL(string: "https://developer.apple.com/forums/thread/734344")!)
+                Text("应用内的 Wi-Fi 限定不等于全系统分流。巨魔也不会自动让所有其他软件改走 5G；系统级自动配置需要另外研究和真机验证。")
+                    .font(.footnote).foregroundColor(AppTheme.inkMuted)
+            }.padding(20).foregroundColor(AppTheme.ink)
+        }.background(AppTheme.canvas.ignoresSafeArea())
+            .navigationTitle("Wi-Fi 与蜂窝上网").navigationBarTitleDisplayMode(.inline)
+    }
+}
