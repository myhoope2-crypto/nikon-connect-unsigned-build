+    func refreshParameters() {
+        guard foreground, !isBusy, !controlInFlight, !isStoppingLive, supports(.parameters), let remote, let sessionID = connection.activeSession?.id else { return }
+        guard !downloads.isDownloading, !gallery.isLoading else {
+            parameterStatus = "请等待照片读取或下载结束后再刷新参数。"; return
+        }
+        let lease = acquireControlLease(); guard lease.allowed else { return }
+        isBusy = true; controlInFlight = true; autoParameterRefresh = true
+        Task {
+            defer { controlInFlight = false; isBusy = false; if let id = lease.id { connection.sessionCoordinator.releaseCameraUse(id) } }
+            do { try await waitForFrameBoundary(sessionID) } catch { return }
+            await readParameters(remote, sessionID: sessionID, reportErrors: true)
+        }
+    }
+    func setParameter(_ parameter: UInt16, choice: CameraParameterChoice) {
+        guard foreground, !isBusy, !controlInFlight, !isStoppingLive, let remote, let sessionID = connection.activeSession?.id,
+              let current = parameters.first(where: { $0.id == parameter }), current.canChange,
+              current.editableChoices.contains(where: { $0.data == choice.data }) else { return }
+        guard !downloads.isDownloading, !gallery.isLoading else {
+            parameterStatus = "请等待照片读取或下载结束后再调整参数。"; return
+        }
+        if current.current.data == choice.data { return }
+        let lease = acquireControlLease(); guard lease.allowed else { return }
+        isBusy = true; controlInFlight = true; parameterStatus = "正在设置\(current.title)，等待相机确认…"
+        Task {
+            defer { controlInFlight = false; isBusy = false; if let id = lease.id { connection.sessionCoordinator.releaseCameraUse(id) } }
+            do {
+                try await waitForFrameBoundary(sessionID)
+                try await remote.setCameraParameter(parameter, to: choice)
+                // 某些相机确认响应早于属性更新，最多回读三次；不自动重复写入。
