+import SwiftUI
+import UIKit
+
+// 实时画面固定在上方，参数滚动；只写相机当前公布且已确认含义的值。
+struct CameraLiveSettingsView: View {
+    @ObservedObject var model: CameraRemoteViewModel
+    @Environment(\.dismiss) private var dismiss
+    @State private var selectedSetting: CameraSettingDefinition?
+    @State private var expanded: Set<CameraSettingGroup> = [.focus, .fuji, .nikon]
+
+    var body: some View {
+        NavigationView {
+            GeometryReader { geometry in
+                VStack(spacing: 10) {
+                    preview.frame(height: max(120, min(300, geometry.size.height * 0.33)))
+                    captureControls
+                    ScrollView {
+                        VStack(alignment: .leading, spacing: 14) {
+                            Text(model.status).font(.footnote).foregroundColor(AppTheme.inkMuted)
+                            modelInformation
+                            LiveViewAssistanceControls(model:model)
+                            NavigationLink("参数预设与富士配方") { CameraPresetsView(model:model) }
+                            HStack {
+                                Text("常用曝光").font(.headline)
+                                Spacer()
+                                if model.isBusy { ProgressView().tint(AppTheme.accentStrong) }
+                                Button("刷新全部") { model.refreshParameters() }
+                                    .disabled(model.isBusy || model.isStoppingLive || !model.supports(.parameters))
+                            }
+                            LazyVGrid(columns: [GridItem(.adaptive(minimum: 105), spacing: 8)], spacing: 8) {
+                                ForEach(coreDefinitions) { definition in settingButton(definition, compact: true) }
+                            }
+                            focusControls
+                            Text("更多相机设置").font(.headline)
+                            ForEach(CameraSettingGroup.allCases.filter { $0 != .core }) { group in
+                                settingGroup(group)
+                            }
+                            Text(model.parameterStatus).font(.footnote).foregroundColor(AppTheme.inkMuted)
+                                .accessibilityIdentifier("live.parameterStatus")
+                            if let updated = model.parameterUpdatedAt {
+                                Text("上次回读：\(updated.formatted(date: .omitted, time: .standard))")
+                                    .font(.caption).foregroundColor(AppTheme.inkMuted)
+                            }
+                            Text("可修改：相机允许且已确认编码。只读：相机禁止写入。暂不可改：模式、拨盘或可选值受限。未开放：当前连接未返回此项。协议未支持：当前版本尚不能可靠修改。点按项目可查看原因和选项。")
+                                .font(.caption).foregroundColor(AppTheme.inkMuted)
+                            Text("设置影响之后拍摄的文件。选项与读写权限来自机身，写入后回读确认；模式、镜头和实体拨盘可能使设置无效。扩展项目为实验支持，尚未逐机验证。")
+                                .font(.caption).foregroundColor(AppTheme.inkMuted)
+                        }.padding(.bottom, 16)
+                    }
+                }.padding(.horizontal, 16).padding(.top, 8)
+            }
+            .foregroundColor(AppTheme.ink).background(AppTheme.canvas.ignoresSafeArea())
+            .navigationTitle("实时取景").navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .navigationBarLeading) {
+                    Button { model.stopLive(); dismiss() } label: { Label("退出取景", systemImage: "xmark") }
+                }
+                ToolbarItem(placement: .navigationBarTrailing) {
+                    Text(model.cameraModel).font(.caption).foregroundColor(AppTheme.inkMuted).lineLimit(1)
+                }
+            }
+            .alert(item: Binding(get: { selectedSetting == nil ? model.liveAlert : nil }, set: { model.liveAlert = $0 })) { alert in
+                Alert(title: Text(alert.title), message: Text(alert.message), dismissButton: .default(Text("确定")))
+            }
+            .sheet(item: $selectedSetting) { definition in CameraParameterEditor(model: model, definition: definition) }
+        }
+        .navigationViewStyle(.stack).tint(AppTheme.accentStrong)
+        .onAppear { model.livePageIsPresented = true; model.startLive() }
+
+    }
+    private var coreDefinitions: [CameraSettingDefinition] {
+        CameraSettingCatalog.definitions(profile: model.cameraProfile).filter { $0.group == .core }
+    }
+    private func expansion(for group: CameraSettingGroup) -> Binding<Bool> {
+        Binding(get: { expanded.contains(group) }, set: { value in
+            if value { expanded.insert(group) } else { expanded.remove(group) }
+        })
+    }
+    @ViewBuilder private func settingGroup(_ group: CameraSettingGroup) -> some View {
+        let definitions = model.settingDefinitions.filter { $0.group == group }
+        if !definitions.isEmpty {
+            DisclosureGroup(isExpanded: expansion(for: group)) {
+                VStack(spacing: 8) {
+                    ForEach(definitions) { definition in settingButton(definition, compact: false) }
+                }.padding(.top, 10)
+            } label: {
+                Text("\(group.title) · \(definitions.count) 项").font(.subheadline.weight(.semibold))
+            }
+            .padding(12).background(AppTheme.surface, in: RoundedRectangle(cornerRadius: 12))
+            .overlay(RoundedRectangle(cornerRadius: 12).stroke(AppTheme.border, lineWidth: 1))
+            .accessibilityIdentifier("live.group.\(group.rawValue)")
+        }
+    }
+    private var modelInformation: some View {
+        VStack(alignment: .leading, spacing: 5) {
+            Text("当前机型：\(model.cameraModel)").font(.subheadline.weight(.semibold))
+            let priority = CameraSettingCatalog.priorityModel(model.cameraModel, profile: model.cameraProfile)
+            Text(priority ? "优先适配机型 · 按当前无线连接能力开放设置" : "通用实验适配 · 显示此机实际报告的设置")
+                .font(.caption).foregroundColor(AppTheme.inkMuted)
+            Text("已读取 \(model.parameters.count) 项 · 当前可修改 \(model.parameters.filter(\.canChange).count) 项")
+                .font(.caption).foregroundColor(AppTheme.inkMuted)
+        }.frame(maxWidth: .infinity, alignment: .leading)
+    }
+    private var captureControls: some View {
+        HStack(spacing: 16) {
+            Button(model.isLive ? "停止取景" : "开始取景") {
+                if model.isLive { model.stopLive() } else { model.startLive() }
+            }
+            .disabled(model.isStoppingLive || (!model.isLive && (model.isBusy || !model.supports(.liveView))))
+            Spacer(minLength: 4)
+            Button { model.shutter() } label: { Label("遥控快门", systemImage: "camera.aperture") }
+                .disabled(model.isBusy || model.isStoppingLive || !model.supports(.capture))
+        }.font(.subheadline.weight(.semibold)).frame(minHeight: 44)
+    }
+    private var focusControls: some View {
+        VStack(alignment: .leading, spacing: 8) {
+            HStack {
+                Text("取景对焦").font(.headline)
+                Spacer()
+                Button("自动对焦（半按）") { model.focus() }
+                    .disabled(!model.isLive || model.isBusy || model.isStoppingLive || !model.focusCapabilities.autofocus)
+                    .accessibilityIdentifier("live.autofocus")
+            }.frame(minHeight: 44)
+            Text(model.focusCapabilities.touchFocus ? "点击画面移动焦点，黑边区域不响应。" : "点击画面对焦：当前未开放")
+                .font(.caption).foregroundColor(AppTheme.inkMuted)
+            Text(model.focusStatus).font(.caption).foregroundColor(AppTheme.inkMuted)
+        }
+    }
+    private func settingButton(_ definition: CameraSettingDefinition, compact: Bool) -> some View {
+        let parameter = model.parameters.first { definition.codes.contains($0.id) }
+        return Button { selectedSetting = definition } label: {
+            VStack(alignment: .leading, spacing: 6) {
+                HStack(alignment: .top) {
+                    Text(definition.title).font(compact ? .caption : .subheadline).foregroundColor(AppTheme.inkMuted)
+                    Spacer(minLength: 4)
+                    Image(systemName: "chevron.right").font(.caption2).foregroundColor(AppTheme.accentStrong)
+                }
+                Text(parameter?.current.title ?? (definition.limitation == nil ? (model.parametersLoaded ? "当前连接未开放" : "尚未读取") : "需在机身设置"))
+                    .font(.subheadline.weight(.semibold)).foregroundColor(AppTheme.ink)
+                    .lineLimit(compact ? 2 : 3).frame(maxWidth: .infinity, alignment: .leading)
+                HStack(spacing: 5) {
+                    Image(systemName: parameter?.canChange == true ? "slider.horizontal.3" : "info.circle")
+                    Text(parameter?.availabilityTitle ?? (definition.limitation == nil ? (model.parametersLoaded ? "未开放" : "尚未读取") : "协议未支持"))
+                }.font(.caption2).foregroundColor(parameter?.canChange == true ? AppTheme.success : AppTheme.inkMuted)
+            }
+            .padding(10).frame(maxWidth: .infinity, minHeight: compact ? 94 : 82, alignment: .leading)
+            .background(compact ? AppTheme.surface : AppTheme.surfaceMuted, in: RoundedRectangle(cornerRadius: 10))
+            .overlay(RoundedRectangle(cornerRadius: 10).stroke(AppTheme.border, lineWidth: 1))
+            .contentShape(Rectangle())
+        }.buttonStyle(.plain).accessibilityIdentifier("live.parameter.\(definition.kind.rawValue)")
+    }
+    private var preview: some View {
+        GeometryReader { geometry in
+            ZStack {
+                Color.black
+                if let data = model.liveFrame, let image = UIImage(data: data), image.size.width > 0, image.size.height > 0 {
+                    let scale = min(geometry.size.width / image.size.width, geometry.size.height / image.size.height)
+                    let size = CGSize(width: image.size.width * scale, height: image.size.height * scale)
+                    let rect = CGRect(x: (geometry.size.width - size.width) / 2,
+                        y: (geometry.size.height - size.height) / 2, width: size.width, height: size.height)
+                    Image(uiImage: image).resizable().scaledToFit().accessibilityLabel("相机实时画面")
+                    LiveViewAssistanceOverlay(rect:rect, zebraData:model.zebraFrame)
+                    if let point = model.focusMarker {
+                        Rectangle().stroke(.black, lineWidth: 5).overlay(Rectangle().stroke(AppTheme.accent, lineWidth: 2))
+                            .frame(width: 28, height: 28)
+                            .position(x: rect.minX + CGFloat(point.x) * rect.width, y: rect.minY + CGFloat(point.y) * rect.height)
+                    }
+                    Color.clear.contentShape(Rectangle()).gesture(DragGesture(minimumDistance: 0).onEnded { value in
+                        guard abs(value.translation.width) < 12, abs(value.translation.height) < 12,
+                              rect.contains(value.location), rect.width > 0, rect.height > 0 else { return }
+                        model.focus(at: CameraFocusPoint(x: Double((value.location.x - rect.minX) / rect.width),
+                            y: Double((value.location.y - rect.minY) / rect.height)))
+                    })
+                } else {
+                    VStack(spacing: 12) {
+                        Image(systemName: "camera.viewfinder").font(.system(size: 40))
+                        Text(model.isBusy ? "正在准备取景…" : "取景已停止").font(.footnote)
+                    }.foregroundColor(.white)
+                }
+            }
+        }.clipShape(RoundedRectangle(cornerRadius: 12))
+    }
+}
+
+private struct CameraParameterEditor: View {
+    @ObservedObject var model: CameraRemoteViewModel
+    let definition: CameraSettingDefinition
+    @Environment(\.dismiss) private var dismiss
+    private var parameter: CameraParameter? { model.parameters.first { definition.codes.contains($0.id) } }
+    var body: some View {
+        NavigationView {
+            ScrollView {
+                VStack(alignment: .leading, spacing: 16) {
+                    Text(model.cameraModel).font(.caption).foregroundColor(AppTheme.inkMuted)
+                    Text("当前值：\(parameter?.current.title ?? "未读取 / 未开放")").font(.headline)
+                    if let reason = parameter?.restriction ?? definition.limitation ?? missingReason {
+                        Label(reason, systemImage: "info.circle").font(.subheadline).foregroundColor(AppTheme.inkMuted)
+                    }
+                    if !definition.help.isEmpty { Text(definition.help).font(.subheadline).foregroundColor(AppTheme.inkMuted) }
+                    if let parameter {
+                        ForEach(parameter.choices) { choice in
+                            Button { model.setParameter(parameter.id, choice: choice) } label: {
+                                HStack(spacing: 12) {
+                                    Text(choice.title).foregroundColor(AppTheme.ink).multilineTextAlignment(.leading)
+                                    Spacer()
+                                    if choice.data == parameter.current.data {
+                                        Image(systemName: "checkmark.circle.fill").foregroundColor(AppTheme.accentStrong)
+                                    } else if !choice.recognized {
+                                        Text("编码待确认").font(.caption).foregroundColor(AppTheme.inkMuted)
+                                    }
+                                }.padding(12).frame(minHeight: 48)
+                                .background(AppTheme.surface, in: RoundedRectangle(cornerRadius: 10))
+                                .overlay(RoundedRectangle(cornerRadius: 10).stroke(AppTheme.border, lineWidth: 1))
+                            }.buttonStyle(.plain)
+                            .disabled(!parameter.canChange || !choice.recognized || model.isBusy || model.isStoppingLive)
+                        }
+                    }
+                    if model.isBusy { ProgressView("等待相机确认…").tint(AppTheme.accentStrong).foregroundColor(AppTheme.ink) }
+                    Text(model.parameterStatus).font(.footnote).foregroundColor(AppTheme.inkMuted)
+                    Button("重新读取全部设置") { model.refreshParameters() }
+                        .disabled(model.isBusy || model.isStoppingLive || !model.supports(.parameters))
+                }.padding(16).frame(maxWidth: .infinity, alignment: .leading)
+            }
+            .foregroundColor(AppTheme.ink).background(AppTheme.canvas.ignoresSafeArea())
+            .navigationTitle(definition.title).navigationBarTitleDisplayMode(.inline)
+            .toolbar { ToolbarItem(placement: .navigationBarTrailing) { Button("完成") { dismiss() } } }
+            .alert(item: $model.liveAlert) { alert in
+                Alert(title: Text(alert.title), message: Text(alert.message), dismissButton: .default(Text("确定")))
+            }
+        }.navigationViewStyle(.stack).tint(AppTheme.accentStrong)
+    }
+    private var missingReason: String? {
+        guard parameter == nil else { return nil }
+        if !model.parametersLoaded { return "尚未成功读取参数；请开始取景或重新读取设置。" }
+        return "相机未通过当前无线连接返回这个设置，可能受连接方式、拍摄模式、镜头或实体拨盘限制。此状态不代表机身没有该功能。"
+    }
+}
