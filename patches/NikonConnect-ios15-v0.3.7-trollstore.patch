+    private func readParameters(_ remote: any CameraRemoteControlling, sessionID: UUID, reportErrors: Bool, full: Bool = true) async {
+        guard supports(.parameters) else { parameterStatus = "当前连接协议未开放相机参数。"; return }
+        do {
+            let codes = Set(CameraSettingCatalog.definitions(profile: cameraProfile)
+                .filter { $0.group == .core }.flatMap(\.codes))
+            let result: [CameraParameter]
