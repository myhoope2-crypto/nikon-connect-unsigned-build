+    private func text(_ data:Data,allowEmpty:Bool = false) throws -> String {
+        let prefix = data.prefix { $0 != 0 }
+        guard let value = String(data:prefix,encoding:.utf8),allowEmpty || !value.isEmpty else { throw error("相机返回的网络信息无法读取。") }; return value
+    }
+    private func clientID(_ id:UUID) -> Data {
+        let key = "canonBluetoothClient."+id.uuidString
