+                let initial = CBUUID(string:"03E23A31-A54C-40FA-A668-DE9ACDC910BB")
+                let ssidChar = Self.pana("E206A5C0-3214-11E6-AFE4"), passChar = CBUUID(string:"C97CF1A5-3C03-4290-8C1B-9E74B9500F54")
+                let typeChar = Self.pana("0D6F1880-3217-11E6-A4CB"), startChar = Self.pana("E182EC40-3213-11E6-AB07")
