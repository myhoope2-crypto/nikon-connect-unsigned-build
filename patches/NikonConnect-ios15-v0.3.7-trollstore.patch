+        let uuid = UUID().uuid; let data = withUnsafeBytes(of:uuid) { Data($0) }; UserDefaults.standard.set(data,forKey:key); return data
+    }
+    // 松下按 4 字节分组混淆热点密码，算法参考 MIT 的 lumix-remote，保留原许可。
+    private func panasonicPassword(_ encoded:Data,_ keyData:Data) throws -> String {
+        guard !encoded.isEmpty,encoded.count % 4 == 0,keyData.count == 4 else { throw error("松下热点密码编码尚未支持。") }
+        let raw = [UInt8](encoded); var key = keyData.reduce(UInt32(0)) { ($0 << 8)|UInt32($1) }
+        if key == 0 { key = 0x9032782c }; var bytes:[UInt8] = []
+        for offset in stride(from:0,to:raw.count,by:4) {
+            var value = raw[offset..<offset+4].reduce(UInt32(0)) { ($0 << 8)|UInt32($1) } ^ key
+            let decoded = (0..<4).map { _ -> UInt8 in defer { value >>= 8 }; return UInt8(truncatingIfNeeded:value) }
+            bytes += offset == 0 ? Array(decoded.dropFirst()) : decoded
+        }
+        let end = bytes.firstIndex(of:0xff) ?? bytes.count
+        guard let password = String(data:Data(bytes[..<end]),encoding:.isoLatin1) else { throw error("松下热点密码无法解码。") }
+        return password.trimmingCharacters(in:CharacterSet(charactersIn:"\0"))
+    }
+    private func error(_ value:String) -> CameraAppError { .unsupportedOperation(value) }
+}
