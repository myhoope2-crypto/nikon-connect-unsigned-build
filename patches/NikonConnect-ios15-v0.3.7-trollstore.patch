+    @State private var showLivePage = false
+
+    var body: some View {
+        ScrollView {
+            VStack(alignment: .leading, spacing: 18) {
+                Text(connection.activeSession?.cameraName ?? "尚未连接相机").font(.title2.bold())
+                Text("拍摄控制为实验功能，以尼康 Z6 III、富士 X-T30 III 及相同协议机型为目标。功能是否可用取决于相机响应。")
+                    .font(.footnote).foregroundColor(AppTheme.inkMuted)
+                Text(model.status).font(.footnote)
+                if model.isRecovering { Button("停止自动重连") { model.stopRecovery() } }
+                Toggle("断线后自动重连（最多 3 次）", isOn: $autoReconnect)
+                NavigationLink("参数预设与富士配方") { CameraPresetsView(model:model) }
+                NavigationLink("间隔拍摄与定时快门") { CaptureScheduleView(model:model) }
+                NavigationLink("机型能力与连接报告") { CameraCapabilityReportView(model:model) }
+                if model.isScheduling {
+                    Text(model.scheduleStatus).font(.footnote)
+                    Button("停止拍摄计划", role:.destructive) { model.stopSchedule() }
+                }
+                CustomCard {
+                    VStack(alignment: .leading, spacing: 14) {
+                        Label("独立实时取景", systemImage: "camera.viewfinder").font(.headline)
+                        Text("独立画面内可对焦、调整曝光，并按机型展开拍摄、画质、白平衡及品牌专属设置；不可修改的项目会标明原因。")
+                            .font(.footnote).foregroundColor(AppTheme.inkMuted)
+                        Button { showLivePage = true } label: {
+                            Label("进入实时取景", systemImage: "arrow.up.left.and.arrow.down.right")
+                                .font(.headline).frame(maxWidth: .infinity, minHeight: 44)
+                        }
+                        .disabled(model.isBusy || model.isScheduling || !model.supports(.liveView))
+                        Button { model.shutter() } label: { Label("遥控快门", systemImage: "camera.aperture") }
+                            .disabled(model.isBusy || model.isScheduling || !model.supports(.capture))
+                    }
+                }
+                CustomCard {
+                    VStack(alignment: .leading, spacing: 12) {
+                        Text("边拍边传").font(.headline)
+                        Text("首次读取整卡建立文件身份基线，再监测新照片；重连后核对相机身份并补传。巨魔版获准后台运行后可在后台 / 锁屏继续监测与下载（实验），普通模式进入后台会暂停监测。取景时暂停监测；缺少稳定文件身份时禁用补传。")
+                            .font(.caption).foregroundColor(AppTheme.inkMuted)
+                        Button(model.isWatching ? "停止边拍边传" : "开始边拍边传") {
+                            if model.isWatching { model.stopWatching() } else { model.startWatching() }
+                        }.disabled(!model.isWatching && (!model.supports(.watchCapture) || model.isBusy || model.isLive || model.isScheduling))
+                        if !model.isWatching {
+                            Button("恢复上次监测并补传") { model.startWatching(resuming:true) }
+                                .disabled(!model.canPrepareWorkflow || model.isLive || !model.supports(.watchCapture))
+                        }
+                    }
+                }
+            }.padding(20)
+        }.foregroundColor(AppTheme.ink).background(AppTheme.canvas.ignoresSafeArea())
+            .navigationTitle("拍摄与连接维护").navigationBarTitleDisplayMode(.inline)
+            .fullScreenCover(isPresented: $showLivePage, onDismiss: {
+                model.stopLive(); model.livePageIsPresented = false; model.liveAlert = nil
+            }) {
+                CameraLiveView(model: model, cameraName: connection.activeSession?.cameraName ?? "相机")
+            }
+    }
+}
