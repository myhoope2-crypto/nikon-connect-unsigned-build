@@ -0,0 +1,14 @@
+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+// 所有入口由 Swift 主线程包装器调用；回调也回到主线程。
+@interface TrollWiFiBridge : NSObject
++ (instancetype)shared;
+- (void)scanWithCompletion:(void (^)(NSString * _Nullable json, NSError * _Nullable error))completion NS_SWIFT_DISABLE_ASYNC;
+- (void)joinIdentifier:(NSString *)identifier password:(NSString *)password completion:(void (^)(NSError * _Nullable error))completion NS_SWIFT_DISABLE_ASYNC;
