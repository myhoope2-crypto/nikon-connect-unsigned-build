+    func consumeDiagnostics() -> [String] { let result = diagnostics; diagnostics = []; return result }
+    private func recordDiagnostic(_ detail: String) {
+        diagnostics.append(String(format: "富士蓝牙 [+%.1f 秒] %@", Date().timeIntervalSince(diagnosticStartedAt), detail))
+        if diagnostics.count > 80 { diagnostics.removeFirst(diagnostics.count - 80) }
+    }
+
+    var connectionDiagnostic: String {
+        let active = Self.statusSubscriptions.filter { characteristics[$0.uuid]?.isNotifying == true }.count
+        return "蓝牙\(isReady ? "已就绪" : "未就绪")，状态通知已订阅 \(active)/\(Self.statusSubscriptions.count) 项。"
+    }
+
+    override init() { super.init() }
+    func rememberDiscovery(_ id: UUID, manufacturer: Data) {
+        if manufacturer.count >= 7, manufacturer[2] == 2 { advertisedTokens[id] = Data(manufacturer[3..<7]) }
+    }
+    func scan() {
+        scanRequested = true
+        if central == nil { central = CBCentralManager(delegate: self, queue: .main) }
+        else { beginScanIfPoweredOn() }
+    }
+    func centralManagerDidUpdateState(_ central: CBCentralManager) {
+        if central.state == .poweredOn { beginScanIfPoweredOn() }
+        else { status = central.state == .unauthorized ? "请在系统设置中允许蓝牙访问。" : "蓝牙未就绪，请检查系统蓝牙开关。" }
+    }
+    private func beginScanIfPoweredOn() {
+        guard scanRequested, central.state == .poweredOn else { return }
+        status = "搜索富士相机中，请在相机屏幕确认配对。"
+        central.scanForPeripherals(withServices: nil, options: [CBCentralManagerScanOptionAllowDuplicatesKey: false])
+        Task { [weak self] in
+            try? await Task.sleep(nanoseconds: 20_000_000_000)
+            guard let self, self.scanRequested else { return }
+            self.central.stopScan(); self.scanRequested = false
+            if self.cameras.isEmpty { self.status = "未发现相机，请确认相机处于蓝牙配对模式后重新搜索。" }
+        }
+    }
+    func centralManager(_ central: CBCentralManager, didDiscover peripheral: CBPeripheral,
+        advertisementData: [String: Any], rssi RSSI: NSNumber) {
+        let name = (advertisementData[CBAdvertisementDataLocalNameKey] as? String) ?? peripheral.name ?? ""
+        let upper = name.uppercased()
+        guard upper.contains("FUJI") || upper.hasPrefix("X-") || upper.hasPrefix("GFX") || upper.hasPrefix("X100") else { return }
+        peers[peripheral.identifier] = peripheral
+        if let data = advertisementData[CBAdvertisementDataManufacturerDataKey] as? Data, data.count >= 7, data[2] == 2 {
+            advertisedTokens[peripheral.identifier] = Data(data[3..<7])
+        }
+        if !cameras.contains(where: { $0.id == peripheral.identifier }) {
+            cameras.append(FujiNearbyCamera(id: peripheral.identifier, name: name))
+        }
+    }
+    func connect(_ id: UUID) {
+        disconnect()
+        guard let selected = peers[id] else { return }
+        diagnostics = []; diagnosticStartedAt = Date()
+        handoffDiagnostic = "尚未执行本次富士热点交接。"
+        scanRequested = false; central.stopScan()
+        peer = selected; selected.delegate = self
+        status = "正在配对，请确认手机和相机显示的验证码。"
+        recordDiagnostic("开始建立蓝牙连接。")
+        central.connect(selected)
+        Task { [weak self, weak selected] in
+            try? await Task.sleep(nanoseconds: 45_000_000_000)
+            guard let self, let selected, self.peer === selected, !self.isReady else { return }
+            self.disconnect(); self.status = "蓝牙配对超时，可重新选择相机。"
+        }
+    }
+    func centralManager(_ central: CBCentralManager, didConnect peripheral: CBPeripheral) {
+        guard peripheral === peer else { return }; peripheral.discoverServices(nil)
+    }
+    func centralManager(_ central: CBCentralManager, didFailToConnect peripheral: CBPeripheral, error: Error?) {
+        guard peripheral === peer else { return }
+        status = "蓝牙连接失败：\(error?.localizedDescription ?? "请重试")"; failPending(); isReady = false
+    }
+    func centralManager(_ central: CBCentralManager, didDisconnectPeripheral peripheral: CBPeripheral, error: Error?) {
+        guard peripheral === peer else { return }
+        failPending(); isReady = false
+        recordDiagnostic("蓝牙已断开：\(error?.localizedDescription ?? "连接已结束")")
+        status = "蓝牙已断开，可重新配对。"
+    }
+    func peripheral(_ peripheral: CBPeripheral, didDiscoverServices error: Error?) {
+        guard error == nil, peripheral === peer, let services = peripheral.services else { failPending(); return }
+        pendingServices = Set(services.map(\.uuid))
+        for service in services { peripheral.discoverCharacteristics(nil, for: service) }
+    }
+    func peripheral(_ peripheral: CBPeripheral, didDiscoverCharacteristicsFor service: CBService, error: Error?) {
+        guard peripheral === peer else { return }
+        for characteristic in service.characteristics ?? [] { characteristics[characteristic.uuid] = characteristic }
+        pendingServices.remove(service.uuid)
+        guard pendingServices.isEmpty else { return }
+        let pairingID = peripheral.identifier
+        setupTask = Task { [weak self] in
+            guard let self else { return }
+            do {
+                if self.characteristics[Self.secureStatus] != nil {
+                    var value = try await self.read(Self.secureStatus)
+                    guard value.count == 4 else { throw PTPIPError.malformedPayload("富士安全配对状态长度不符") }
+                    value[3] = 0x20
+                    try await self.write(Self.secureStatus, value)
+                    self.recordDiagnostic("安全配对状态已读取并确认。")
+                } else if self.characteristics[Self.pairToken] != nil, let id = self.peer?.identifier {
+                    guard let token = self.advertisedTokens[id] ?? self.loadToken(id) else {
+                        throw CameraAppError.unsupportedOperation("请先在相机上打开新的蓝牙配对。")
+                    }
+                    try await self.write(Self.pairToken, token); self.saveToken(token, id: id)
+                    self.recordDiagnostic("传统配对凭据已确认。")
+                } else { throw CameraAppError.unsupportedOperation("该富士相机的蓝牙配对服务尚不受支持。") }
+                if self.characteristics[Self.clientName] != nil {
+                    try await self.write(Self.clientName, Data("CameraConnect iOS".utf8))
+                }
+                self.status = "正在等待相机蓝牙状态订阅完成…"
+                try await self.subscribeCameraStatus()
+                try Task.checkCancellation()
+                guard self.peer?.identifier == pairingID else { return }
+                self.isReady = true; self.status = "蓝牙已配对，可启动相机 Wi-Fi。"
+                self.recordDiagnostic(self.connectionDiagnostic)
+            } catch {
+                guard self.peer?.identifier == pairingID, !Task.isCancelled else { return }
+                self.status = error.localizedDescription; self.isReady = false
+                self.recordDiagnostic("蓝牙初始化失败：\(error.localizedDescription)")
+            }
+        }
+    }
+    func prepareWiFi(purpose: FujiWiFiPurpose = .gallery) async {
+        do {
+            try await readWiFiCredentials(purpose: purpose)
+            status = "网络信息已读取，连接相机时会自动请求加入 Wi-Fi。"
+        } catch { status = "启动 Wi-Fi 失败：\(error.localizedDescription)" }
+    }
+    func readWiFiCredentials(purpose: FujiWiFiPurpose = .gallery) async throws {
+        guard isReady else { throw CameraAppError.notConnected }
+        let name = try await read(Self.wifiSSID)
+        ssid = String(decoding: name.prefix { $0 != 0 }, as: UTF8.self)
+        guard !ssid.isEmpty else { throw CameraAppError.unsupportedOperation("相机没有返回 Wi-Fi 名称。") }
+        let hasReadySignal = characteristics[Self.wifiReady].map {
+            $0.properties.contains(.notify) || $0.properties.contains(.indicate)
+        } ?? false
+        if hasReadySignal { try await subscribe(Self.wifiReady) }
+        wifiReadyValue = nil
+        handoffDiagnostic = "已请求\(purpose.label)，等待本次请求的热点就绪通知。"
+        status = "正在启动富士 Wi-Fi：\(purpose.label)，等待机身就绪…"
+        try await write(Self.wifiTrigger, purpose.request)
+        recordDiagnostic("已发送启动请求：\(purpose.label)。")
+        let secret = try await read(Self.wifiPass)
+        wifiPassword = String(decoding: secret.prefix { $0 != 0 }, as: UTF8.self)
+        if hasReadySignal {
+            let deadline = Date().addingTimeInterval(20)
+            while Date() < deadline {
+                try Task.checkCancellation()
+                guard isReady else { throw CameraAppError.notConnected }
+                if wifiReadyValue?.first == 1 {
+                    handoffDiagnostic = "已请求\(purpose.label)；相机已通过蓝牙返回热点就绪标志 01。"
+                    status = "相机热点已就绪，准备加入 Wi-Fi。"
+                    recordDiagnostic(handoffDiagnostic)
+                    return
+                }
+                try await Task.sleep(nanoseconds: 200_000_000)
+            }
+            let state = wifiReadyValue.flatMap { $0.first }.map { String(format: "%02X", $0) } ?? "未收到"
+            handoffDiagnostic = "请求\(purpose.label)后等待热点就绪超时；本次状态首字节：\(state)。"
+            throw CameraAppError.unsupportedOperation("富士尚未确认热点就绪（\(state)）。请让机身保持开机，退出菜单后重试；暂不发送相机会话指令。")
+        }
+        handoffDiagnostic = "已请求\(purpose.label)；此机身未提供可订阅的热点就绪通知，入网与 TCP 状态仍需分别确认。"
+        try await Task.sleep(nanoseconds: 2_000_000_000)
+    }
+    private func subscribeCameraStatus() async throws {
+        // 可选通知按机身实际提供的接口订阅，总等待不超过 10 秒，避免旧机型阻塞连接。
+        let deadline = Date().addingTimeInterval(10)
+        var absent: [String] = []
+        for item in Self.statusSubscriptions {
+            try Task.checkCancellation()
+            guard let characteristic = characteristics[item.uuid],
+                  characteristic.properties.contains(.notify) || characteristic.properties.contains(.indicate) else {
+                absent.append(item.name); continue
+            }
+            let remaining = deadline.timeIntervalSinceNow
+            guard remaining > 0 else {
+                recordDiagnostic("通知订阅等待已达上限；其余可选项未确认。")
+                break
+            }
+            do {
+                try await subscribe(item.uuid, timeout: min(3, remaining))
+                recordDiagnostic("状态订阅完成：\(item.name)。")
+            } catch {
+                try Task.checkCancellation()
+                guard peer?.state == .connected else { throw CameraAppError.notConnected }
+                recordDiagnostic("状态订阅未完成：\(item.name)，\(error.localizedDescription)")
+                if item.uuid == Self.wifiReady { throw error }
+            }
+        }
+        if !absent.isEmpty { recordDiagnostic("机身未提供可订阅接口：\(absent.joined(separator: "、"))。") }
+    }
+
+    private func subscribe(_ uuid: CBUUID, timeout: Double = 8) async throws {
+        try Task.checkCancellation()
+        guard let peer, let characteristic = characteristics[uuid] else { throw CameraAppError.notConnected }
+        if characteristic.isNotifying { return }
+        guard notifications[uuid] == nil else { throw CameraAppError.unsupportedOperation("富士通知订阅尚未完成。") }
+        let token = UUID()
+        let uuidString = uuid.uuidString
+        try await withTaskCancellationHandler {
+            try Task.checkCancellation()
+            try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, Error>) in
+                notifications[uuid] = (token, continuation)
+                peer.setNotifyValue(true, for: characteristic)
+                Task { [weak self] in
+                    try? await Task.sleep(nanoseconds: UInt64(timeout * 1_000_000_000))
+                    guard let self, self.notifications[uuid]?.0 == token else { return }
+                    self.notifications.removeValue(forKey: uuid)?.1.resume(throwing: PTPIPError.timeout("订阅富士状态通知"))
+                }
+            }
+        } onCancel: {
+            Task { @MainActor [weak self] in
+                let uuid = CBUUID(string: uuidString)
+                guard let self, self.notifications[uuid]?.0 == token else { return }
+                self.notifications.removeValue(forKey: uuid)?.1.resume(throwing: CancellationError())
+            }
+        }
+    }
+    func restoreConnection(_ identifier: String) async throws {
+        guard let id = UUID(uuidString: identifier) else { throw CameraAppError.notConnected }
+        if isReady, connectedIdentifier == identifier { return }
+        if central == nil { central = CBCentralManager(delegate: self, queue: .main) }
+        for _ in 0..<30 {
+            try Task.checkCancellation()
+            if central.state == .poweredOn { break }
+            if central.state == .unauthorized || central.state == .poweredOff {
+                throw CameraAppError.unsupportedOperation("请开启蓝牙并允许本应用访问。")
+            }
+            try await Task.sleep(nanoseconds: 100_000_000)
+        }
+        guard let camera = central.retrievePeripherals(withIdentifiers: [id]).first else {
+            throw CameraAppError.unsupportedOperation("找不到此前配对的富士相机，请重新配对。")
+        }
+        peers[id] = camera; connect(id)
+        do {
+            for _ in 0..<200 {
+                try Task.checkCancellation()
+                if isReady, connectedIdentifier == identifier { return }
+                try await Task.sleep(nanoseconds: 100_000_000)
+            }
+            throw CameraAppError.unsupportedOperation("恢复蓝牙超时，请开启相机或重新配对。")
+        } catch { disconnect(); throw error }
+    }
+    func autofocus() async throws {
+        guard isReady else { throw CameraAppError.notConnected }
+        do {
+            // 每个蓝牙动作先发 01 00 命令前缀，再发半按或释放参数；不触发拍照。
+            try await write(Self.shutter, Data([1, 0]))
+            try await write(Self.shutter, Data([3, 0]))
+            try await Task.sleep(nanoseconds: 500_000_000)
+            try await write(Self.shutter, Data([1, 0]))
+            try await write(Self.shutter, Data([0, 0]))
+        } catch {
+            try? await write(Self.shutter, Data([1, 0]))
+            try? await write(Self.shutter, Data([0, 0]))
+            throw error
+        }
+    }
+    func releaseShutter() async throws {
+        guard isReady else { throw CameraAppError.notConnected }
+        do {
+            try await write(Self.shutter, Data([1, 0]))
+            try await write(Self.shutter, Data([2, 0]))
+            try await Task.sleep(nanoseconds: 150_000_000)
+            try await write(Self.shutter, Data([1, 0]))
+            try await write(Self.shutter, Data([0, 0]))
+        } catch {
+            try? await write(Self.shutter, Data([1, 0]))
+            try? await write(Self.shutter, Data([0, 0]))
+            throw error
+        }
+    }
+    private func read(_ uuid: CBUUID) async throws -> Data {
+        try Task.checkCancellation()
+        guard let peer, let characteristic = characteristics[uuid], characteristic.properties.contains(.read), reads[uuid] == nil else {
+            throw CameraAppError.unsupportedOperation("相机缺少所需蓝牙读取接口。")
+        }
+        let token = UUID()
+        return try await withCheckedThrowingContinuation { continuation in
+            reads[uuid] = (token, continuation); peer.readValue(for: characteristic)
+            Task { [weak self] in
+                try? await Task.sleep(nanoseconds: 20_000_000_000)
+                guard let self, self.reads[uuid]?.0 == token else { return }
+                self.reads.removeValue(forKey: uuid)?.1.resume(throwing: PTPIPError.timeout("蓝牙读取"))
+            }
+        }
+    }
+    private func write(_ uuid: CBUUID, _ data: Data) async throws {
+        try Task.checkCancellation()
+        guard let peer, let characteristic = characteristics[uuid], characteristic.properties.contains(.write), writes[uuid] == nil else {
+            throw CameraAppError.unsupportedOperation("相机缺少所需蓝牙写入接口。")
+        }
+        let token = UUID()
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, Error>) in
+            writes[uuid] = (token, continuation); peer.writeValue(data, for: characteristic, type: .withResponse)
+            Task { [weak self] in
+                try? await Task.sleep(nanoseconds: 20_000_000_000)
+                guard let self, self.writes[uuid]?.0 == token else { return }
+                self.writes.removeValue(forKey: uuid)?.1.resume(throwing: PTPIPError.timeout("蓝牙写入"))
+            }
+        }
+    }
+    func peripheral(_ peripheral: CBPeripheral, didUpdateValueFor characteristic: CBCharacteristic, error: Error?) {
+        guard peripheral === peer else { return }
+        if characteristic.uuid == Self.wifiReady, error == nil {
+            wifiReadyValue = characteristic.value
+        }
+        if let pending = reads.removeValue(forKey: characteristic.uuid) {
+            if let error { pending.1.resume(throwing: error) }
+            else { pending.1.resume(returning: characteristic.value ?? Data()) }
+        }
+    }
+    func peripheral(_ peripheral: CBPeripheral, didUpdateNotificationStateFor characteristic: CBCharacteristic, error: Error?) {
+        guard peripheral === peer, let pending = notifications.removeValue(forKey: characteristic.uuid) else { return }
+        if let error { pending.1.resume(throwing: error) }
+        else if characteristic.isNotifying { pending.1.resume() }
+        else { pending.1.resume(throwing: CameraAppError.unsupportedOperation("富士未启用所请求的状态通知。")) }
+    }
+    func peripheral(_ peripheral: CBPeripheral, didWriteValueFor characteristic: CBCharacteristic, error: Error?) {
+        guard peripheral === peer, let pending = writes.removeValue(forKey: characteristic.uuid) else { return }
+        if let error { pending.1.resume(throwing: error) } else { pending.1.resume() }
+    }
+    func disconnect() {
+        setupTask?.cancel(); setupTask = nil; failPending()
+        if let peer { central?.cancelPeripheralConnection(peer) }
+        peer = nil; characteristics = [:]; pendingServices = []; isReady = false; wifiPassword = ""; ssid = ""
+        wifiReadyValue = nil
+    }
+    private func failPending() {
+        let pendingReads = reads; reads = [:]; let pendingWrites = writes; writes = [:]
+        let pendingNotifications = notifications; notifications = [:]
+        for item in pendingReads.values { item.1.resume(throwing: CancellationError()) }
+        for item in pendingWrites.values { item.1.resume(throwing: CancellationError()) }
+        for item in pendingNotifications.values { item.1.resume(throwing: CancellationError()) }
+    }
+    private func saveToken(_ token: Data, id: UUID) {
+        let key: [String: Any] = [kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: "CameraConnect.FujiPair", kSecAttrAccount as String: id.uuidString]
+        SecItemDelete(key as CFDictionary)
+        var value = key; value[kSecValueData as String] = token
+        value[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+        SecItemAdd(value as CFDictionary, nil)
+    }
+    private func loadToken(_ id: UUID) -> Data? {
+        let query: [String: Any] = [kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: "CameraConnect.FujiPair", kSecAttrAccount as String: id.uuidString,
+            kSecReturnData as String: true, kSecMatchLimit as String: kSecMatchLimitOne]
+        var result: CFTypeRef?; guard SecItemCopyMatching(query as CFDictionary, &result) == errSecSuccess else { return nil }
+        return result as? Data
+    }
+}
