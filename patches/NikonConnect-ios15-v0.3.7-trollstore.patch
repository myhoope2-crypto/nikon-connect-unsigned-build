+++ b/Features/ConnectionSetup/NearbyCamerasView.swift
@@ -0,0 +1,80 @@
+import SwiftUI
+
+struct NearbyCamerasView: View {
+    @ObservedObject private var discovery = NearbyCameraDiscovery.shared
+    @ObservedObject private var nativeBluetooth = NativeCameraBluetooth.shared
+    #if TROLLSTORE
+    @ObservedObject private var trollWiFi = TrollStoreWiFi.shared
+    #endif
+    let selecting: UUID?
+    let busy: Bool
+    let selectionStatus: String
+    let onSelect: (NearbyCamera) -> Void
+    let onStop: () -> Void
+    private var actionsBusy:Bool {
+        #if TROLLSTORE
+        return busy || trollWiFi.isJoining
+        #else
+        return busy
+        #endif
+    }
+    var body: some View {
+        CustomCard {
+            VStack(alignment:.leading,spacing:14) {
+                Label("搜索附近相机",systemImage:"dot.radiowaves.left.and.right").font(.headline)
+                Text(discovery.searchExplanation)
+                    .font(.footnote).foregroundColor(AppTheme.inkMuted)
+                Button {
+                    if discovery.isScanning { discovery.stopScan() } else { discovery.scan() }
+                } label: {
+                    Label(discovery.isScanning ? "停止搜索" : "重新搜索附近相机",systemImage:discovery.isScanning ? "stop.circle.fill" : "magnifyingglass")
+                        .font(.headline).frame(maxWidth:.infinity,minHeight:46)
+                        .foregroundColor(AppTheme.onAction).background(AppTheme.actionFill,in:RoundedRectangle(cornerRadius:12))
+                }.buttonStyle(.plain).disabled(actionsBusy)
+                Text(discovery.status).font(.caption).foregroundColor(AppTheme.inkMuted)
+                if !discovery.bluetoothStatus.isEmpty { Text(discovery.bluetoothStatus).font(.caption).foregroundColor(AppTheme.inkMuted) }
+                if !discovery.networkStatus.isEmpty { Text(discovery.networkStatus).font(.caption).foregroundColor(AppTheme.inkMuted) }
+                if !selectionStatus.isEmpty { Text(selectionStatus).font(.footnote).foregroundColor(AppTheme.ink) }
+                if selecting != nil {
+                    Button("停止连接所选相机",role:.destructive,action:onStop).buttonStyle(.bordered)
+                    if (discovery.nearby + discovery.saved).first(where:{ $0.id == selecting })?.brand == .nikon {
+                        Text(discovery.nikonStatus).font(.caption).foregroundColor(AppTheme.inkMuted)
+                    } else if let item = (discovery.nearby + discovery.saved).first(where:{ $0.id == selecting }),
+                              item.usesBluetooth, [.canon,.ricoh,.pentax,.panasonic].contains(item.brand), !nativeBluetooth.status.isEmpty {
+                        Text(nativeBluetooth.status).font(.caption).foregroundColor(AppTheme.inkMuted)
+                    }
+                }
+                if !discovery.nearby.isEmpty {
+                    Text("发现的相机与连接候选").font(.subheadline.bold())
+                    ForEach(discovery.nearby) { item in cameraButton(item,nearby:true) }
+                }
+                let saved = discovery.saved.filter { item in !discovery.nearby.contains(where:{ $0.id == item.id }) }
+                if !saved.isEmpty {
+                    Text("已保存的相机").font(.subheadline.bold())
+                    ForEach(saved) { item in cameraButton(item,nearby:false) }
+                }
+                #if TROLLSTORE
+                TrollStoreNearbyWiFiView(busy:busy,onJoined:{ discovery.stopScan(); discovery.scan() })
+                #endif
+                Text(discovery.discoveryLimitations)
+                    .font(.caption).foregroundColor(AppTheme.inkMuted)
+            }
+        }
+    }
+    private func cameraButton(_ item: NearbyCamera, nearby: Bool) -> some View {
+        Button { onSelect(item) } label: {
+            HStack(spacing:12) {
+                Image(systemName:"camera.fill").foregroundColor(AppTheme.accentStrong)
+                VStack(alignment:.leading,spacing:4) {
+                    Text(item.name).font(.headline).foregroundColor(AppTheme.ink)
+                    Text("\(item.brand.title) · \(nearby ? (item.usesBluetooth ? "附近蓝牙广播" : "当前网络响应") : "保存记录，需重新连接")" + (item.signal.map { " · 信号 \($0) dBm" } ?? ""))
+                        .font(.caption).foregroundColor(AppTheme.inkMuted)
+                    Text(item.connectionHint)
+                        .font(.caption).foregroundColor(AppTheme.inkMuted)
+                }
+                Spacer()
+                if selecting == item.id { ProgressView() } else { Image(systemName:"chevron.right").foregroundColor(AppTheme.accentStrong) }
+            }.padding(12).background(AppTheme.surfaceMuted,in:RoundedRectangle(cornerRadius:12))
+        }.buttonStyle(.plain).disabled(actionsBusy)
+    }
+}
diff --git a/Features/ConnectionSetup/TrollStoreNearbyWiFiView.swift b/Features/ConnectionSetup/TrollStoreNearbyWiFiView.swift
new file mode 100644
index 0000000..3a6778e
--- /dev/null
+++ b/Features/ConnectionSetup/TrollStoreNearbyWiFiView.swift
@@ -0,0 +1,125 @@
+#if TROLLSTORE
+import SwiftUI
+
+struct TrollStoreNearbyWiFiView: View {
+    @ObservedObject private var wifi = TrollStoreWiFi.shared
+    let busy: Bool
+    let onJoined: () -> Void
+    @State private var showOtherNetworks = false
+    @State private var passwordTarget: TrollWiFiNetwork?
+    @State private var task: Task<Void,Never>?
+    @State private var joiningID: String?
+    @State private var message = ""
+    var body: some View {
+        VStack(alignment:.leading,spacing:12) {
+            Divider()
+            Label("附近相机热点 · 巨魔版",systemImage:"wifi").font(.headline)
+            Toggle(isOn:$wifi.directJoinEnabled) {
+                Text("直接加入 Wi-Fi，免系统加入确认（实验）").fixedSize(horizontal:false,vertical:true)
+            }
+                .disabled(busy || joiningID != nil)
+            Text("搜索时不会切换网络。选择具体热点后再连接；首次加密连接需要相机密码。蓝牙配对与本地网络授权仍可能需要确认。")
+                .font(.caption).foregroundColor(AppTheme.inkMuted)
+            Text(wifi.status).font(.caption).foregroundColor(AppTheme.inkMuted)
+            Button { wifi.startDiscovery() } label: {
+                Label(wifi.isScanning ? "正在扫描热点…" : "重新扫描 Wi-Fi 热点",systemImage:"arrow.clockwise")
+            }.buttonStyle(.bordered).disabled(busy || joiningID != nil || wifi.isScanning || wifi.isJoining)
+            DisclosureGroup("无线诊断（权限与扫描结果）") {
+                Text(wifi.scanDiagnostics).font(.caption).foregroundColor(AppTheme.inkMuted)
+                    .frame(maxWidth:.infinity,alignment:.leading).textSelection(.enabled)
+            }.font(.subheadline)
+            if !message.isEmpty { Text(message).font(.footnote).foregroundColor(AppTheme.ink) }
+            if joiningID != nil {
+                Button("停止加入所选热点",role:.destructive) { task?.cancel(); wifi.cancelConnection() }.buttonStyle(.bordered)
+            }
+            let cameras = wifi.networks.filter { $0.brand != nil }
+            ForEach(cameras) { network in networkRow(network) }
+            if !wifi.isScanning && cameras.isEmpty && !wifi.hasScanFailure {
+                Text(wifi.networks.isEmpty ? "当前列表没有热点。可开启手机 Wi-Fi，并启动相机热点后重新扫描；未开热点的相机需先通过蓝牙唤醒。" : "未发现名称可识别的相机热点。可展开其他热点，或通过蓝牙启动相机 Wi-Fi 后重试。")
+                    .font(.caption).foregroundColor(AppTheme.inkMuted)
+            }
+            DisclosureGroup("其他热点（\(wifi.networks.filter { $0.brand == nil }.count) 个，名称未识别）",isExpanded:$showOtherNetworks) {
+                VStack(spacing:8) { ForEach(wifi.networks.filter { $0.brand == nil }) { network in networkRow(network) } }
+            }.font(.subheadline)
+            Text("热点名称不能证明设备品牌；入网后仍会识别相机协议。相机未开启 Wi-Fi 时，热点不会出现在这里。")
+                .font(.caption).foregroundColor(AppTheme.inkMuted)
+            Text("扫描使用巨魔包内的无线管理权限，不会弹出普通 Wi-Fi 授权框。蓝牙、本地网络和系统加入确认是不同的权限或操作。")
+                .font(.caption).foregroundColor(AppTheme.inkMuted)
+        }.sheet(item:$passwordTarget) { network in
+            TrollStoreWiFiPasswordView(network:network) { password in begin(network,password:password) }
+        }.onDisappear { task?.cancel(); if joiningID != nil { wifi.cancelConnection() } }
+    }
+    private func networkRow(_ network:TrollWiFiNetwork) -> some View {
+        VStack(alignment:.leading,spacing:4) {
+            Button {
+                if network.requiresPassword {
+                    if let access = wifi.credentials(for:network), !access.open { begin(network,password:access.password) }
+                    else { passwordTarget = network }
+                } else { begin(network,password:"") }
+            } label: {
+                HStack {
+                    Image(systemName:network.requiresPassword ? "wifi" : "wifi.exclamationmark").foregroundColor(AppTheme.accentStrong)
+                    VStack(alignment:.leading,spacing:3) {
+                        Text(network.ssid).font(.headline).foregroundColor(AppTheme.ink)
+                        Text((network.brand.map { "\($0.title)名称候选 · " } ?? "未识别热点 · ") + network.security)
+                            .font(.caption).foregroundColor(AppTheme.inkMuted)
+                        Text((network.bssid.isEmpty ? "热点地址不可用" : "热点地址：\(network.bssid)") +
+                             (network.channel.map { " · 信道 \($0)" } ?? "") + (network.signal.map { " · \($0) dBm" } ?? ""))
+                            .font(.caption2).foregroundColor(AppTheme.inkMuted)
+                    }
+                    Spacer()
+                    if joiningID == network.id { ProgressView() } else { Image(systemName:"chevron.right").foregroundColor(AppTheme.accentStrong) }
+                }.padding(12).background(AppTheme.surfaceMuted,in:RoundedRectangle(cornerRadius:12))
+            }.buttonStyle(.plain).disabled(busy || joiningID != nil || network.unsupportedSecurity)
+            if network.requiresPassword && !network.unsupportedSecurity {
+                Button("输入或更新此热点密码") { passwordTarget = network }
+                    .font(.caption).disabled(busy || joiningID != nil)
+            }
+            if network.unsupportedSecurity { Text("认证方式暂不支持，请到系统 Wi-Fi 设置加入。").font(.caption).foregroundColor(AppTheme.inkMuted) }
+        }
+    }
+    private func begin(_ network:TrollWiFiNetwork,password:String) {
+        guard joiningID == nil,!busy else { return }
+        NearbyCameraDiscovery.shared.stopScan(); joiningID = network.id; message = ""
+        task = Task {
+            defer { joiningID = nil; task = nil }
+            do {
+                if wifi.directJoinEnabled {
+                    try await wifi.join(ssid:network.ssid,password:password,open:!network.requiresPassword,
+                        bssid:network.bssid.isEmpty ? nil : network.bssid)
+                } else {
+                    try await CameraWiFiCoordinator.shared.joinNetwork(ssid:network.ssid,password:password,open:!network.requiresPassword)
+                }
+                try Task.checkCancellation()
+                message = "已加入所选热点，正在识别该网络中的相机。"
+                onJoined()
+            } catch {
+                message = Task.isCancelled || (error as NSError).code == NSUserCancelledError ? "已停止加入；已完成的无线切换可能仍保留。" : error.localizedDescription
+            }
+        }
+    }
+}
+
+private struct TrollStoreWiFiPasswordView: View {
+    let network:TrollWiFiNetwork
+    let onConnect:(String)->Void
+    @Environment(\.dismiss) private var dismiss
+    @State private var password = ""
+    var body:some View {
+        NavigationView {
+            Form {
+                Section(header:Text("连接所选相机热点")) {
+                    Text(network.ssid)
+                    if !network.bssid.isEmpty { Text("热点地址：\(network.bssid)").font(.caption) }
+                    SecureField("相机显示的 Wi-Fi 密码",text:$password).textInputAutocapitalization(.never).disableAutocorrection(true)
+                    Text("连接成功后仅保存在本应用的本机钥匙串。不会读取其他应用或系统保存的网络密码。")
+                        .font(.footnote).foregroundColor(AppTheme.inkMuted)
+                    Button("加入并识别相机") { dismiss(); onConnect(password) }
+                        .disabled(!((8...63).contains(password.utf8.count) || (password.count == 64 && password.allSatisfy(\.isHexDigit))))
+                }
+            }.foregroundColor(AppTheme.ink).navigationTitle("相机 Wi-Fi 密码")
+                .toolbar { ToolbarItem(placement:.cancellationAction) { Button("取消") { dismiss() } } }
+        }.navigationViewStyle(.stack).tint(AppTheme.accentStrong)
+    }
+}
+#endif
