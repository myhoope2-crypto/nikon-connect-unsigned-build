+                    guard foreground, connection.activeSession?.id == sessionID else { return }
+                    if attempt > 0 { try await Task.sleep(nanoseconds: 250_000_000) }
+                    let result = try await remote.cameraParameters(only: [parameter])
+                    guard connection.activeSession?.id == sessionID else { return }
+                    acceptParameters(result, replacing: [parameter])
+                    if let actual = result.first(where: { $0.id == parameter }), actual.confirms(choice) {
+                        needsFullParameterRefresh = true
+                        parameterStatus = "相机已确认：\(actual.title) · \(actual.current.title)"
+                        return
+                    }
+                }
+                parameterStatus = "相机回读值与选择不同，已显示实际返回值。请检查拍摄模式、拨盘或相机锁定状态。"
