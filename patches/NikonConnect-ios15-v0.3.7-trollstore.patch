@@ -0,0 +1,35 @@
+import Foundation
+
+// 仅解析当前响应；禁用外部实体，避免从相机返回的 XML 请求其他地址。
+final class CameraXML: NSObject, XMLParserDelegate {
+    final class Node {
+        let name: String
+        let attributes: [String:String]
+        var text = ""
+        var children: [Node] = []
+        init(_ name:String, _ attributes:[String:String] = [:]) { self.name = name.components(separatedBy:":").last ?? name; self.attributes = attributes }
+        func all(_ name:String) -> [Node] { (self.name.caseInsensitiveCompare(name) == .orderedSame ? [self] : []) + children.flatMap { $0.all(name) } }
+        func first(_ name:String) -> String? { all(name).first?.text.trimmingCharacters(in:.whitespacesAndNewlines) }
+    }
+    private let root = Node("document")
+    private var stack: [Node] = []
+    private var nodes = 0
+    static func parse(_ data:Data) throws -> Node {
+        guard data.count <= 8 * 1024 * 1024 else { throw PTPIPError.malformedPayload("XML 响应过大") }
+        let delegate = CameraXML(); delegate.stack = [delegate.root]
+        let parser = XMLParser(data:data); parser.shouldResolveExternalEntities = false; parser.delegate = delegate
+        guard parser.parse() else { throw PTPIPError.malformedPayload("相机 XML 响应无效") }
+        return delegate.root
+    }
+    func parser(_ parser:XMLParser,didStartElement elementName:String,namespaceURI:String?,qualifiedName:String?,attributes attributeDict:[String:String]) {
+        nodes += 1
+        guard stack.count < 64, nodes <= 100000 else { parser.abortParsing(); return }
+        let node = Node(elementName,attributeDict); stack.last?.children.append(node); stack.append(node)
+    }
+    func parser(_ parser:XMLParser,foundCharacters string:String) { stack.last?.text += string }
+    func parser(_ parser:XMLParser,foundCDATA CDATABlock:Data) { stack.last?.text += String(decoding:CDATABlock,as:UTF8.self) }
+    func parser(_ parser:XMLParser,didEndElement elementName:String,namespaceURI:String?,qualifiedName:String?) { if stack.count > 1 { stack.removeLast() } }
+    static func escape(_ text:String) -> String {
+        text.replacingOccurrences(of:"&",with:"&amp;").replacingOccurrences(of:"<",with:"&lt;").replacingOccurrences(of:">",with:"&gt;").replacingOccurrences(of:"\"",with:"&quot;")
+    }
+}
