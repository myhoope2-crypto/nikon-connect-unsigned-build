+#import "TrollBackgroundBridge.h"
+#import <dlfcn.h>
+#import <unistd.h>
+
+// 独立声明运行时接口；框架缺失时可以正常启动并降级。
+@protocol NCProcessAssertion <NSObject>
+- (instancetype)initWithPID:(int)pid flags:(unsigned int)flags reason:(unsigned int)reason
+                      name:(NSString *)name withHandler:(void (^)(BOOL acquired))handler;
+@property(nonatomic, readonly) BOOL valid;
+@property(nonatomic, copy, nullable) void (^invalidationHandler)(void);
+- (void)invalidate;
+@end
+
+@interface TrollBackgroundBridge ()
+@property(nonatomic, strong, nullable) id<NCProcessAssertion> assertion;
+@property(nonatomic) NSUInteger generation;
+@end
+
+@implementation TrollBackgroundBridge
+- (void)beginWithUpdate:(void (^)(BOOL, NSString *))update {
+    NSAssert([NSThread isMainThread], @"必须在主线程管理断言");
+    [self end];
+    NSUInteger ticket = self.generation;
+    static void *framework;
+    if (!framework) framework = dlopen("/System/Library/PrivateFrameworks/AssertionServices.framework/AssertionServices", RTLD_LAZY | RTLD_LOCAL);
+    Class cls = framework ? NSClassFromString(@"BKSProcessAssertion") : Nil;
+    SEL initializer = @selector(initWithPID:flags:reason:name:withHandler:);
+    if (!cls || ![cls instancesRespondToSelector:initializer] ||
+        ![cls instancesRespondToSelector:@selector(valid)] ||
+        ![cls instancesRespondToSelector:@selector(invalidate)] ||
+        ![cls instancesRespondToSelector:@selector(setInvalidationHandler:)]) {
+        update(NO, @"当前系统缺少后台运行接口，使用普通后台宽限时间。"); return;
+    }
+    __weak typeof(self) weakSelf = self;
+    @try {
+        // PreventTaskSuspend | PreventTaskThrottleDown；不请求保持屏幕点亮。
+        self.assertion = [(id<NCProcessAssertion>)[cls alloc] initWithPID:getpid() flags:3 reason:7
+            name:@"Camera transfer (TrollStore experimental)" withHandler:^(BOOL acquired) {
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    typeof(self) owner = weakSelf;
+                    if (!owner || owner.generation != ticket) return;
+                    BOOL valid = acquired && owner.assertion.valid;
+                    update(valid, valid ? @"系统已接受后台运行请求（实验）；锁屏持续传输仍需真机验证。" :
+                        @"系统拒绝后台运行请求，已降级为普通后台传输。请回到前台继续。");
+                });
+            }];
+        if (!self.assertion) { update(NO, @"未能创建后台运行请求，使用普通后台传输。"); return; }
+        self.assertion.invalidationHandler = ^{
+            dispatch_async(dispatch_get_main_queue(), ^{
+                typeof(self) owner = weakSelf;
+                if (!owner || owner.generation != ticket) return;
+                owner.assertion = nil;
+                update(NO, @"系统已收回后台运行权限；传输将保存进度并使用普通后台宽限时间。");
+            });
+        };
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 8 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+            typeof(self) owner = weakSelf;
+            if (!owner || owner.generation != ticket || owner.assertion.valid) return;
+            [owner end]; update(NO, @"后台运行请求未获确认，已降级为普通后台传输。");
+        });
+    } @catch (NSException *exception) {
+        [self end]; update(NO, @"后台运行接口不可用，使用普通后台传输。");
+    }
+}
+- (void)end {
+    self.generation += 1;
+    id<NCProcessAssertion> previous = self.assertion; self.assertion = nil;
+    @try { previous.invalidationHandler = nil; [previous invalidate]; } @catch (NSException *exception) { }
+}
+@end
