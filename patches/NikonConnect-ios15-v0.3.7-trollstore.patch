+import Foundation
+
+// 不将自定义槽编码、其他机型的索引或未经确认的名称套用到当前参数。
+enum CameraExtendedParameterLabels {
+    static func title(code: UInt16, value: Int64, profile: CameraParameterDecoder.Profile, model: String) -> String? {
+        let unknown = String(format: "未识别（相机值 0x%X）", UInt32(truncatingIfNeeded: value))
+        if code == 0x500e {
+            if profile == .nikon, CameraSettingCatalog.isNikonZ(model),
+               let title = [Int64(0x8010): "AUTO · 自动", 0x8050: "U1 · 用户设定", 0x8051: "U2 · 用户设定", 0x8052: "U3 · 用户设定"][value] {
+                return title
+            }
+            return [1: "M · 手动曝光", 2: "P · 程序自动", 3: "A · 光圈优先", 4: "S · 快门优先"][value] ?? unknown
+        }
+        if profile == .fuji {
+            switch code {
+            case 0x500a:
+                return [1: "MF · 手动对焦", 0x8001: "AF-S · 单次自动对焦", 0x8002: "AF-C · 连续自动对焦"][value] ?? unknown
+            case 0x500b:
+                return [1: "平均", 2: "中央重点", 3: "多重", 4: "点测光", 0x8001: "点测光"][value] ?? unknown
+            case 0x501c:
+                return [0x8001: "单点", 0x8002: "区域", 0x8003: "广域 / 跟踪"][value] ?? unknown
+            case 0x5012: return value == 0 ? "关闭" : String(format: "%.0f 秒", Double(value) / 1000)
+            case 0xd201:
+                return [2: "CH · 高速连拍", 3: "CL · 低速连拍", 4: "单拍", 5: "多重曝光",
+                    6: "创意滤镜", 7: "全景", 8: "视频", 9: "高动态范围",
+                    10: "自动曝光包围", 11: "ISO 包围", 12: "胶片模拟包围", 13: "白平衡包围",
+                    14: "动态范围包围", 15: "对焦包围", 16: "像素位移", 17: "高速连拍裁切"][value] ?? unknown
+            case 0xd018:
+                return [1: "RAW", 2: "FINE · 精细 JPG", 3: "NORMAL · 标准 JPG",
+                    4: "RAW + FINE", 5: "RAW + NORMAL"][value] ?? unknown
+            case 0xd022:
+                return [1: "无压缩", 2: "无损压缩", 3: "有损压缩"][value] ?? unknown
+            case 0xd00a: return [1: "sRGB · 标准色彩空间", 2: "Adobe RGB · 广色域"][value] ?? unknown
+            case 0xd00b, 0xd00c: return String(format: "%+d", Int(value))
+            case 0xd007:
+                return [100: "DR100 · 100%", 200: "DR200 · 200%", 400: "DR400 · 400%", 65535: "自动"][value] ?? unknown
+            case 0xd02e:
+                return [0: "关闭", 1: "弱", 2: "强", 0x8000: "自动"][value] ?? unknown
+            case 0x5015, 0xd008, 0xd032, 0xd320, 0xd321:
+                // X-T5 实时描述确认采用有符号十分之一刻度；保留半档，不按整数截断。
+                return String(format: value % 10 == 0 ? "%+.0f" : "%+.1f", Double(value) / 10)
+            case 0xd01c:
+                return [0: "+2", 0x1000: "+1", 0x2000: "0", 0x3000: "−1", 0x4000: "−2",
+                    0x5000: "+4", 0x6000: "+3", 0x7000: "−3", 0x8000: "−4"][value] ?? unknown
+            case 0xd023:
+                return [1: "关闭", 2: "弱 · 小颗粒", 3: "强 · 小颗粒", 4: "弱 · 大颗粒",
+                    5: "强 · 大颗粒", 6: "关闭（保留小颗粒）", 7: "关闭（保留大颗粒）"][value] ?? unknown
+            case 0xd029, 0xd030: return [1: "关闭", 2: "弱", 3: "强"][value] ?? unknown
+            // 身份、数值含义尚未有可靠同模式依据的项，显示原始值而不猜测写入。
+            case 0xd020, 0xd024, 0xd03c, 0xd351, 0xd202, 0xd204: return unknown
+            default: return nil
+            }
+        }
+        if profile == .nikon {
+            switch code {
+            case 0x500a:
+                return [1: "MF · 手动对焦", 0x8010: "AF-S · 单次自动对焦", 0x8011: "AF-C · 连续自动对焦",
+                    0x8012: "AF-A · 自动切换", 0x8013: "AF-F · 全时自动对焦"][value] ?? unknown
+            case 0xd061:
+                return [0: "AF-S · 单次自动对焦", 1: "AF-C · 连续自动对焦", 2: "AF-F · 全时自动对焦",
+                    3: "MF · 手动对焦（实体开关）", 4: "MF · 手动对焦"][value] ?? unknown
+            case 0x501c, 0xd05d:
+                return [0x8010: "单点 AF", 0x8011: "自动区域 AF", 0x8012: "3D 跟踪",
+                    0x8017: "微点 AF", 0x8018: "宽区域 AF（小）", 0x8019: "宽区域 AF（大）",
+                    0x801e: "宽区域 AF（C1）", 0x801f: "宽区域 AF（C2）"][value] ?? unknown
+            case 0x500b:
+                return [1: "平均", 2: "中央重点", 3: "矩阵测光", 4: "点测光", 0x8010: "亮部重点"][value] ?? unknown
+            case 0x5013:
+                return [1: "单张拍摄", 2: "连续拍摄", 3: "延时拍摄", 0x8010: "低速连拍",
+                    0x8011: "自拍", 0x8012: "反光板弹起", 0x8016: "安静拍摄"][value] ?? unknown
+            case 0xd063: return [0: "2 秒", 1: "5 秒", 2: "10 秒", 3: "20 秒"][value] ?? unknown
+            case 0x5004:
+                guard CameraSettingCatalog.isNikonZ(model) else { return unknown }
+                return [0: "JPEG 基本", 1: "JPEG 基本 ★", 2: "JPEG 标准", 3: "JPEG 标准 ★",
+                    4: "JPEG 精细", 5: "JPEG 精细 ★", 6: "TIFF", 7: "NEF（RAW）",
+                    8: "RAW + JPEG 基本", 9: "RAW + JPEG 基本 ★", 10: "RAW + JPEG 标准",
+                    11: "RAW + JPEG 标准 ★", 12: "RAW + JPEG 精细", 13: "RAW + JPEG 精细 ★"][value] ?? unknown
+            case 0xd016:
+                return [0: "无损压缩", 1: "有损压缩", 3: "高效率 ★", 4: "高效率"][value] ?? unknown
+            case 0xd149: return [0: "12 位", 1: "14 位"][value] ?? unknown
+            case 0xd032: return [0: "sRGB · 标准色彩空间", 1: "Adobe RGB · 广色域"][value] ?? unknown
+            case 0xd01f: return value >= 0 && value <= 5 ? "d-\(value + 1) · 机身预设" : unknown
+            case 0xd054, 0xd16a, 0xd0c0: return [0: "关闭", 1: "开启"][value] ?? unknown
+            case 0xd0c1:
+                return [0: "1/3 档", 1: "1/2 档", 2: "2/3 档", 3: "1 档", 4: "2 档", 5: "3 档"][value] ?? unknown
+            case 0xd0c2:
+                return [0: "2 张 · 正常 / 欠曝", 1: "2 张 · 正常 / 过曝", 2: "3 张 · 正常 / 两张欠曝",
+                    3: "3 张 · 正常 / 两张过曝", 4: "3 张 · 欠曝 / 正常 / 过曝", 5: "5 张",
+                    6: "7 张", 7: "9 张", 8: "关闭（0 张）"][value] ?? unknown
+            case 0xd14e:
+                return [0: "自动", 1: "关闭", 2: "低", 3: "标准", 4: "高", 5: "极高"][value] ?? unknown
+            case 0xd200:
+                if let title = pictureControls[value] { return title }
+                if (201...209).contains(value) { return "C-\(value - 200) · 自定义优化校准" }
+                return unknown
+            // Z6 III 的细调打包、ISO 索引及快门类型尚不能用旧机型映射替代。
+            case 0xd017...0xd01d, 0xd183, 0xd164, 0xd20d, 0xd138: return unknown
+            default: return nil
+            }
+        }
+        return nil
+    }
+    private static let pictureControls: [Int64: String] = [
+        1: "标准", 2: "自然", 3: "鲜艳", 4: "单色", 5: "人像", 6: "风景",
+        7: "平面", 8: "自动"
+    ]
+}
