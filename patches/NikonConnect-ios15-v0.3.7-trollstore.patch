+    func scan() {
+        guard !isScanning else { return }
+        nearby = []; status = "正在同时搜索蓝牙与当前 Wi-Fi 网络，不需要选择品牌…"; isScanning = true; scanID = UUID()
+        let id = scanID
+        #if TROLLSTORE
+        TrollStoreWiFi.shared.startDiscovery()
+        #endif
+        CameraNetworkDiscovery.shared.start(saved:saved,onFound:{ [weak self] item in self?.merge(item) },onStatus:{ [weak self] value in self?.networkStatus = value })
+        Task {
+            try? await Task.sleep(nanoseconds:35_000_000_000)
+            guard scanID == id, isScanning else { return }; stopScan()
+            status = nearby.isEmpty ? "未发现可识别相机。请开启相机配对或加入相机 Wi-Fi 后重新搜索。" : "发现 \(nearby.count) 个连接入口，请选择连接。"
+        }
+        manager()
+        if central.state == .poweredOn { startScan() }
+        else if central.state == .poweredOff || central.state == .unauthorized || central.state == .unsupported { unavailable() }
+    }
+    private func startScan() {
+        guard isScanning, central.state == .poweredOn else { return }
+        bluetoothStatus = "正在搜索低功耗蓝牙广播…"
+        central.scanForPeripherals(withServices:nil,options:[CBCentralManagerScanOptionAllowDuplicatesKey:true])
+    }
+    func stopScan() {
+        central?.stopScan(); CameraNetworkDiscovery.shared.stop(); isScanning = false; scanID = nil
+        status = "搜索已停止，已保留发现的连接入口。"
+        if bluetoothStatus.hasPrefix("正在搜索") { bluetoothStatus = "蓝牙搜索已停止。" }
+        if networkStatus.hasPrefix("正在搜索") { networkStatus = "当前网络搜索已停止。" }
+        #if TROLLSTORE
+        TrollStoreWiFi.shared.stopDiscovery()
+        #endif
+    }
+    func noteNetworkConnection(_ message: String) { networkStatus = message }
+    private func unavailable() {
+        central?.stopScan()
+        bluetoothStatus = central.state == .unauthorized ? "蓝牙未获授权，仍会搜索当前网络。可在系统设置允许蓝牙。" : "蓝牙未开启或不可用，仍会搜索当前网络。"
+    }
+    func remember(_ item: NearbyCamera) {
+        var value = item; value.signal = nil
+        saved.removeAll { $0.id == value.id }; saved.insert(value,at:0)
+        if let data = try? JSONEncoder().encode(saved) { UserDefaults.standard.set(data,forKey:"discoveredCameras.v1") }
+    }
+    func centralManagerDidUpdateState(_ central: CBCentralManager) {
+        if central.state == .poweredOn { if isScanning { startScan() } }
+        else if isScanning { unavailable() }
+    }
+    func centralManager(_ central: CBCentralManager, didDiscover peripheral: CBPeripheral, advertisementData: [String:Any], rssi RSSI: NSNumber) {
+        let name = advertisementData[CBAdvertisementDataLocalNameKey] as? String ?? peripheral.name ?? ""
+        let upper = name.uppercased()
+        let services = (advertisementData[CBAdvertisementDataServiceUUIDsKey] as? [CBUUID] ?? []) +
+            (advertisementData[CBAdvertisementDataOverflowServiceUUIDsKey] as? [CBUUID] ?? [])
+        let manufacturer = [UInt8](advertisementData[CBAdvertisementDataManufacturerDataKey] as? Data ?? Data())
+        let brand: NearbyCameraBrand
+        if services.contains(Self.nikonService) || (manufacturer.count >= 2 && manufacturer[0] == 0x99 && manufacturer[1] == 0x03) || upper.contains("NIKON") || upper.hasPrefix("Z6_") || upper.hasPrefix("Z6III") { brand = .nikon }
+        else if services.contains(CBUUID(string:"91F1DE68-DFF6-466E-8B65-FF13B0F16FB8")) || upper.contains("FUJI") || upper.hasPrefix("X-") || upper.hasPrefix("X100") || upper.hasPrefix("GFX") { brand = .fuji }
+        else if upper.contains("SONY") || upper.hasPrefix("ILCE-") || upper.hasPrefix("ILME-") || upper.hasPrefix("ZV-") || upper.hasPrefix("DSC-") { brand = .sony }
+        else if services.contains(CBUUID(string:"00010000-0000-1000-0000-D8492FFFA821")) || upper.contains("CANON") || upper.hasPrefix("EOS") || upper.hasPrefix("POWERSHOT") { brand = .canon }
+        else if services.contains(CBUUID(string:"054AC620-3214-11E6-AC0D-0002A5D5C51B")) || upper.contains("LUMIX") || upper.hasPrefix("DC-") || upper.hasPrefix("DMC-") { brand = .panasonic }
+        else if services.contains(CBUUID(string:"F37F568F-9071-445D-A938-5441F2E82399")) || upper.contains("RICOH") || upper.hasPrefix("GR_") || upper.hasPrefix("GR III") || upper.hasPrefix("GR IV") { brand = .ricoh }
+        else if upper.contains("PENTAX") || upper.hasPrefix("K-3") { brand = .pentax }
+        else if upper.contains("OLYMPUS") || upper.contains("OM SYSTEM") || upper.hasPrefix("OM-1") || upper.hasPrefix("OM-3") || upper.hasPrefix("OM-5") { brand = .olympus }
+        else if upper.contains("LEICA") { brand = .leica }
+        else if upper.contains("HASSELBLAD") || upper.hasPrefix("X2D") || upper.hasPrefix("CFV 100") { brand = .hasselblad }
+        else { return }
+        if brand == .fuji { FujiBluetoothController.shared.rememberDiscovery(peripheral.identifier,manufacturer:Data(manufacturer)) }
+        devices[peripheral.identifier] = peripheral
+        let item = NearbyCamera(id:peripheral.identifier,name:name.isEmpty ? "\(brand.title)相机" : name,brand:brand,signal:RSSI.intValue == 127 ? nil : RSSI.intValue)
+        merge(item)
+    }
+    private func merge(_ item:NearbyCamera) {
+        guard isScanning else { return }
+        if let index = nearby.firstIndex(where: { $0.id == item.id }) { nearby[index] = item } else { nearby.append(item) }
+        nearby.sort { ($0.signal ?? -127) > ($1.signal ?? -127) }
+    }
+    func activateNikon(_ identifier: String) async throws {
+        guard !authenticating else { throw failure("已有尼康蓝牙连接正在进行，请先完成或停止。") }
+        guard let id = UUID(uuidString:identifier) else { throw failure("保存的相机蓝牙身份无效，请重新搜索。") }
+        authenticating = true; defer { authenticating = false }
+        stopScan(); manager()
+        try await wait(seconds:5) { self.central.state == .poweredOn }
+        do {
+            if readyNikonID != id || peer?.state != .connected {
+                disconnectNikon()
+                guard let device = devices[id] ?? central.retrievePeripherals(withIdentifiers:[id]).first else {
+                    throw failure("暂时找不到已选相机，请重新搜索并选择。")
+                }
+                peer = device; device.delegate = self; linkError = nil
+                nikonStatus = "正在连接尼康蓝牙，请留意机身与手机的配对确认…"
+                central.connect(device)
+                try await wait(seconds:25) { self.chars[Self.authentication] != nil && self.chars[Self.wifiStart] != nil }
+                guard let auth = chars[Self.authentication], auth.properties.contains(.indicate) || auth.properties.contains(.notify) else {
+                    throw failure("相机未开放当前认证通知接口。")
+                }
+                device.setNotifyValue(true,for:auth)
+                try await wait(seconds:10) { auth.isNotifying }
+                if let control = chars[Self.controlStatus], control.properties.contains(.notify) || control.properties.contains(.indicate) {
+                    device.setNotifyValue(true,for:control)
+                    try await wait(seconds:10) { control.isNotifying }
+                }
+                authMessages = []
+                let identity = try clientIdentity(for:id)
+                let stage1 = Data([1]) + (try NikonBluetoothAuthentication.randomBytes(8)) + identity
+                nikonStatus = "正在校验尼康蓝牙认证…"
+                try await write(Self.authentication,data:stage1)
+                let stage2 = try await authenticationMessage(stage:2)
+                let stage3 = try NikonBluetoothAuthentication.response(stage1:stage1,stage2:stage2)
+                try await write(Self.authentication,data:stage3)
+                _ = try await authenticationMessage(stage:4)
+                if chars[Self.clientName]?.properties.contains(.write) == true {
+                    let name = Data("CameraConnect iOS".utf8)
+                    try await write(Self.clientName,data:name + Data(repeating:0,count:32-name.count))
+                }
+                readyNikonID = id
+            }
+            try Task.checkCancellation()
+            // 公开 LSS 实现中，2005 的单字节 01 请求开启 Wi-Fi；不能把写入确认当成热点已就绪。
+            nikonStatus = "蓝牙认证已通过，正在请求开启相机 Wi-Fi…"
+            try await write(Self.wifiStart,data:Data([1]))
+            selectedNikonIdentifier = id.uuidString
+            nikonStatus = "已发送开启 Wi-Fi 请求，后续仍需加入网络并完成相机握手。"
+            try await Task.sleep(nanoseconds:1_500_000_000)
+        } catch {
+            nikonStatus = "尼康蓝牙启动未完成：\(error.localizedDescription)"; disconnectNikon(); throw error
+        }
+    }
+    func centralManager(_ central: CBCentralManager, didConnect peripheral: CBPeripheral) {
+        guard peripheral === peer else { return }; peripheral.discoverServices([Self.nikonService])
+    }
+    func centralManager(_ central: CBCentralManager, didFailToConnect peripheral: CBPeripheral, error: Error?) {
+        guard peripheral === peer else { return }; linkError = "蓝牙连接失败，请确认相机处于可发现状态。"
+    }
+    func centralManager(_ central: CBCentralManager, didDisconnectPeripheral peripheral: CBPeripheral, error: Error?) {
+        guard peripheral === peer else { return }; readyNikonID = nil; linkError = "相机蓝牙已断开，请重新选择。"; failWrites()
+    }
+    func peripheral(_ peripheral: CBPeripheral, didDiscoverServices error: Error?) {
+        guard peripheral === peer else { return }
+        guard error == nil, let services = peripheral.services, !services.isEmpty else { linkError = "当前相机未开放尼康智能设备蓝牙服务。"; return }
+        for service in services { peripheral.discoverCharacteristics(nil,for:service) }
+    }
+    func peripheral(_ peripheral: CBPeripheral, didDiscoverCharacteristicsFor service: CBService, error: Error?) {
+        guard peripheral === peer else { return }
+        if error != nil { linkError = "读取相机蓝牙接口失败。"; return }
+        for characteristic in service.characteristics ?? [] { chars[characteristic.uuid] = characteristic }
+        if chars[Self.authentication] == nil || chars[Self.wifiStart] == nil { linkError = "此机型没有开放已实现的尼康认证或热点启动接口。" }
+    }
+    func peripheral(_ peripheral: CBPeripheral, didUpdateNotificationStateFor characteristic: CBCharacteristic, error: Error?) {
+        guard peripheral === peer else { return }; if error != nil { linkError = "相机拒绝蓝牙通知订阅。" }
+    }
+    func peripheral(_ peripheral: CBPeripheral, didUpdateValueFor characteristic: CBCharacteristic, error: Error?) {
+        guard peripheral === peer, characteristic.uuid == Self.authentication else { return }
+        if error != nil { linkError = "读取相机认证回复失败。"; return }
+        if let data = characteristic.value { authMessages.append(data); if authMessages.count > 8 { authMessages.removeFirst() } }
+    }
+    func peripheral(_ peripheral: CBPeripheral, didWriteValueFor characteristic: CBCharacteristic, error: Error?) {
+        guard peripheral === peer, let pending = writes.removeValue(forKey:characteristic.uuid) else { return }
+        if error != nil { pending.1.resume(throwing:failure("相机拒绝蓝牙写入（\(characteristic.uuid.uuidString)）。")) }
+        else { pending.1.resume() }
+    }
+    private func authenticationMessage(stage: UInt8) async throws -> Data {
+        try await wait(seconds:20) { !self.authMessages.isEmpty }
+        let data = authMessages.removeFirst()
+        guard data.count == 17, data.first == stage else { throw failure("尼康蓝牙认证阶段不符，未继续发送。") }
+        return data
+    }
+    private func wait(seconds: TimeInterval, until ready: () -> Bool) async throws {
+        let deadline = ProcessInfo.processInfo.systemUptime + seconds
+        while !ready() {
+            try Task.checkCancellation()
+            if let linkError { throw failure(linkError) }
+            guard ProcessInfo.processInfo.systemUptime < deadline else { throw failure("蓝牙操作超时。请在机身开启蓝牙或进入配对界面；此机型可能需要尚未接入的额外配对流程。") }
+            try await Task.sleep(nanoseconds:100_000_000)
+        }
+        try Task.checkCancellation()
+    }
+    private func write(_ key: CBUUID, data: Data) async throws {
+        try Task.checkCancellation()
+        guard let peer, peer.state == .connected, let characteristic = chars[key], characteristic.properties.contains(.write), writes[key] == nil else {
+            throw failure("当前相机未开放所需的蓝牙写入接口。")
+        }
+        let token = UUID()
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void,Error>) in
+            writes[key] = (token,continuation); peer.writeValue(data,for:characteristic,type:.withResponse)
+            Task {
+                try? await Task.sleep(nanoseconds:15_000_000_000)
+                guard writes[key]?.0 == token else { return }
+                writes.removeValue(forKey:key)?.1.resume(throwing:failure("蓝牙写入超时。"))
+            }
+        }
+        try Task.checkCancellation()
+    }
+    func disconnectNikon() {
+        if let peer { central?.cancelPeripheralConnection(peer) }
+        peer = nil; chars = [:]; readyNikonID = nil; linkError = nil; authMessages = []; selectedNikonIdentifier = nil; failWrites()
+    }
+    private func failWrites() { let pending = writes; writes = [:]; for item in pending.values { item.1.resume(throwing:CancellationError()) } }
+    private func clientIdentity(for id: UUID) throws -> Data {
+        let query: [String:Any] = [kSecClass as String:kSecClassGenericPassword,kSecAttrService as String:"CameraConnect.NikonLSS.v1",kSecAttrAccount as String:id.uuidString]
+        var read = query; read[kSecReturnData as String] = true; read[kSecMatchLimit as String] = kSecMatchLimitOne
+        var found: CFTypeRef?
+        let code = SecItemCopyMatching(read as CFDictionary,&found)
+        if code == errSecSuccess, let data = found as? Data, data.count == 8 { return data }
+        guard code == errSecItemNotFound else { throw failure("保存的尼康认证身份无法读取，已停止以避免重复配对。") }
+        var bytes = try NikonBluetoothAuthentication.randomBytes(8); bytes[0] = 1
+        var add = query; add[kSecValueData as String] = bytes; add[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+        guard SecItemAdd(add as CFDictionary,nil) == errSecSuccess else { throw failure("无法安全保存尼康蓝牙身份。") }
+        return bytes
+    }
+    private func failure(_ text: String) -> CameraAppError { .unsupportedOperation(text) }
+}
diff --git a/Services/NikonBluetoothAuthentication.swift b/Services/NikonBluetoothAuthentication.swift
new file mode 100644
index 0000000..d6b979f
--- /dev/null
+++ b/Services/NikonBluetoothAuthentication.swift
@@ -0,0 +1,53 @@
+import Foundation
+import CommonCrypto
+import Security
+
+// 按 birdcam（MIT）的 LSS 报文、盐值和 entangle 定义独立实现。
+// 仅处理认证与热点启动，不包含官方二进制库，也不解密尚未确认的连接配置。
+enum NikonBluetoothAuthentication {
+    static func randomBytes(_ count: Int) throws -> Data {
+        var bytes = [UInt8](repeating:0,count:count)
+        guard SecRandomCopyBytes(kSecRandomDefault,count,&bytes) == errSecSuccess else {
+            throw CameraAppError.unsupportedOperation("无法生成蓝牙认证随机数。")
+        }
+        return Data(bytes)
+    }
+    static func response(stage1: Data, stage2: Data) throws -> Data {
+        guard stage1.count == 17, stage1[0] == 1, stage2.count == 17, stage2[0] == 2 else {
+            throw CameraAppError.unsupportedOperation("尼康蓝牙认证报文格式尚不支持，已停止。")
+        }
+        let client = Data(stage1[1..<9]), camera = Data(stage2[1..<9]), challenge = Data(stage2[9..<17])
+        let salts: [UInt64] = [0x52D53304E4664070,0x7BE4F715AC8F4BED,0xFCA15E8B111F4724,0x417F8C2B310C9605,
+            0xF3B1A8EBC188A5FD,0x50D5D31B56601699,0x308AE2A97F6832CD,0xF4EBC7DE34E88F2A]
+        for salt in salts {
+            var little = salt.littleEndian
+            let saltBytes = withUnsafeBytes(of:&little) { Data($0) }
+            if try hash(saltBytes + camera + client) == challenge {
+                return Data([3]) + client + (try hash(saltBytes + client + camera))
+            }
+        }
+        throw CameraAppError.unsupportedOperation("尼康蓝牙认证校验未通过；当前机型或固件的认证方式尚未确认。")
+    }
+    private static func hash(_ data: Data) throws -> Data {
+        let key: [UInt8] = [0xff,0xff,0xaa,0x55,0x11,0x22,0x33,0x00]
+        var state: [UInt8] = [1,2,3,4,5,6,7,8]
+        let bytes = [UInt8](data)
+        for offset in stride(from:0,to:bytes.count,by:8) {
+            let block = (0..<8).map { bytes[offset+$0] ^ state[$0] }
+            var output = [UInt8](repeating:0,count:8), written = 0
+            let code = key.withUnsafeBytes { keyBytes in
+                block.withUnsafeBytes { input in
+                    output.withUnsafeMutableBytes { buffer in
+                        CCCrypt(CCOperation(kCCEncrypt),CCAlgorithm(kCCAlgorithmBlowfish),CCOptions(kCCOptionECBMode),
+                            keyBytes.baseAddress,key.count,nil,input.baseAddress,8,buffer.baseAddress,8,&written)
+                    }
+                }
+            }
+            guard code == kCCSuccess, written == 8 else {
+                throw CameraAppError.unsupportedOperation("蓝牙认证计算失败，已停止。")
+            }
+            state = output
+        }
+        return Data(state)
+    }
+}
