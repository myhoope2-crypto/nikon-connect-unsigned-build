+            Task { try? await Task.sleep(nanoseconds:20_000_000_000); if reads[key]?.0 == id { reads.removeValue(forKey:key)?.1.resume(throwing:error("读取相机网络信息超时。")) } }
+        }
+        try Task.checkCancellation(); return result
+    }
+    private func write(_ key:CBUUID,_ data:Data) async throws {
+        try Task.checkCancellation()
+        guard let peer,let characteristic = characteristics[key],characteristic.properties.contains(.write),writes[key] == nil else { throw error("所需蓝牙写入接口不可用。") }
+        let id = UUID()
+        try await withCheckedThrowingContinuation { (continuation:CheckedContinuation<Void,Error>) in
+            writes[key] = (id,continuation); peer.writeValue(data,for:characteristic,type:.withResponse)
+            Task { try? await Task.sleep(nanoseconds:15_000_000_000); if writes[key]?.0 == id { writes.removeValue(forKey:key)?.1.resume(throwing:error("相机未及时确认网络启动指令。")) } }
+        }
+        try Task.checkCancellation()
+    }
+    private func subscribe(_ key:CBUUID) async throws {
+        guard let peer,let characteristic = characteristics[key],characteristic.properties.contains(.notify) || characteristic.properties.contains(.indicate) else { throw error("相机没有开放必要通知接口。") }
+        peer.setNotifyValue(true,for:characteristic); try await wait(10) { characteristic.isNotifying }
+    }
+    private func notification(_ key:CBUUID,seconds:TimeInterval) async throws -> Data {
+        try await wait(seconds) { !(self.notices[key] ?? []).isEmpty }; return notices[key]!.removeFirst()
+    }
+    private func wait(_ seconds:TimeInterval,until ready:()->Bool) async throws {
+        let deadline = ProcessInfo.processInfo.systemUptime + seconds
+        while !ready() {
+            try Task.checkCancellation(); if let failureText { throw error(failureText) }
+            guard ProcessInfo.processInfo.systemUptime < deadline else { throw error("蓝牙配对或网络操作超时，此机型可能使用不同的认证流程。") }
+            try await Task.sleep(nanoseconds:100_000_000)
