+struct LiveViewAssistanceControls: View {
+    @ObservedObject var model: CameraRemoteViewModel
+    @AppStorage("liveGrid.v1") private var grid = false
+    @AppStorage("liveFrameGuide.v1") private var guide = "off"
+    @AppStorage("liveHistogram.v1") private var histogram = false
+    @AppStorage("liveZebra.v1") private var zebra = false
+    @AppStorage("liveZebraThreshold.v1") private var threshold = 245
+    var body: some View {
+        DisclosureGroup("取景辅助") {
+            VStack(alignment:.leading,spacing:12) {
+                Toggle("九宫格",isOn:$grid)
+                Picker("画幅参考线",selection:$guide) {
+                    Text("关闭").tag("off"); Text("3:2").tag("3:2"); Text("16:9").tag("16:9"); Text("1:1").tag("1:1")
+                }.pickerStyle(.segmented)
+                Toggle("亮度直方图",isOn:$histogram)
+                Toggle("过曝斑马纹",isOn:$zebra)
+                if zebra { Stepper("提示阈值：\(threshold)/255",value:$threshold,in:220...255) }
+                if histogram {
+                    GeometryReader { geometry in
+                        Path { path in
+                            let bins = model.liveHistogram
+                            guard !bins.isEmpty else { return }
+                            let step = geometry.size.width/CGFloat(bins.count)
+                            for (i,value) in bins.enumerated() {
+                                let height = CGFloat(value)*geometry.size.height
+                                path.addRect(CGRect(x:CGFloat(i)*step,y:geometry.size.height-height,width:max(1,step-1),height:height))
+                            }
+                        }.fill(AppTheme.accentStrong)
+                    }.frame(height:60).padding(8).background(AppTheme.surfaceMuted,in:RoundedRectangle(cornerRadius:8))
+                }
+                Text("分析的是低分辨率取景图，约每半秒更新。斑马纹提示任一颜色通道接近阈值，不代表 RAW 已过曝；画幅参考线只辅助构图，不改变机身记录画幅。")
+                    .font(.caption).foregroundColor(AppTheme.inkMuted)
+            }.padding(.top,10)
+        }.padding(12).background(AppTheme.surface,in:RoundedRectangle(cornerRadius:12))
+    }
+}
