+// 按连接品牌解码，再按机身型号选择目录。描述中的值、顺序、读写权限始终来自相机。
+enum CameraSettingGroup: String, CaseIterable, Identifiable, Sendable {
+    case core
+    case focus
+    case shooting
+    case quality
+    case whiteBalance
+    case fuji
+    case nikon
+    var id: String { rawValue }
+    var title: String {
+        switch self {
+        case .core: return "常用曝光"
+        case .focus: return "对焦与识别"
+        case .shooting: return "拍摄方式"
+        case .quality: return "文件与画质"
+        case .whiteBalance: return "白平衡细调"
+        case .fuji: return "富士成像设置"
+        case .nikon: return "尼康成像设置"
+        }
+    }
+}
+
+struct CameraSettingDefinition: Identifiable, Sendable {
+    let kind: CameraParameterKind
+    let title: String
+    let group: CameraSettingGroup
+    let codes: [UInt16]
+    var help: String = ""
+    var limitation: String? = nil
+    var id: String { kind.rawValue }
+}
+
+enum CameraSettingCatalog {
+    static func compact(_ model: String) -> String {
+        model.uppercased().filter { $0.isASCII && $0.isLetter || $0.isNumber }
+    }
+    static func priorityModel(_ model: String, profile: CameraParameterDecoder.Profile) -> Bool {
+        let name = compact(model)
+        return profile == .fuji ? name.contains("XT30III") :
+            profile == .nikon && (name.contains("Z6III") || name.hasSuffix("Z63"))
+    }
+    static func isNikonZ(_ model: String) -> Bool {
+        compact(model).replacingOccurrences(of: "NIKON", with: "").hasPrefix("Z")
+    }
+    static func profile(for session: CameraSession?) -> CameraParameterDecoder.Profile {
+        guard let session else { return .standard }
+        if session.persistentIdentity.hasPrefix("fuji|") { return .fuji }
+        if session.persistentIdentity.hasPrefix("nikon|") { return .nikon }
+        return .standard
+    }
+    static func definitions(profile: CameraParameterDecoder.Profile) -> [CameraSettingDefinition] {
+        switch profile {
+        case .standard: return standard
+        case .fuji: return fuji
+        case .nikon: return nikon
+        }
+    }
+    static func definition(code: UInt16, profile: CameraParameterDecoder.Profile) -> CameraSettingDefinition? {
+        definitions(profile: profile).first { $0.codes.contains(code) }
+    }
+    static func visible(profile: CameraParameterDecoder.Profile, model: String, parameters: [CameraParameter]) -> [CameraSettingDefinition] {
+        let all = definitions(profile: profile)
+        if priorityModel(model, profile: profile) { return all }
+        // 未逐机验证的其他型号，只显示实际报告的设置以及常用曝光，不套用目标机型整套菜单。
