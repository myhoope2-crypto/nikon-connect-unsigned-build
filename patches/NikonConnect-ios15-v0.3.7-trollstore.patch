+                    throw error("此松下机型的蓝牙接口与已实现的 S5 代协议不同，请使用原生 Wi-Fi 连接。")
+                }
+                for key in [Self.pana("4CF487C0-32A7-11E6-A50D"),Self.pana("37701B80-32A7-11E6-BB83"),Self.pana("18345BE1-3217-11E6-B56C"),Self.pana("48669DA0-3217-11E6-B08D"),Self.pana("E182EC43-3213-11E6-AB07"),Self.pana("E182EC41-3213-11E6-AB07"),Self.pana("E182EC42-3213-11E6-AB07")] {
