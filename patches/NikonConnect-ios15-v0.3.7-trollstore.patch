+++ b/Features/ConnectionSetup/CameraRemoteViewModel.swift
@@ -0,0 +1,620 @@
+import Foundation
+import SwiftUI
+import UIKit
+import Combine
+
+@MainActor
+final class CameraRemoteViewModel: ObservableObject {
+    @Published var liveFrame: Data?
+    @Published var isLive = false
+    @Published var isStoppingLive = false
+    @Published var isWatching = false
+    @Published var isBusy = false
+    @Published var isRecovering = false
+    @Published var parameters: [CameraParameter] = []
+    @Published var parametersLoaded = false
+    @Published var parameterStatus = "进入实时取景后自动读取相机参数。"
+    @Published var parameterUpdatedAt: Date?
+    @Published var liveAlert: AlertContext?
+    @Published var focusCapabilities = CameraFocusCapabilities()
+    @Published var focusMarker: CameraFocusPoint?
+    @Published var focusStatus = "进入取景后读取遥控对焦能力。"
+    @Published var isScheduling = false
+    @Published var scheduleStatus = "设置倒计时、间隔和张数；仅在应用前台执行。"
+    @Published var scheduleCompleted = 0
+    @Published var presetStatus = "预设按机型保存，应用前重新读取机身允许值。"
+    @Published var liveHistogram: [Double] = []
+    @Published var zebraFrame: Data?
+    private let frameAnalyzer = LiveFrameAnalyzer()
+    private var scheduleTask: Task<Void, Never>?
+    private var scheduleID: UUID?
+    private var watchKnownFingerprints: Set<String>?
+    private var watchBaselineIdentity: String?
+    private var needsFullParameterRefresh = false
+    var cameraModel: String { connection.activeSession?.cameraName ?? "未连接相机" }
+    var cameraProfile: CameraParameterDecoder.Profile { CameraSettingCatalog.profile(for: connection.activeSession) }
+    var settingDefinitions: [CameraSettingDefinition] {
+        CameraSettingCatalog.visible(profile: cameraProfile, model: cameraModel, parameters: parameters)
+    }
+
+    var livePageIsPresented = false
+    private var frameInFlight = false
+    private var controlInFlight = false
+    private var autoParameterRefresh = true
+    @Published var status = "连接相机后可查看可用功能。"
+    private let connection: ConnectionViewModel
+    private let gallery: GalleryViewModel
+    private let downloads: DownloadManagerViewModel
+    private let shell: AppShellViewModel
+    private var liveTask: Task<Void, Never>?
+    private var watchTask: Task<Void, Never>?
+    private var healthTask: Task<Void, Never>?
+    private var monitorID: UUID?
+    private var foreground = true
+    private var wantsLive = false
+    private var wantsWatch = false
+    #if TROLLSTORE
+    private var backgroundPermissionSubscription: AnyCancellable?
+    #endif
+    private var canWatchInBackground: Bool {
+        #if TROLLSTORE
+        return TrollStoreBackgroundExecution.shared.isGranted
+        #else
+        return false
+        #endif
+    }
+
+    init(connection: ConnectionViewModel, gallery: GalleryViewModel, downloads: DownloadManagerViewModel, shell: AppShellViewModel) {
+        self.connection = connection; self.gallery = gallery; self.downloads = downloads; self.shell = shell
+        #if TROLLSTORE
+        backgroundPermissionSubscription = TrollStoreBackgroundExecution.shared.$isGranted
+            .removeDuplicates().sink { [weak self] granted in
+                Task { @MainActor in
+                    guard let self, !granted, !self.foreground, self.wantsWatch else { return }
+                    self.stopWatching()
+                    self.status = "系统后台运行不可用，边拍边传监测已暂停；回到前台可恢复并补传。"
+                    self.shell.appendLog(self.status)
+                }
+            }
+        #endif
+    }
+    private var remote: (any CameraRemoteControlling)? { connection.sessionCoordinator.activeTransport as? any CameraRemoteControlling }
+    func supports(_ capability: CameraCapability) -> Bool { connection.activeSession?.capabilities.contains(capability) == true }
+
+    func startLive() {
+        guard foreground, !isBusy, !controlInFlight, !isScheduling, liveTask == nil, supports(.liveView), let remote, let sessionID = connection.activeSession?.id else { return }
+        guard !downloads.isDownloading, !gallery.isLoading else {
+            status = "请等待照片读取结束，并暂停下载后再开始取景。"; return
+        }
+        guard let lease = connection.sessionCoordinator.acquireCameraUse("实时取景") else {
+            status = "相机正在执行其他操作，请稍后开始取景。"; return
+        }
+        stopWatching(); isBusy = true; wantsLive = true; isStoppingLive = false
+        liveTask = Task { [weak self] in
+            guard let self else { return }
+            defer { self.connection.sessionCoordinator.releaseCameraUse(lease) }
+            await self.watchTask?.value
+            do {
+                guard self.connection.activeSession?.id == sessionID, self.wantsLive else { throw CancellationError() }
+                try await remote.startLiveView()
+                guard self.connection.activeSession?.id == sessionID, self.wantsLive else { throw CancellationError() }
+                self.isLive = true; self.status = "实时取景中（实验）。"
+                self.autoParameterRefresh = true
+                self.focusStatus = "进入取景后读取遥控对焦能力。"
+                self.focusMarker = nil
+                await self.readParameters(remote, sessionID: sessionID, reportErrors: false)
+                if self.connection.activeSession?.id == sessionID { self.isBusy = false }
+                var lastParameterRead = Date()
+                var lastAnalysis = Date.distantPast
+                var unavailableFrames = 0
+                while self.wantsLive && self.connection.activeSession?.id == sessionID {
+                    // 参数读写在完整帧之间进行；不取消正在接收的帧，不截断 TCP 数据包。
+                    if self.isBusy { try await Task.sleep(nanoseconds: 30_000_000); continue }
+                    if self.autoParameterRefresh && Date().timeIntervalSince(lastParameterRead) >= 3 {
+                        self.isBusy = true
+                        await self.readParameters(remote, sessionID: sessionID, reportErrors: false, full: self.needsFullParameterRefresh)
+                        self.needsFullParameterRefresh = false
+                        self.focusCapabilities = await remote.focusCapabilities()
+                        if self.connection.activeSession?.id == sessionID { self.isBusy = false }
+                        lastParameterRead = Date()
+                        continue
+                    }
+                    do {
+                        self.frameInFlight = true
+                        defer { self.frameInFlight = false }
+                        let data = try await remote.liveViewFrame()
+                        guard self.connection.activeSession?.id == sessionID else { break }
+                        self.liveFrame = data; unavailableFrames = 0
+                        let histogram = UserDefaults.standard.bool(forKey:"liveHistogram.v1")
+                        let zebra = UserDefaults.standard.bool(forKey:"liveZebra.v1")
+                        if (histogram || zebra), Date().timeIntervalSince(lastAnalysis) >= 0.5 {
+                            let threshold = UserDefaults.standard.object(forKey:"liveZebraThreshold.v1") as? Int ?? 245
+                            let analysis = await self.frameAnalyzer.analyze(data, threshold:UInt8(clamping:threshold), includeZebra:zebra)
+                            if self.connection.activeSession?.id == sessionID {
+                                self.liveHistogram = analysis?.histogram ?? []; self.zebraFrame = analysis?.zebraPNG
+                            }
+                            lastAnalysis = Date()
+                        }
+                        if self.focusStatus == "进入取景后读取遥控对焦能力。" {
+                            self.focusCapabilities = await remote.focusCapabilities()
+                            self.focusStatus = self.focusCapabilities.reason
+                        }
+                    } catch let error as PTPIPError {
+                        if case .unexpectedResponse(let code) = error, code == 0x2019, unavailableFrames < 8 { unavailableFrames += 1 }
+                        else { throw error }
+                    }
+                    try await Task.sleep(nanoseconds: 120_000_000)
+                }
+            } catch is CancellationError {}
+            catch {
+                if self.connection.activeSession?.id == sessionID {
+                    self.status = "取景已停止：\(self.shell.userFacingMessage(for: error))"; self.shell.appendLog(self.status)
+                }
+            }
+            // 离开页面或点停止时，先等待已经发出的参数事务完整收尾。
+            while self.controlInFlight { try? await Task.sleep(nanoseconds: 20_000_000) }
+            await remote.stopLiveView()
+            self.isLive = false; self.liveFrame = nil; self.liveTask = nil; self.wantsLive = false
