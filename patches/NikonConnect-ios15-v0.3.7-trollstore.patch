diff --git a/Features/PhotoBrowser/PhotoCompareView.swift b/Features/PhotoBrowser/PhotoCompareView.swift
new file mode 100644
index 0000000..3badea4
--- /dev/null
+++ b/Features/PhotoBrowser/PhotoCompareView.swift
@@ -0,0 +1,82 @@
+import SwiftUI
+import UIKit
+
+struct PhotoCompareView: View {
+    let assets: [PhotoAsset]
+    let loadPreview: (PhotoAsset) async -> Data?
+    let isStarred: (PhotoAsset) -> Bool
+    let toggleStar: (PhotoAsset) -> Void
+    @State private var images: [UUID:UIImage] = [:]
+    @State private var finished = false
+    @State private var zoom: CGFloat = 1
+    @State private var pan = CGSize.zero
+    @State private var horizontal = false
+    @Environment(\.dismiss) private var dismiss
+    var body: some View {
+        NavigationView {
+            VStack(spacing:12) {
+                Toggle("左右排列",isOn:$horizontal).padding(.horizontal)
+                if horizontal { HStack(spacing:4) { panels } } else { VStack(spacing:4) { panels } }
+                HStack {
+                    Text(String(format:"%.1f×",Double(zoom))).monospacedDigit()
+                    Slider(value:$zoom,in:1...12)
+                    Button("复位") { zoom = 1; pan = .zero }
+                }.padding(.horizontal)
+                Text("两张预览同步缩放和移动，双击复位。预览分辨率可能低于原片，不能据此保证原片像素级清晰度。")
+                    .font(.caption).foregroundColor(AppTheme.inkMuted).padding(.horizontal).padding(.bottom,8)
+            }.foregroundColor(AppTheme.ink).background(AppTheme.canvas.ignoresSafeArea())
+                .navigationTitle("双图对比挑片").navigationBarTitleDisplayMode(.inline)
+                .toolbar { ToolbarItem(placement:.navigationBarTrailing) { Button("完成") { dismiss() } } }
+                .task {
+                    for asset in assets.prefix(2) {
+                        if let data = await loadPreview(asset), let image = UIImage(data:data) { images[asset.id] = image }
+                    }
+                    finished = true
+                }
+        }.navigationViewStyle(.stack).tint(AppTheme.accentStrong)
+    }
+    @ViewBuilder private var panels: some View {
+        ForEach(Array(assets.prefix(2))) { asset in
+            VStack(spacing:4) {
+                HStack {
+                    Text(asset.fileName).font(.caption).lineLimit(1)
+                    Spacer()
+                    Button { toggleStar(asset) } label: { Image(systemName:isStarred(asset) ? "star.fill" : "star") }.foregroundColor(AppTheme.accentStrong)
+                }.padding(.horizontal,8)
+                CompareImagePanel(image:images[asset.id], finished:finished, zoom:$zoom, pan:$pan)
+            }.frame(maxWidth:.infinity,maxHeight:.infinity)
+        }
+    }
+}
+
+private struct CompareImagePanel: View {
+    let image: UIImage?
+    let finished: Bool
+    @Binding var zoom: CGFloat
+    @Binding var pan: CGSize
+    @State private var startZoom: CGFloat?
+    @State private var startPan: CGSize?
+    var body: some View {
+        GeometryReader { geometry in
+            ZStack {
+                Color.black
+                if let image {
+                    Image(uiImage:image).resizable().scaledToFit()
+                        .scaleEffect(zoom).offset(x:pan.width*geometry.size.width,y:pan.height*geometry.size.height)
+                } else if finished { Text("无法读取该文件的预览").font(.caption).foregroundColor(.white) }
+                else { ProgressView().tint(.white) }
+            }.clipped().contentShape(Rectangle())
+                .gesture(MagnificationGesture().onChanged { value in
+                    if startZoom == nil { startZoom = zoom }
+                    zoom = min(12,max(1,(startZoom ?? 1)*value))
+                }.onEnded { _ in startZoom = nil })
+                .simultaneousGesture(DragGesture().onChanged { value in
+                    if startPan == nil { startPan = pan }
+                    let limit = max(0,(zoom-1)/2)
+                    pan = CGSize(width:min(limit,max(-limit,(startPan?.width ?? 0)+value.translation.width/max(1,geometry.size.width))),
+                                 height:min(limit,max(-limit,(startPan?.height ?? 0)+value.translation.height/max(1,geometry.size.height))))
+                }.onEnded { _ in startPan = nil })
+                .onTapGesture(count:2) { zoom = 1; pan = .zero }
+        }
+    }
+}
