+            case .ricoh:
+                let props = try await http.json("/v1/props")
+                guard let model = props["model"].string,
+                      (props["manufacturer"].string ?? "").uppercased().contains("RICOH") || model.uppercased().contains("PENTAX") else {
+                    throw failure("当前设备不是已识别的理光／宾得无线接口。")
+                }
+                name = model; identity = "ricoh|\(model)|\(deviceIdentity([props["serialNo"].string,props["macAddress"].string]))"
+                stores = props["storages"].array.compactMap { item in
+                    guard let name = item["name"].string, ["in","sd1","sd2"].contains(name) else { return nil }; return name
+                }
+                if stores.isEmpty { stores = [""] }
+            case .olympus:
+                let xml = try CameraXML.parse(await http.data("/get_caminfo.cgi",headers:["User-Agent":"OI.Share v2"]))
+                guard let model = xml.first("model"), !model.isEmpty,
+                      xml.first("version") != nil || xml.first("serial") != nil else { throw failure("相机未返回有效的奥林巴斯／OM 设备信息。") }
+                name = model; identity = "olympus|\(model)|\(deviceIdentity([xml.first("serial")]))"
+            case .panasonic:
+                let content = try CameraHTTPClient(host:config.normalizedHost,port:60606); contentClient = content
+                let xml = try CameraXML.parse(await content.data("/Lumix/Server0/ddd"))
+                guard (xml.first("manufacturer") ?? "").uppercased().contains("PANASONIC") else { throw failure("当前设备未提供松下原生内容目录。") }
+                name = xml.first("friendlyName") ?? xml.first("modelNumber") ?? "LUMIX"
+                identity = "panasonic|\(deviceIdentity([xml.first("UDN"),xml.first("serialNumber")]))"
+                var accessType = "req_acc", accessID = CameraClientIdentity.lumixID, accessName = "CameraConnect"
+                if (xml.first("X_CamCapability") ?? "").hasSuffix("1") {
+                    let challenge = try await http.data("/cam.cgi",query:query(["mode":"accctrl","type":"req_acc_g"]))
+                    let parts = String(decoding:challenge,as:UTF8.self).trimmingCharacters(in:.whitespacesAndNewlines).split(separator:",")
+                    guard parts.count == 2, parts[0] == "ok",let nonce = UInt32(parts[1],radix:16) else {
+                        throw failure("松下未返回已支持的连接认证挑战。")
+                    }
+                    accessType = "req_acc_e"; accessID = lumixAccessValue(accessID,nonce:nonce); accessName = lumixAccessValue(accessName,nonce:nonce)
+                }
+                let deadline = ProcessInfo.processInfo.systemUptime + 45
+                while true {
+                    let data = try await http.data("/cam.cgi",query:query(["mode":"accctrl","type":accessType,"value":accessID,"value2":accessName]))
+                    let value = String(decoding:data,as:UTF8.self).trimmingCharacters(in:.whitespacesAndNewlines)
+                    if value.hasPrefix("ok,") || value == "ok" { break }
+                    guard value.hasPrefix("ok_under_research"), ProcessInfo.processInfo.systemUptime < deadline else {
+                        throw failure("松下未接受当前连接。请在机身确认；此机型可能使用尚未接入的认证版本。")
+                    }
