diff --git a/Services/CameraWiFiCoordinator.swift b/Services/CameraWiFiCoordinator.swift
new file mode 100644
index 0000000..cc67b3f
--- /dev/null
+++ b/Services/CameraWiFiCoordinator.swift
@@ -0,0 +1,191 @@
+import Foundation
+@preconcurrency import NetworkExtension
+import Security
+import UIKit
+
+struct CameraWiFiProfile: Codable, Identifiable, Equatable {
+    var id = UUID()
+    var name: String
+    var ssid: String
+    var mode: CameraTransportMode
+    var openNetwork: Bool
+    var cameraIdentity: String?
+    var bluetoothID: String?
+}
+
+@MainActor
+final class CameraWiFiCoordinator: ObservableObject {
+    static let shared = CameraWiFiCoordinator()
+    @Published private(set) var profiles: [CameraWiFiProfile] = []
+    @Published var status = "首次保存相机网络，之后连接时自动请求加入。"
+    private var preparing = false
+    private var currentNetworkMode:CameraTransportMode?
+    private let key = "cameraWiFiProfiles.v1"
+    private var selected: [String: String] {
+        get { UserDefaults.standard.dictionary(forKey: "selectedCameraWiFi.v1") as? [String:String] ?? [:] }
+        set { UserDefaults.standard.set(newValue, forKey: "selectedCameraWiFi.v1") }
+    }
+    init() {
+        if let data = UserDefaults.standard.data(forKey: key),
+           let saved = try? JSONDecoder().decode([CameraWiFiProfile].self, from: data) { profiles = saved }
+    }
+    var enabled: Bool {
+        get { UserDefaults.standard.object(forKey: "autoJoinCameraWiFi.v1") as? Bool ?? true }
+        set { UserDefaults.standard.set(newValue, forKey: "autoJoinCameraWiFi.v1"); objectWillChange.send() }
+    }
+    func profile(for mode: CameraTransportMode) -> CameraWiFiProfile? {
+        profiles.first { $0.mode == mode && $0.id.uuidString == selected[mode.rawValue] }
+    }
+    func choose(_ profile: CameraWiFiProfile) { currentNetworkMode = nil; selected[profile.mode.rawValue] = profile.id.uuidString; objectWillChange.send() }
+    func useCurrentNetwork(mode:CameraTransportMode) { currentNetworkMode = mode; status = "使用已发现相机所在的当前 Wi-Fi 网络。" }
+    func useBluetoothCamera(mode: CameraTransportMode, identifier: String) {
+        currentNetworkMode = nil
+        if let match = profiles.first(where: { $0.mode == mode && $0.bluetoothID == identifier }) {
+            choose(match)
+        } else {
+            var values = selected; values.removeValue(forKey: mode.rawValue); selected = values
+            objectWillChange.send()
+        }
+    }
+    func savedCredentials(ssid:String) -> (password:String,open:Bool)? {
+        let values = profiles.filter { $0.ssid == ssid }.compactMap { p -> (String,Bool)? in
+            if p.openNetwork { return ("",true) }; guard let pass = secret(p.id) else { return nil }; return (pass,false)
+        }
+        guard let first = values.first,values.allSatisfy({ $0.0 == first.0 && $0.1 == first.1 }) else { return nil }
+        return (first.0,first.1)
+    }
+    func save(name: String, ssid: String, password: String, open: Bool, mode: CameraTransportMode,
+              bluetoothID: String? = nil) throws {
+        guard !ssid.isEmpty, ssid.utf8.count <= 32 else { throw message("Wi-Fi 名称不能为空，且不能超过 32 字节。") }
+        guard open || (8...63).contains(password.utf8.count) ||
+                (password.count == 64 && password.allSatisfy(\.isHexDigit)) else {
+            throw message("加密网络请输入 8–63 字节的 WPA 密码，或 64 位十六进制密钥。")
+        }
+        var item = profiles.first { $0.mode == mode && $0.ssid == ssid } ??
+            CameraWiFiProfile(name: name.isEmpty ? ssid : name, ssid: ssid, mode: mode, openNetwork: open)
+        item.name = name.isEmpty ? ssid : name; item.openNetwork = open
+        item.bluetoothID = bluetoothID ?? (mode == .experimentalNikon ? NearbyCameraDiscovery.shared.selectedNikonIdentifier : nil) ?? item.bluetoothID
+        let old = secret(item.id)
+        if !open && password.isEmpty && old == nil { throw message("该网络尚未保存密码。") }
+        try setSecret(open ? "" : password, id: item.id)
+        if let i = profiles.firstIndex(where: { $0.id == item.id }) { profiles[i] = item }
+        else { profiles.append(item) }
+        choose(item); persist()
+    }
+    func remove(_ item: CameraWiFiProfile) {
+        profiles.removeAll { $0.id == item.id }; SecItemDelete(query(item.id) as CFDictionary)
+        if selected[item.mode.rawValue] == item.id.uuidString { selected.removeValue(forKey: item.mode.rawValue) }
+        // 用户明确删除本应用保存的相机网络时，移除本应用安装的对应系统配置。
+        if !profiles.contains(where: { $0.ssid == item.ssid }) {
+            NEHotspotConfigurationManager.shared.removeConfiguration(forSSID: item.ssid)
+        }
+        persist()
+    }
+    func bind(_ session: CameraSession, mode: CameraTransportMode) throws {
+        guard currentNetworkMode != mode, let p = profile(for: mode), let i = profiles.firstIndex(where: { $0.id == p.id }), enabled else { return }
+        if let identity = p.cameraIdentity, identity != session.persistentIdentity {
+            throw message("当前网络返回了另一台相机，已停止连接。请核对或重新保存对应网络。")
+        }
+        profiles[i].cameraIdentity = session.persistentIdentity; persist()
+    }
+    func prepare(mode: CameraTransportMode, progressID: UUID? = nil) async throws {
+        guard !preparing else { throw message("上一条系统 Wi-Fi 请求尚未结束，请先完成或取消系统提示。") }
+        preparing = true; defer { preparing = false }
+        if currentNetworkMode == mode { status = "使用当前网络，直接校验所选相机。"; return }
+        guard enabled else { status = "自动加入已关闭，使用当前网络。"; return }
+        if mode == .experimentalNikon, let id = profile(for:mode)?.bluetoothID {
+            CameraConnectionProgress.shared.advance(.bluetooth, id: progressID, detail: "通过蓝牙请求开启尼康热点…")
+            status = "正在通过蓝牙请求开启尼康 Wi-Fi…"
+            try await NearbyCameraDiscovery.shared.activateNikon(id)
+        }
+        let fuji = mode == .experimentalFuji || mode == .experimentalFujiLegacy
+        if fuji {
+            let controller = FujiBluetoothController.shared
+            let target = profile(for:mode)
+            if let id = target?.bluetoothID, controller.connectedIdentifier != id {
+                CameraConnectionProgress.shared.advance(.bluetooth, id: progressID, detail: "正在恢复所选富士的蓝牙连接…")
+                status = "正在恢复已配对的富士蓝牙…"
+                try await controller.restoreConnection(id)
+            }
+            if controller.isReady {
+                CameraConnectionProgress.shared.advance(.bluetooth, id: progressID, detail: "读取所选相机的热点配置并请求开启 Wi-Fi…")
+                status = "正在通过蓝牙启动相机 Wi-Fi…"
+                try await controller.readWiFiCredentials(purpose: mode == .experimentalFujiLegacy ? .remoteShooting : .gallery)
+                if let target, target.ssid != controller.ssid {
+                    throw message("已选择的 Wi-Fi 与当前蓝牙相机不对应。请在网络列表选择对应相机，或重新配对后保存它的网络。")
+                }
+                try save(name: controller.ssid, ssid: controller.ssid, password: controller.wifiPassword,
+                         open: controller.wifiPassword.isEmpty, mode: mode, bluetoothID: controller.connectedIdentifier)
+            }
+        }
+        guard let item = profile(for: mode) else {
+            status = "尚未保存相机 Wi-Fi，尝试当前网络；可在相机页保存网络后启用自动加入。"; return
+        }
+        guard UIApplication.shared.applicationState != .background else { throw message("请回到应用前台再加入相机 Wi-Fi。") }
+        let config: NEHotspotConfiguration
+        if item.openNetwork { config = NEHotspotConfiguration(ssid: item.ssid) }
+        else {
+            guard let pass = secret(item.id), !pass.isEmpty else { throw message("Wi-Fi 密码不可用，请重新保存。") }
+            config = NEHotspotConfiguration(ssid: item.ssid, passphrase: pass, isWEP: false)
+        }
+        config.joinOnce = false
+        try await apply(config,name:item.ssid,password:item.openNetwork ? "" : secret(item.id),open:item.openNetwork,progressID:progressID)
+    }
+    func joinNetwork(ssid:String,password:String,open:Bool) async throws {
+        guard !preparing else { throw message("上一条 Wi-Fi 请求尚未完成。") }
+        guard !ssid.isEmpty,ssid.utf8.count <= 32,open || (8...63).contains(password.utf8.count) else { throw message("请输入有效的网络名称和 WPA 密码。") }
+        preparing = true; defer { preparing = false }
+        let config = open ? NEHotspotConfiguration(ssid:ssid) : NEHotspotConfiguration(ssid:ssid,passphrase:password,isWEP:false)
+        config.joinOnce = false; try await apply(config,name:ssid,password:password,open:open)
+    }
+    private func apply(_ config:NEHotspotConfiguration,name:String,password:String?,open:Bool,progressID:UUID? = nil) async throws {
+        #if TROLLSTORE
+        if TrollStoreWiFi.shared.directJoinEnabled {
+            guard let password else { throw message("该网络的密码不可用，请重新保存。") }
+            status = "正在通过巨魔直接加入相机 Wi-Fi…"
+            try await TrollStoreWiFi.shared.join(ssid:name,password:password,open:open,progressID:progressID)
+            status = TrollStoreWiFi.shared.status
+            return
+        }
+        #endif
+        status = "请求加入 \(name)，请确认可能出现的系统提示…"
+        CameraConnectionProgress.shared.advance(.joining, id: progressID, detail: "请求系统加入相机 Wi-Fi，请完成可能出现的确认。")
+        try Task.checkCancellation()
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, Error>) in
+            NEHotspotConfigurationManager.shared.apply(config) { error in
+                if let error {
+                    let e = error as NSError
+                    if e.domain == NEHotspotConfigurationErrorDomain && e.code == NEHotspotConfigurationError.alreadyAssociated.rawValue {
+                        continuation.resume(); return
+                    }
+                    let detail = e.domain == NEHotspotConfigurationErrorDomain && e.code == NEHotspotConfigurationError.userDenied.rawValue
+                        ? "已取消系统的 Wi-Fi 加入确认。" : "加入相机 Wi-Fi 失败（\(e.code)）。请核对相机热点、密码和签名的热点配置权限。"
+                    continuation.resume(throwing: CameraAppError.unsupportedOperation(detail))
+                } else { continuation.resume() }
+            }
+        }
+        try Task.checkCancellation()
+        status = "Wi-Fi 配置已应用，等待相机网络就绪…"
+        try await Task.sleep(nanoseconds: 2_000_000_000)
+    }
+    private func persist() { if let data = try? JSONEncoder().encode(profiles) { UserDefaults.standard.set(data, forKey: key) } }
+    private func message(_ text: String) -> CameraAppError { .unsupportedOperation(text) }
+    private func query(_ id: UUID) -> [String:Any] {
+        [kSecClass as String:kSecClassGenericPassword, kSecAttrService as String:"CameraConnect.WiFi.v1", kSecAttrAccount as String:id.uuidString]
+    }
+    private func setSecret(_ password: String, id: UUID) throws {
+        let q = query(id); let value: [String:Any] = [kSecValueData as String:Data(password.utf8)]
+        var code = SecItemUpdate(q as CFDictionary, value as CFDictionary)
+        if code == errSecItemNotFound {
+            var add = q.merging(value) { _, b in b }; add[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
+            code = SecItemAdd(add as CFDictionary, nil)
+        }
+        guard code == errSecSuccess else { throw message("无法安全保存 Wi-Fi 密码（\(code)）。") }
+    }
+    private func secret(_ id: UUID) -> String? {
+        var q = query(id); q[kSecReturnData as String] = true; q[kSecMatchLimit as String] = kSecMatchLimitOne
+        var result: CFTypeRef?
+        guard SecItemCopyMatching(q as CFDictionary, &result) == errSecSuccess, let data = result as? Data else { return nil }
+        return String(data:data, encoding:.utf8)
+    }
+}
