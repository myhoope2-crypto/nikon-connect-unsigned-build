+                }.disabled(busy)
+                if !message.isEmpty { Text(message).foregroundColor(AppTheme.ink) }
+                #if TROLLSTORE
+                Text("已启用免确认连接时，巨魔版会先扫描指定热点再直接加入；可在相机页关闭免确认连接，改用系统方式。")
+                    .font(.footnote).foregroundColor(AppTheme.inkMuted)
