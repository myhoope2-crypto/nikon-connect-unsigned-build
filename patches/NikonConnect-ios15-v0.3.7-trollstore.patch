+        if let host = connectionHost { return "当前网络 · \(host):\(servicePort ?? 80) · 选中后校验设备身份" }
+        switch brand {
+        case .fuji: return "蓝牙获取 Wi-Fi 并自动加入（实验）"
+        case .nikon: return "蓝牙请求开启 Wi-Fi（实验，首次保存网络）"
+        case .ricoh, .pentax: return "公开的 GR 系列蓝牙热点接口（实验，按实际服务判断）"
+        case .panasonic: return "S5 代蓝牙热点接口（实验，新机型可能不兼容）"
+        case .sony: return "蓝牙候选；本版使用相机 PC 遥控 Wi-Fi，尚未接入手机蓝牙启动"
+        case .canon: return "蓝牙候选；本版照片通道为 CCAPI，需机身启用"
+        case .olympus: return "蓝牙候选；本版使用原生 Wi-Fi 文件通道"
+        case .leica, .hasselblad, .unknown: return "发现候选设备；本版尚未接入该协议"
+        }
+    }
+}
+
+@MainActor
+final class NearbyCameraDiscovery: NSObject, ObservableObject, @preconcurrency CBCentralManagerDelegate, @preconcurrency CBPeripheralDelegate {
+    static let shared = NearbyCameraDiscovery()
+    @Published private(set) var nearby: [NearbyCamera] = []
+    @Published private(set) var saved: [NearbyCamera] = []
+    @Published private(set) var isScanning = false
+    @Published private(set) var status = "开启相机蓝牙后，搜索附近可发现的相机。"
+    @Published private(set) var bluetoothStatus = ""
+    @Published private(set) var networkStatus = ""
+    @Published private(set) var nikonStatus = "尼康蓝牙唤醒为实验支持，首次可能需要在机身确认配对。"
+    var searchExplanation:String {
+        #if TROLLSTORE
+        return "无需先选品牌。搜索蓝牙广播、当前网络相机与附近 Wi-Fi 热点，再由你选择连接。蓝牙机型首次需在机身进入配对界面。"
+        #else
+        return "无需先选品牌。自动搜索蓝牙广播与当前 Wi-Fi 网络，再由你选择连接哪一台。蓝牙机型首次需在机身进入配对界面。"
+        #endif
+    }
+    var discoveryLimitations:String {
+        #if TROLLSTORE
+        return "发现候选不代表已验证兼容。附近热点由巨魔私有接口扫描；不同入口可能属于同一台相机，连接后才可确认身份。"
+        #else
+        return "发现候选不代表已验证兼容。纯 Wi-Fi 相机需要先加入其网络或与手机在同一局域网；iOS 15 无法扫描所有未加入的 Wi-Fi 热点。不同通道可能显示同一台相机，连接后才可确认身份。"
