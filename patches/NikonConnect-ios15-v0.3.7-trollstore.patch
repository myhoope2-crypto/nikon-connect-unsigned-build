+        } catch { status = "蓝牙网络启动未完成：\(error.localizedDescription)"; disconnect(); throw error }
+    }
+    func disconnect() {
+        if let peer { manager?.cancelPeripheralConnection(peer) }; peer = nil; characteristics = [:]; notices = [:]; failureText = nil; expectedDisconnect = false
