+import Foundation
+
+// 协议事实参考 libgphoto2 的 PTP 配置、libfuji、mikefsq/ptp；不生成相机未公布的选项。
+// 厂商编号可能重复，因此必须由连接协议指定 Profile（品牌解码配置）。
+enum CameraParameterLabels {
+    static func title(code: UInt16, value: Int64, profile: CameraParameterDecoder.Profile, model: String = "") -> String {
+        if let label = CameraExtendedParameterLabels.title(code: code, value: value, profile: profile, model: model) { return label }
+        let unknown = String(format: "未识别（0x%X）", UInt32(truncatingIfNeeded: value))
+        if profile == .fuji {
+            if code == 0xd001 { return films[value] ?? unknown }
+            if code == 0x500d { return fujiShutters[value] ?? unknown }
+            if code == 0xd02a {
+                if value == 0x8001 { return "自动 ISO" }
+                // 带其他标志位的无线 ISO 值缺少稳定定义，不把推测当作相机标签。
+                return value > 0 && value < 0x8000 ? String(value) : unknown
+            }
+            if code == 0x500f && [-1, -2, -3].contains(value) { return "自动 ISO \(-value)" }
+        }
+        if profile == .nikon && code == 0xd100 {
+            switch value {
+            case 0xffffffff: return "B 门（Bulb）"
+            case 0xfffffffd: return "T 门（Time）"
+            case 0xfffffffe: return "X 200（闪光同步）"
+            default:
+                let numerator = value >> 16, denominator = value & 0xffff
+                guard numerator > 0, denominator > 0 else { return unknown }
+                return denominator == 1 ? "\(numerator) 秒" : "\(numerator)/\(denominator) 秒"
+            }
+        }
+        switch code {
+        case 0x5007:
+            guard value > 0, value < 65535 else { return "相机控制 / 未提供光圈" }
+            return "f/" + decimal(Double(value) / 100)
+        case 0x500d:
+            if value == 0xffffffff { return "B 门（Bulb）" }
+            guard value > 0 else { return unknown }
+            if value < 10000 { return "1/\(Int((10000.0 / Double(value)).rounded())) 秒" }
+            return decimal(Double(value) / 10000) + " 秒"
+        case 0x500f:
+            if value == 65535 { return "自动 ISO" }
+            return value > 0 ? String(value) : unknown
+        case 0x5010:
+            // 相机用千分之一档编码；1/3、2/3 档按机身常用的一位小数显示。
+            return String(format: "%+.1f EV（曝光档）", Double(value) / 1000)
+        case 0x5005:
+            if profile == .nikon, let name = nikonWhiteBalance[value] { return name }
+            if profile == .fuji, let name = fujiWhiteBalance[value] { return name }
+            return standardWhiteBalance[value] ?? unknown
+        case 0xd017 where profile == .fuji: return "\(value) K（开尔文）"
+        case 0xd01e where profile == .nikon: return "\(value) K（开尔文）"
+        default: return unknown
+        }
+    }
+    private static func decimal(_ value: Double) -> String {
+        String(format: value.rounded() == value ? "%.0f" : "%.1f", value)
+    }
+    private static let standardWhiteBalance: [Int64: String] = [
+        1: "手动", 2: "自动", 3: "一键自动", 4: "日光", 5: "荧光灯", 6: "白炽灯", 7: "闪光灯"
+    ]
+    private static let nikonWhiteBalance: [Int64: String] = [
+        0x8010: "阴天", 0x8011: "背阴", 0x8012: "选择色温", 0x8013: "手动预设",
+        0x8014: "关闭", 0x8015: "闪光灯", 0x8016: "自然光自动适应"
+    ]
+    private static let fujiWhiteBalance: [Int64: String] = [
+        0x8001: "荧光灯 1", 0x8002: "荧光灯 2", 0x8003: "荧光灯 3", 0x8004: "荧光灯 4",
+        0x8005: "荧光灯 5", 0x8006: "阴天 / 阴影", 0x8007: "选择色温", 0x8008: "自定义 1",
+        8: "水下", 0x8020: "自动（白色优先）", 0x8021: "自动（氛围优先）",
+        0x8009: "自定义 2", 0x800a: "自定义 3", 0x800b: "自定义 4", 0x800c: "自定义 5"
+    ]
+    private static let films: [Int64: String] = [
+        1: "PROVIA / 标准", 2: "Velvia / 鲜艳", 3: "ASTIA / 柔和", 4: "PRO Neg. Hi / 专业负片高对比",
+        5: "PRO Neg. Std / 专业负片标准", 6: "黑白", 7: "黑白＋黄滤镜", 8: "黑白＋红滤镜", 9: "黑白＋绿滤镜",
+        10: "棕褐色", 11: "CLASSIC CHROME / 经典正片", 12: "ACROS / 黑白", 13: "ACROS＋黄滤镜",
+        14: "ACROS＋红滤镜", 15: "ACROS＋绿滤镜", 16: "ETERNA / 影院", 17: "CLASSIC Neg. / 经典负片",
