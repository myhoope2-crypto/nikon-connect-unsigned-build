+                    CameraConnectionProgress.shared.advance(.bluetooth, id: progressID, detail: "正在连接所选富士的蓝牙…")
+                    NativeCameraBluetooth.shared.disconnect()
+                    wifi.useBluetoothCamera(mode: mode, identifier: camera.id.uuidString)
+                    let controller = FujiBluetoothController.shared
+                    try await controller.restoreConnection(camera.id.uuidString)
+                    try Task.checkCancellation()
+                    // 热点启动及配置读取统一由 connect -> prepare 执行一次。
+                    // 重复发送 04 00 可能再次触发热点初始化。
+                    wifi.enabled = true
+                } else if camera.brand == .nikon {
+                    NativeCameraBluetooth.shared.disconnect()
+                    if let matching { wifi.choose(matching); wifi.enabled = true }
+                    else {
+                        CameraConnectionProgress.shared.advance(.bluetooth, id: progressID, detail: "通过蓝牙请求开启所选尼康的 Wi-Fi…")
+                        try await discovery.activateNikon(camera.id.uuidString)
+                        try Task.checkCancellation()
+                        discovery.remember(camera); showWiFiSetup = true
+                        selectionStatus = "已请求开启 \(camera.name) 的热点。首次请保存这台相机的 Wi-Fi 名称与密码，以后选择它即可尝试自动启动并加入。"
+                        CameraConnectionProgress.shared.waitForUser(id: progressID, message: selectionStatus)
+                        return
+                    }
+                } else if [.ricoh,.pentax,.panasonic,.canon].contains(camera.brand) {
+                    CameraConnectionProgress.shared.advance(.bluetooth, id: progressID, detail: "通过该机型的蓝牙流程读取配置并请求启动热点…")
+                    let credentials = try await NativeCameraBluetooth.shared.start(camera)
+                    try Task.checkCancellation()
+                    try wifi.save(name:camera.name,ssid:credentials.ssid,password:credentials.password,
+                        open:credentials.password.isEmpty,mode:mode,bluetoothID:camera.id.uuidString)
+                    wifi.enabled = true
+                    if camera.brand == .canon {
+                        selectionStatus = "已请求启动佳能热点。本版照片通道需要相机启用 CCAPI，手机热点连接成功不代表已开放 CCAPI。"
+                    }
+                } else {
+                    NativeCameraBluetooth.shared.disconnect(); discovery.remember(camera); showNetworkJoin = true
+                    selectionStatus = camera.brand == .sony ? "索尼手机蓝牙热点与 PC 遥控使用不同通道。本版尚未接入手机蓝牙启动，请在机身启用 PC 遥控 Wi-Fi，加入后自动识别。" : "请在机身启用 Wi-Fi，加入后应用会按原生协议识别，无需选择品牌。"
