+import Foundation
+
+enum CameraClientIdentity {
+    static let lumixID: String = {
+        let key = "lumixClientIdentity.v1"
+        if let value = UserDefaults.standard.string(forKey:key), value.count == 36 { return value }
+        let value = "4D454930-0100-1000-8001-" + UUID().uuidString.replacingOccurrences(of:"-",with:"").suffix(12)
