+    private var peer: CBPeripheral?
+    private var chars: [CBUUID:CBCharacteristic] = [:]
+    private var authMessages: [Data] = []
+    private var linkError: String?
+    private var readyNikonID: UUID?
+    private var authenticating = false
+    private var writes: [CBUUID:(UUID,CheckedContinuation<Void,Error>)] = [:]
+    private static let nikonService = nikonUUID("DE00")
+    private static let authentication = nikonUUID("2000")
+    private static let clientName = nikonUUID("2002")
+    private static let wifiStart = nikonUUID("2005")
+    private static let controlStatus = nikonUUID("2008")
+    private static func nikonUUID(_ short: String) -> CBUUID { CBUUID(string:"0000\(short)-3DD4-4255-8D62-6DC7B9BD5561") }
+    override init() {
