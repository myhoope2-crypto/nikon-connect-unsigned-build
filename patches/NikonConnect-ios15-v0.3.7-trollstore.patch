+                }
+                _ = try await lumix("getstate")
+            }
+            try Task.checkCancellation(); connected = true
+            var capabilities:Set<CameraCapability> = [.connectionProbe,.listAssets,.downloadAssets]
+            if kind == .ricoh { capabilities.formUnion([.liveView,.capture]) }
+            return CameraSession(cameraName:name,connectedHost:config.normalizedHost,port:config.port,capabilities:capabilities,persistentIdentity:identity)
+        } catch { await disconnect(); throw error }
+    }
+    func fetchAssetsPage(for session:CameraSession,resetTraversal:Bool,limit:Int) async throws -> PhotoAssetPage {
+        guard connected,let client else { throw CameraAppError.notConnected }
+        guard !loading else { throw failure("当前照片列表正在读取。") }; loading = true; defer { loading = false }
+        if resetTraversal {
+            pending = []; visited = []; thumbnails = [:]; ricohStorage = [:]
+            switch kind {
+            case .ricoh:
+                containers = stores.map { ($0,0) }
+            case .olympus:
+                _ = try await client.data("/switch_cammode.cgi",query:"mode=play",headers:["User-Agent":"OI.Share v2"])
+                containers = [("/DCIM",0)]
+            case .panasonic:
+                let state = try await lumix("getstate")
+                if state.first("cammode") != "play" {
+                    // 仅在用户请求浏览时切换一次；忙碌时退出，不反复重发模式切换。
+                    guard state.first("rec") != "on", state.first("sd_access") != "on",
+                          !["on","rec","pause"].contains(state.first("interval_status") ?? "") else {
+                        throw failure("相机正在拍摄或写卡，暂不切换到照片浏览。")
+                    }
+                    guard ProcessInfo.processInfo.systemUptime-lastModeSwitch > 10 else { throw failure("相机刚刚切换模式，请稍候再刷新。") }
+                    lastModeSwitch = ProcessInfo.processInfo.systemUptime
+                    _ = try await lumix("camcmd",type:nil,value:"playmode")
+                    try await Task.sleep(nanoseconds:1_000_000_000)
+                }
+                containers = [("0",0)]
+            }
+        }
+        while pending.count < max(limit,1), !containers.isEmpty {
+            try Task.checkCancellation(); let entry = containers.removeFirst()
+            switch kind {
+            case .ricoh:
+                let json = try await client.json("/v1/photos",query:entry.0.isEmpty ? nil : query(["storage":entry.0]))
+                guard case .array = json["dirs"] else { throw failure("理光照片列表格式不符，未将它当作空相册。") }
+                for dir in json["dirs"].array {
+                    guard let folder = dir["name"].string, validComponent(folder) else { throw failure("相机目录名称无效。") }
+                    for file in dir["files"].array {
+                        guard let name = file.string, validComponent(name), let kind = CameraMediaFormat.kind(for:name) else { continue }
+                        let path = "/v1/photos/\(folder)/\(name)"
+                        let key = path + (entry.0.isEmpty ? "" : "?" + query(["storage":entry.0]))
+                        guard visited.insert(key).inserted else { continue }
+                        ricohStorage[key] = entry.0
+                        // 文件元信息按实际文件读取，不使用列表时间或当前时间代替拍摄时间。
+                        pending.append(PhotoAsset(remoteIdentifier:key,fileName:name,kind:kind,byteSize:0,captureDate:.distantPast,
+                            sourceScope:session.persistentIdentity,directoryIdentifier:"\(entry.0)/\(folder)"))
+                    }
+                }
+            case .olympus:
+                guard visited.insert(entry.0).inserted, entry.0.split(separator:"/").count <= 8 else { continue }
+                let data = try await client.data("/get_imglist.cgi",query:query(["DIR":entry.0]),headers:["User-Agent":"OI.Share v2"])
+                let lines = String(decoding:data,as:UTF8.self).components(separatedBy:.newlines)
+                guard lines.contains(where:{ $0.uppercased().hasPrefix("VER") }) else { throw failure("相机没有返回有效的 OM 照片目录。") }
+                for line in lines {
+                    let columns = line.split(separator:",",omittingEmptySubsequences:false).map { $0.trimmingCharacters(in:.whitespacesAndNewlines) }
+                    guard columns.count >= 6, let size = Int64(columns[2]), let attributes = Int(columns[3]),validComponent(columns[1]) else { continue }
+                    let path = columns[0] + "/" + columns[1]
+                    guard path.hasPrefix("/DCIM/"), !path.components(separatedBy:"/").contains(".."), attributes & 14 == 0 else { continue }
+                    if attributes & 16 != 0 { containers.append((path,0)); continue }
+                    guard let media = CameraMediaFormat.kind(for:columns[1]) else { continue }
+                    pending.append(PhotoAsset(remoteIdentifier:path,fileName:columns[1],kind:media,byteSize:max(0,size),
+                        captureDate:fatDate(Int(columns[4]) ?? 0,Int(columns[5]) ?? 0),sourceScope:session.persistentIdentity,directoryIdentifier:columns[0]))
+                }
+            case .panasonic:
+                try await lumixPage(container:entry.0,start:entry.1,session:session)
+            }
+        }
+        var result = Array(pending.prefix(max(limit,1)))
+        if kind == .ricoh {
+            for i in result.indices {
+                let asset = result[i]; let path = asset.remoteIdentifier.components(separatedBy:"?")[0]
+                let storage = ricohStorage[asset.remoteIdentifier] ?? ""
+                let info = try await client.json(path + "/info",query:storage.isEmpty ? nil : query(["storage":storage]))
+                result[i] = PhotoAsset(remoteIdentifier:asset.remoteIdentifier,fileName:asset.fileName,kind:asset.kind,
+                    byteSize:max(0,info["size"].integer ?? 0),captureDate:CameraHTTPClient.date(info["datetime"].string),
+                    sourceScope:session.persistentIdentity,directoryIdentifier:asset.directoryIdentifier)
+            }
+        }
+        pending.removeFirst(result.count)
+        return PhotoAssetPage(assets:result,hasMore:!pending.isEmpty || !containers.isEmpty)
+    }
+    private func lumixPage(container:String,start:Int,session:CameraSession) async throws {
+        guard let contentClient else { throw CameraAppError.notConnected }
+        let xml = "<?xml version=\"1.0\"?><s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\"><s:Body><u:Browse xmlns:u=\"urn:schemas-upnp-org:service:ContentDirectory:1\" xmlns:pana=\"urn:schemas-panasonic-com:pana\"><ObjectID>\(CameraXML.escape(container))</ObjectID><BrowseFlag>BrowseDirectChildren</BrowseFlag><Filter>*</Filter><StartingIndex>\(start)</StartingIndex><RequestedCount>50</RequestedCount><SortCriteria></SortCriteria><pana:X_FromCP>LumixLink2.0</pana:X_FromCP></u:Browse></s:Body></s:Envelope>"
+        let data = try await contentClient.data("/Server0/CDS_control",method:"POST",body:Data(xml.utf8),headers:[
+            "Content-Type":"text/xml; charset=utf-8","SOAPAction":"\"urn:schemas-upnp-org:service:ContentDirectory:1#Browse\"","User-Agent":"Panasonic MIL DLNA CP UPnP/1.0"])
+        let response = try CameraXML.parse(data)
+        guard response.first("errorCode") == nil, let result = response.first("Result"),
+              let count = Int(response.first("NumberReturned") ?? ""), let total = Int(response.first("TotalMatches") ?? ""),
+              count >= 0, total >= 0, total <= 1_000_000, count <= 1000 else { throw failure("松下内容目录格式不符或当前不允许浏览。") }
+        if start+count < total {
+            guard count > 0 else { throw failure("松下内容目录分页没有前进。") }; containers.insert((container,start+count),at:0)
+        }
+        let didl = try CameraXML.parse(Data(result.utf8))
+        for child in didl.all("container") {
+            if let id = child.attributes["id"], visited.insert("dir:"+id).inserted { containers.append((id,0)) }
+        }
+        for item in didl.all("item") {
+            let resources = item.all("res")
+            let preview = resources.first { ($0.attributes["protocolInfo"] ?? "").contains("JPEG_TN") || URL(string:$0.text)?.lastPathComponent.hasPrefix("DT") == true }?.text
+            let title = item.first("title") ?? ""
+            for resource in resources {
+                guard let url = URL(string:resource.text.trimmingCharacters(in:.whitespacesAndNewlines)), url.host == session.connectedHost,
+                      let port = url.port, [80,50001,60606].contains(port), url.scheme == "http",url.user == nil,url.password == nil,
+                      let kind = CameraMediaFormat.kind(for:url.lastPathComponent) else { continue }
+                let name = url.lastPathComponent
+                guard name.hasPrefix("DO") || kind == .raw else { continue }
+                let key = url.absoluteString; guard visited.insert(key).inserted else { continue }
+                var displayName = title.isEmpty ? String(name.dropFirst(name.hasPrefix("DO") ? 2 : 0)) : title
+                if !displayName.contains(".") { displayName += "." + url.pathExtension.uppercased() }
+                else if URL(fileURLWithPath:displayName).pathExtension.lowercased() != url.pathExtension.lowercased() {
+                    displayName = (displayName as NSString).deletingPathExtension + "." + url.pathExtension.uppercased()
+                }
+                if let preview { thumbnails[key] = preview }
+                pending.append(PhotoAsset(remoteIdentifier:key,fileName:displayName,kind:kind,byteSize:Int64(resource.attributes["size"] ?? "") ?? 0,
+                    captureDate:CameraHTTPClient.date(item.first("date")),sourceScope:session.persistentIdentity,directoryIdentifier:container))
+            }
+        }
+    }
+    func downloadThumbnail(_ asset:PhotoAsset,from session:CameraSession) async throws -> Data? {
+        guard let client else { throw CameraAppError.notConnected }
+        switch kind {
+        case .ricoh:
+            var values = ["size":"thumb"]; if let storage = ricohStorage[asset.remoteIdentifier],!storage.isEmpty { values["storage"] = storage }
+            return try await client.thumbnail(asset.remoteIdentifier,query:query(values))
+        case .olympus:
+            return try await client.data("/get_thumbnail.cgi",query:query(["DIR":asset.remoteIdentifier]),headers:["User-Agent":"OI.Share v2"])
+        case .panasonic:
+            guard let value = thumbnails[asset.remoteIdentifier] else { return nil }
+            let (file,path) = try fileClient(value,session:session); return try await file.data(path)
+        }
+    }
+    func downloadAsset(_ asset:PhotoAsset,from session:CameraSession) async throws -> Data {
+        let file = try await downloadAssetToTemporaryFile(asset,from:session); defer { try? FileManager.default.removeItem(at:file) }; return try Data(contentsOf:file)
+    }
+    func downloadAssetToTemporaryFile(_ asset:PhotoAsset,from session:CameraSession) async throws -> URL { try await downloadAssetToTemporaryFile(asset,from:session,onProgress:nil) }
+    func downloadAssetToTemporaryFile(_ asset:PhotoAsset,from session:CameraSession,onProgress:(@Sendable (DownloadTransferProgress) async -> Void)?) async throws -> URL {
+        guard let client else { throw CameraAppError.notConnected }
+        if kind == .panasonic {
+            let (file,path) = try fileClient(asset.remoteIdentifier,session:session)
+            return try await file.download(path,expectedSize:asset.byteSize,progress:onProgress)
+        }
+        return try await client.download(asset.remoteIdentifier,expectedSize:asset.byteSize,progress:onProgress)
+    }
+    private func fileClient(_ value:String,session:CameraSession) throws -> (CameraHTTPClient,String) {
+        guard let url = URL(string:value.trimmingCharacters(in:.whitespacesAndNewlines)),url.host == session.connectedHost,
+              url.scheme == "http",let port = url.port,[80,50001,60606].contains(port),url.user == nil,url.password == nil else { throw failure("相机文件地址不属于当前设备。") }
+        let client = try fileClients[port] ?? CameraHTTPClient(host:session.connectedHost,port:port,headers:["User-Agent":"Panasonic MIL DLNA CP UPnP/1.0"]); fileClients[port] = client
+        return (client,url.absoluteString)
+    }
+    func downloadTransferMode(for asset:PhotoAsset) async -> DownloadThroughputTransferMode { .httpStream }
+    func checkConnection() async throws {
+        guard let client else { throw CameraAppError.notConnected }
+        switch kind { case .ricoh: _ = try await client.json("/v1/props")
+        case .olympus: _ = try await client.data("/get_caminfo.cgi",headers:["User-Agent":"OI.Share v2"])
+        case .panasonic: _ = try await lumix("getstate") }
+    }
+    func consumeDiagnostics() async -> [String] { ["原生无线协议实验支持；未逐机实测。松下／OM 当前仅接入照片浏览与传输。"] }
+    func disconnect() async {
+        connected = false; client?.close(); client = nil; contentClient?.close(); contentClient = nil
+        for value in fileClients.values { value.close() }; fileClients = [:]
+    }
+    private func lumix(_ mode:String,type:String? = nil,value:String? = nil) async throws -> CameraXML.Node {
+        guard let client else { throw CameraAppError.notConnected }
+        var values = ["mode":mode]; if let type { values["type"] = type }; if let value { values["value"] = value }
+        let data = try await client.data("/cam.cgi",query:query(values)); let root = try CameraXML.parse(data)
+        guard root.first("result") == "ok" else { throw failure("松下当前拒绝此操作，请检查机身状态。") }; return root
+    }
+    func startLiveView() async throws { guard kind == .ricoh, connected else { throw failure("当前通道未接入实时取景。") } }
+    func liveViewFrame() async throws -> Data {
+        guard kind == .ricoh,let client else { throw CameraAppError.notConnected }; return try await client.jpegFrame("/v1/liveview")
+    }
+    func stopLiveView() async {}
+    func releaseShutter() async throws {
+        guard kind == .ricoh,let client else { throw failure("当前通道未接入遥控快门。") }
+        let result = try await client.json("/v1/camera/shoot",method:"POST")
+        guard result["captureId"].integer != nil else { throw failure("相机未确认拍摄请求；请查看机身，未自动重发快门。") }
+    }
+    func cameraParameters() async throws -> [CameraParameter] { [] }
+    func setCameraParameter(_ parameter:UInt16,to choice:CameraParameterChoice) async throws { throw failure("此品牌的参数修改尚未接入。") }
+    func newlyCapturedAssets(in session:CameraSession) async throws -> [PhotoAsset] { throw failure("此通道尚未接入边拍边传。") }
+    private func query(_ values:[String:String]) -> String {
+        var components = URLComponents(); components.queryItems = values.sorted { $0.key < $1.key }.map { URLQueryItem(name:$0.key,value:$0.value) }; return components.percentEncodedQuery ?? ""
+    }
+    private func deviceIdentity(_ values:[String?]) -> String {
+        values.compactMap { $0?.trimmingCharacters(in:.whitespacesAndNewlines) }.first(where:{ !$0.isEmpty }) ?? "session-"+UUID().uuidString
+    }
+    // 部分 LUMIX 新机使用 nonce 混淆的 req_acc_g/e；不能据 Wi-Fi 链路一致推定认证一致。
+    private func lumixAccessValue(_ value:String,nonce:UInt32) -> String {
+        var bytes = Array(value.utf8); while bytes.count % 4 != 0 { bytes.append(0xff) }
+        let key = nonce == 0 ? UInt32(0x9032782c) : nonce
+        return stride(from:0,to:bytes.count,by:4).map { offset in
+            let value = bytes[offset..<offset+4].reduce(UInt32(0)) { ($0 << 8)|UInt32($1) } ^ key
+            return String(format:"%08x",value.byteSwapped)
+        }.joined()
+    }
+    private func validComponent(_ value:String) -> Bool { !value.isEmpty && value != "." && value != ".." && !value.contains("/") && !value.contains("\\") && !value.contains("?") && !value.contains("#") }
+    private func fatDate(_ date:Int,_ time:Int) -> Date {
+        guard date > 0 else { return .distantPast }; var components = DateComponents()
+        components.year = 1980 + ((date >> 9)&127); components.month = (date >> 5)&15; components.day = date&31
+        components.hour = (time >> 11)&31; components.minute = (time >> 5)&63; components.second = (time&31)*2
+        return Calendar(identifier:.gregorian).date(from:components) ?? .distantPast
+    }
+    private func failure(_ value:String) -> CameraAppError { .unsupportedOperation(value) }
+}
diff --git a/Services/FujiBluetoothController.swift b/Services/FujiBluetoothController.swift
