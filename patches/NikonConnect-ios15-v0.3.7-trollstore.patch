+    private var stores:[String] = []
+    private var connected = false
+    private var loading = false
+    private var lastModeSwitch:TimeInterval = 0
+    init(kind:Kind) { self.kind = kind }
+    func connect(using config:CameraConnectionConfig) async throws -> CameraSession {
+        let http = try CameraHTTPClient(host:config.normalizedHost,port:config.port,headers:kind == .olympus ? ["User-Agent":"OI.Share v2"] : [:])
+        client = http
+        do {
+            let name:String, identity:String
