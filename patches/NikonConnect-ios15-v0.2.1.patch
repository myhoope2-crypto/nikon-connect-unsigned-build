+        show(logs); logs.tap(); app.swipeUp(); shot("06-暗黑运行记录")
+    }
+    func testConnectedPhotosAndDownloads() {
+        launch(); setMode("暗黑"); tab("相机"); shot("07-暗黑相机已连接")
+        tab("照片"); shot("08-暗黑照片筛选与下载条")
+        app.switches["按相机文件日期筛选"].tap(); shot("09-暗黑日期筛选")
+        let start = app.datePickers["photos.dateStart"]
+        if start.exists { start.tap(); shot("10-暗黑日期弹层"); app.navigationBars["照片"].tap() }
+        app.switches["按相机文件日期筛选"].tap()
+        show(app.staticTexts["DSC_0001.JPG"])
+        shot("11-暗黑照片网格格式星标与选中状态")
+        app.staticTexts["DSC_0001.JPG"].firstMatch.tap()
+        XCTAssertTrue(app.buttons["关闭预览"].waitForExistence(timeout: 10))
+        shot("12-暗黑全屏预览")
+        app.buttons["关闭预览"].tap()
+        let options = app.images["photos.options"]
+        if options.exists { options.tap() } else { app.buttons.matching(identifier: "photos.options").firstMatch.tap() }
+        shot("13-暗黑全选范围菜单")
+        app.buttons["清空选择"].tap()
+        tab("下载"); shot("14-暗黑下载总览")
