+    private let app = XCUIApplication()
+    override func setUpWithError() throws { continueAfterFailure = false }
+    private func launch(connected: Bool = true, reset: Bool = true) {
+        app.launchArguments = ["-appearance-fixtures", "-AppleLanguages", "(zh-Hans)", "-AppleLocale", "zh_CN"]
+        if connected { app.launchArguments.append("-appearance-connected") }
+        if reset { app.launchArguments.append("-appearance-reset") }
+        app.launch()
+        XCTAssertTrue(app.tabBars.buttons["设置"].waitForExistence(timeout: 30))
+        if connected { XCTAssertTrue(app.staticTexts["外观验证相机"].firstMatch.waitForExistence(timeout: 15)) }
+    }
+    private func shot(_ name: String) {
+        let attachment = XCTAttachment(screenshot: app.screenshot())
+        attachment.name = name; attachment.lifetime = .keepAlways; add(attachment)
+    }
+    private func tab(_ name: String) { app.tabBars.buttons[name].tap() }
+    private func show(_ element: XCUIElement, maxSwipes: Int = 8) {
+        for _ in 0..<maxSwipes {
+            if element.exists && element.isHittable { return }
+            app.swipeUp()
+        }
+        XCTAssertTrue(element.exists && element.isHittable, "需要检查的控件未显示：\(element)")
+    }
+    private func setMode(_ mode: String) {
+        tab("设置")
+        let picker = app.segmentedControls["appearance.mode"]
+        XCTAssertTrue(picker.waitForExistence(timeout: 10))
+        picker.buttons[mode].tap()
+        XCTAssertTrue(picker.buttons[mode].isSelected)
+    }
+    func testSettingsThemeSwitchAndPersistence() {
+        launch()
+        setMode("浅色"); shot("01-浅色设置")
+        setMode("暗黑")
+        XCTAssertTrue(app.switches["允许自动导出到系统相册"].exists)
+        XCTAssertTrue(app.switches["启用 JPEG 优先 / RAW 后补"].exists)
+        shot("02-暗黑设置与下载开关")
+        app.terminate(); launch(reset: false); tab("设置")
+        XCTAssertTrue(app.segmentedControls["appearance.mode"].buttons["暗黑"].isSelected)
+        shot("03-重启记住暗黑模式")
