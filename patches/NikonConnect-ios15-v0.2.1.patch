+import SwiftUI
+import UIKit
+
+enum AppAppearance: String, CaseIterable, Identifiable {
+    case system, light, dark
+    var id: String { rawValue }
+    var title: String {
+        switch self { case .system: return "跟随系统"; case .light: return "浅色"; case .dark: return "暗黑" }
+    }
+    var colorScheme: ColorScheme? {
+        switch self { case .system: return nil; case .light: return .light; case .dark: return .dark }
+    }
+    var interfaceStyle: UIUserInterfaceStyle {
+        switch self { case .system: return .unspecified; case .light: return .light; case .dark: return .dark }
+    }
+}
+
+// 显式清除窗口覆盖，保证从手动模式切回“跟随系统”后继续响应系统切换。
+struct AppAppearanceWindowOverride: UIViewRepresentable {
+    let mode: AppAppearance
+    func makeUIView(context: Context) -> AppearanceView { AppearanceView() }
+    func updateUIView(_ uiView: AppearanceView, context: Context) {
+        uiView.style = mode.interfaceStyle
+        uiView.applyAppearance()
+    }
+    final class AppearanceView: UIView {
+        var style: UIUserInterfaceStyle = .unspecified
+        override func didMoveToWindow() { super.didMoveToWindow(); applyAppearance() }
+        func applyAppearance() {
+            if let window, window.overrideUserInterfaceStyle != style { window.overrideUserInterfaceStyle = style }
+        }
+    }
+}
