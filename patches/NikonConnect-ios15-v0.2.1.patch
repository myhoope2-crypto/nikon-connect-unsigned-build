+    @ObservedObject var connection: ConnectionViewModel
+    @AppStorage("autoReconnectCamera") private var autoReconnect = true
+
+    var body: some View {
+        ScrollView {
+            VStack(alignment: .leading, spacing: 18) {
+                Text(connection.activeSession?.cameraName ?? "尚未连接相机").font(.title2.bold())
+                Text("拍摄控制为实验功能，以尼康 Z6 III、富士 X-T30 III 及相同协议机型为目标。功能是否可用取决于相机响应。")
+                    .font(.footnote).foregroundColor(AppTheme.inkMuted)
+                Text(model.status).font(.footnote)
+                if model.isRecovering { Button("停止自动重连") { model.stopRecovery() } }
+                Toggle("断线后自动重连（最多 3 次）", isOn: $autoReconnect)
+                CustomCard {
+                    VStack(spacing: 12) {
+                        if let data = model.liveFrame, let image = UIImage(data: data) {
+                            Image(uiImage: image).resizable().scaledToFit()
+                        } else {
+                            Image(systemName: "camera.viewfinder").font(.system(size: 64)).frame(maxWidth: .infinity, minHeight: 130)
+                        }
+                        Button(model.isLive ? "停止实时取景" : "开始实时取景") {
+                            if model.isLive { model.stopLive() } else { model.startLive() }
+                        }.disabled(model.isBusy || (!model.isLive && !model.supports(.liveView)))
+                        Button { model.shutter() } label: { Label("遥控快门", systemImage: "camera.aperture") }
+                            .disabled(model.isBusy || !model.supports(.capture))
+                    }
+                }
+                CustomCard {
+                    VStack(alignment: .leading, spacing: 12) {
+                        Text("前台边拍边传").font(.headline)
+                        Text("先记录已有文件，再监测新照片并自动入队。进入后台、断线或开启实时取景后暂停。首次建立基线可能需要读取存储卡。")
+                            .font(.caption).foregroundColor(AppTheme.inkMuted)
+                        Button(model.isWatching ? "停止边拍边传" : "开始边拍边传") {
+                            if model.isWatching { model.stopWatching() } else { model.startWatching() }
+                        }.disabled(!model.isWatching && (!model.supports(.watchCapture) || model.isBusy || model.isLive))
+                    }
+                }
+                CustomCard {
+                    VStack(alignment: .leading, spacing: 14) {
+                        HStack { Text("相机参数").font(.headline); Spacer(); Button("刷新参数") { model.refreshParameters() }
+                            .disabled(model.isBusy || !model.supports(.parameters)) }
+                        ForEach(model.parameters) { parameter in
+                            HStack {
+                                Text(parameter.title); Spacer()
+                                Menu {
+                                    ForEach(parameter.choices) { choice in
+                                        Button(choice.title) { model.setParameter(parameter.id, choice: choice) }
+                                    }
+                                } label: { Text(parameter.current.title) }
+                                    .disabled(!parameter.writable || model.isBusy)
+                            }
+                        }
+                        Text("只提供相机报告的允许值；只读、拨盘锁定或当前模式不支持的参数不会允许修改。")
