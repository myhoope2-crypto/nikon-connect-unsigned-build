+        app.swipeUp(); shot("16-暗黑下载错误与重试")
+        app.swipeUp(); shot("17-暗黑传输进度与测速")
+        app.swipeUp(); shot("18-暗黑下载完成记录")
+    }
+    func testRemoteControlsMenusAndAlert() {
