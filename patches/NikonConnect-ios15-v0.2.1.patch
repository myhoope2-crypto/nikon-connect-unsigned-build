new file mode 100644
index 0000000..d6a32a5
--- /dev/null
+++ b/Services/CameraHTTPClient.swift
@@ -0,0 +1,139 @@
+import Foundation
+
+enum CameraJSON: Codable, Sendable {
+    case object([String: CameraJSON]), array([CameraJSON]), string(String), number(Double), bool(Bool), null
+    init(from decoder: any Decoder) throws {
+        let c = try decoder.singleValueContainer()
+        if c.decodeNil() { self = .null }
+        else if let v = try? c.decode(Bool.self) { self = .bool(v) }
+        else if let v = try? c.decode(String.self) { self = .string(v) }
+        else if let v = try? c.decode(Double.self) { self = .number(v) }
+        else if let v = try? c.decode([String: CameraJSON].self) { self = .object(v) }
+        else { self = .array(try c.decode([CameraJSON].self)) }
+    }
+    func encode(to encoder: any Encoder) throws {
+        var c = encoder.singleValueContainer()
+        switch self {
+        case .object(let v): try c.encode(v); case .array(let v): try c.encode(v)
+        case .string(let v): try c.encode(v); case .number(let v): try c.encode(v)
+        case .bool(let v): try c.encode(v); case .null: try c.encodeNil()
+        }
+    }
+    subscript(_ key: String) -> CameraJSON { if case .object(let v) = self { return v[key] ?? .null }; return .null }
+    var string: String? { if case .string(let v) = self { return v }; return nil }
+    var array: [CameraJSON] { if case .array(let v) = self { return v }; return [] }
+    var object: [String: CameraJSON] { if case .object(let v) = self { return v }; return [:] }
+    var integer: Int64? {
+        if case .number(let v) = self, v.isFinite, v >= Double(Int64.min), v < Double(Int64.max) { return Int64(v) }
+        if let string { return Int64(string) }; return nil
+    }
+}
+
+final class CameraHTTPClient: @unchecked Sendable {
+    let baseURL: URL
+    private let session: URLSession
+    init(host: String, port: Int) throws {
+        var components = URLComponents(); components.scheme = "http"; components.host = host; components.port = port
+        guard (1...65535).contains(port), let url = components.url else { throw CameraAppError.invalidPort }
+        baseURL = url
+        let config = URLSessionConfiguration.ephemeral
+        config.waitsForConnectivity = false; config.timeoutIntervalForRequest = 15
+        config.timeoutIntervalForResource = 1800; config.urlCache = nil
+        session = URLSession(configuration: config, delegate: CameraHTTPRedirectGuard(host: host, port: port), delegateQueue: nil)
+    }
+    func close() { session.invalidateAndCancel() }
+    func url(_ reference: String, query: String? = nil) throws -> URL {
+        guard let result = URL(string: reference, relativeTo: baseURL)?.absoluteURL,
+              result.host?.lowercased() == baseURL.host?.lowercased(),
+              result.port == baseURL.port, result.scheme == baseURL.scheme,
+              result.user == nil, result.password == nil, result.fragment == nil,
+              !result.path.components(separatedBy: "/").contains("..") else {
+            throw CameraAppError.unsupportedOperation("相机返回了不属于当前连接的文件地址。")
+        }
+        if let query {
+            var c = URLComponents(url: result, resolvingAgainstBaseURL: false)!
+            c.query = query; return c.url!
+        }
+        return result
+    }
+    func json(_ reference: String, method: String = "GET", body: CameraJSON? = nil, query: String? = nil) async throws -> CameraJSON {
+        var request = URLRequest(url: try url(reference, query: query)); request.httpMethod = method
+        if let body { request.httpBody = try JSONEncoder().encode(body); request.setValue("application/json", forHTTPHeaderField: "Content-Type") }
+        let data = try await boundedData(request)
+        return try JSONDecoder().decode(CameraJSON.self, from: data)
+    }
+    func thumbnail(_ reference: String, query: String) async throws -> Data {
+        let data = try await boundedData(URLRequest(url: url(reference, query: query)))
+        guard !data.isEmpty, data.count <= 8 * 1024 * 1024 else { throw PTPIPError.malformedPayload("缩略图大小无效") }
+        return data
+    }
+    private func boundedData(_ request: URLRequest) async throws -> Data {
+        let (bytes, response) = try await session.bytes(for: request)
+        try validate(response)
+        var data = Data()
+        for try await byte in bytes {
+            guard data.count < 8 * 1024 * 1024 else { throw PTPIPError.malformedPayload("相机列表或缩略图超过大小限制") }
+            data.append(byte)
+        }
+        return data
+    }
+    func download(_ reference: String, expectedSize: Int64,
+        progress: (@Sendable (DownloadTransferProgress) async -> Void)?) async throws -> URL {
+        let delegate = CameraHTTPProgress(expectedSize: expectedSize, progress: progress)
+        let (temporary, response) = try await session.download(for: URLRequest(url: url(reference)), delegate: delegate)
+        do {
+            try validate(response); try Task.checkCancellation()
+            let target = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString + ".camera")
+            try FileManager.default.moveItem(at: temporary, to: target)
+            return target
+        } catch { try? FileManager.default.removeItem(at: temporary); throw error }
+    }
+    private func validate(_ response: URLResponse) throws {
+        guard let http = response as? HTTPURLResponse, http.statusCode == 200 else {
+            let code = (response as? HTTPURLResponse)?.statusCode ?? 0
+            throw CameraAppError.networkProbeFailed(code == 401 ? "相机要求身份验证，当前通道尚不支持该认证方式。" : "相机 HTTP 响应码：\(code)。")
+        }
+    }
+    static func date(_ value: String?) -> Date {
+        guard let value else { return .distantPast }
+        let iso = ISO8601DateFormatter()
+        if let date = iso.date(from: value) { return date }
+        iso.formatOptions.insert(.withFractionalSeconds)
+        if let date = iso.date(from: value) { return date }
+        let f = DateFormatter(); f.locale = Locale(identifier: "en_US_POSIX")
+        f.dateFormat = "EEE, dd MMM yyyy HH:mm:ss Z"; return f.date(from: value) ?? .distantPast
+    }
+}
+
+private final class CameraHTTPRedirectGuard: NSObject, URLSessionTaskDelegate, @unchecked Sendable {
+    let host: String; let port: Int
+    init(host: String, port: Int) { self.host = host; self.port = port }
+    func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse,
+        newRequest request: URLRequest, completionHandler: @escaping @Sendable (URLRequest?) -> Void) {
+        let allowed = request.url?.host == host && request.url?.port == port && request.url?.scheme == "http"
+        completionHandler(allowed ? request : nil)
+    }
+}
+
+private final class CameraHTTPProgress: NSObject, URLSessionDownloadDelegate, @unchecked Sendable {
+    let expectedSize: Int64
+    let progress: (@Sendable (DownloadTransferProgress) async -> Void)?
+    init(expectedSize: Int64, progress: (@Sendable (DownloadTransferProgress) async -> Void)?) {
+        self.expectedSize = expectedSize; self.progress = progress
+    }
+    func urlSession(_ session: URLSession, task: URLSessionTask, willPerformHTTPRedirection response: HTTPURLResponse,
+        newRequest request: URLRequest, completionHandler: @escaping @Sendable (URLRequest?) -> Void) {
+        let origin = task.originalRequest?.url
+        let allowed = request.url?.host == origin?.host && request.url?.port == origin?.port
+            && request.url?.scheme == origin?.scheme && request.url?.user == nil && request.url?.password == nil
+        completionHandler(allowed ? request : nil)
+    }
+    func urlSession(_ session: URLSession, downloadTask: URLSessionDownloadTask, didFinishDownloadingTo location: URL) {}
+    func urlSession(_ session: URLSession, downloadTask: URLSessionDownloadTask, didWriteData bytesWritten: Int64,
+        totalBytesWritten: Int64, totalBytesExpectedToWrite: Int64) {
+        let update = DownloadTransferProgress(bytesTransferred: totalBytesWritten,
+            totalBytes: max(expectedSize, max(totalBytesExpectedToWrite, totalBytesWritten)), resumedCount: 0,
+            currentOffset: totalBytesWritten, chunkSize: bytesWritten)
+        if let progress { Task { await progress(update) } }
+    }
+}
