+import SwiftUI
+
+struct CameraWiFiSetupView: View {
+    let mode: CameraTransportMode
+    var onSaved: () -> Void = {}
+    @ObservedObject private var wifi = CameraWiFiCoordinator.shared
+    @Environment(\.dismiss) private var dismiss
+    @State private var name = ""
+    @State private var ssid = ""
+    @State private var password = ""
+    @State private var open = false
+    @State private var errorMessage: String?
+    var body: some View {
+        NavigationView {
+            Form {
+                Section(header: Text("连接时自动加入")) {
+                    Toggle("自动加入相机 Wi-Fi", isOn: Binding(get: { wifi.enabled }, set: { wifi.enabled = $0 }))
+                    Text("首次保存一次。之后点击连接相机即可请求加入，无需每次前往系统 Wi-Fi 列表。系统仍可能要求确认加入。")
+                        .font(.footnote).foregroundColor(AppTheme.inkMuted)
+                }
+                Section(header: Text("\(mode.title)已保存的网络")) {
+                    ForEach(wifi.profiles.filter { $0.mode == mode }) { profile in
+                        HStack {
+                            Button { wifi.choose(profile) } label: {
+                                VStack(alignment: .leading) {
+                                    Text(profile.name); Text(profile.ssid).font(.caption).foregroundColor(AppTheme.inkMuted)
+                                }
+                            }
+                            Spacer()
+                            if wifi.profile(for: mode)?.id == profile.id { Image(systemName: "checkmark").foregroundColor(AppTheme.accentStrong) }
+                            Button("删除", role: .destructive) { wifi.remove(profile) }
+                        }
+                    }
+                }
+                Section(header: Text("添加网络")) {
+                    TextField("相机备注名称", text: $name)
+                    TextField("相机的 Wi-Fi 名称（SSID）", text: $ssid).disableAutocorrection(true).textInputAutocapitalization(.never)
+                    Toggle("无密码的开放网络", isOn: $open)
+                    if !open { SecureField("Wi-Fi 密码", text: $password).textInputAutocapitalization(.never) }
+                    Text("网络名称要与相机显示的一致。富士可先蓝牙配对，由相机自动提供网络和密码。密码保存在本机钥匙串，不进入报告和配方文件。")
+                        .font(.footnote).foregroundColor(AppTheme.inkMuted)
+                    Button("保存并连接") {
+                        do {
+                            try wifi.save(name: name, ssid: ssid, password: password, open: open, mode: mode)
+                            wifi.enabled = true; dismiss(); onSaved()
+                        } catch { errorMessage = error.localizedDescription }
+                    }.disabled(ssid.isEmpty)
+                }
+                if let errorMessage { Text(errorMessage).foregroundColor(AppTheme.danger) }
+                Text("重新签名时需要启用 Hotspot Configuration（热点配置）权限。相机必须已开启热点；本应用不能在没有对应蓝牙协议的机型上远程打开热点。")
+                    .font(.footnote).foregroundColor(AppTheme.inkMuted)
+            }.foregroundColor(AppTheme.ink).navigationTitle("相机 Wi-Fi")
+                .toolbar { ToolbarItem(placement: .navigationBarTrailing) { Button("完成") { dismiss() } } }
+        }.navigationViewStyle(.stack).tint(AppTheme.accentStrong)
+    }
+}
