diff --git a/Domain/WorkflowLibrary.swift b/Domain/WorkflowLibrary.swift
new file mode 100644
index 0000000..8400d09
--- /dev/null
+++ b/Domain/WorkflowLibrary.swift
@@ -0,0 +1,160 @@
+import Foundation
+import SwiftUI
+
+struct SavedCameraValue: Codable, Identifiable, Sendable {
+    var kind: String
+    var title: String
+    var data: Data
+    var id: String { kind }
+}
+struct SavedCameraPreset: Codable, Identifiable, Sendable {
+    var id = UUID()
+    var formatVersion = 1
+    var name: String
+    var note: String
+    var model: String
+    var brand: String
+    var recipe: Bool
+    var createdAt = Date()
+    var values: [SavedCameraValue]
+}
+struct ProjectPhoto: Codable, Identifiable, Sendable {
+    var id: String
+    var originalName: String
+    var captureDate: Date
+    var byteSize: Int64
+    var pairKey: String?
+    var camera: String
+}
+struct CaptureProject: Codable, Identifiable, Sendable {
+    var id = UUID()
+    var name: String
+    var note = ""
+    var createdAt = Date()
+    var photos: [ProjectPhoto] = []
+}
+
+@MainActor
+final class WorkflowLibrary: ObservableObject {
+    static let shared = WorkflowLibrary()
+    @Published private(set) var presets: [SavedCameraPreset] = []
+    @Published private(set) var projects: [CaptureProject] = []
+    @Published var activeProjectID: UUID? { didSet { UserDefaults.standard.set(activeProjectID?.uuidString, forKey: "activeCaptureProject.v1") } }
+    @Published var errorMessage: String?
+    private let directory: URL
+    init() {
+        directory = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first!
+            .appendingPathComponent("CameraWorkflow", isDirectory: true)
+        if let raw = UserDefaults.standard.string(forKey: "activeCaptureProject.v1") { activeProjectID = UUID(uuidString:raw) }
+        do {
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+            let p = directory.appendingPathComponent("presets.json"), tasks = directory.appendingPathComponent("projects.json")
+            if FileManager.default.fileExists(atPath:p.path) { presets = try JSONDecoder().decode([SavedCameraPreset].self, from: Data(contentsOf:p)) }
+            if FileManager.default.fileExists(atPath:tasks.path) { projects = try JSONDecoder().decode([CaptureProject].self, from:Data(contentsOf:tasks)) }
+            if !projects.contains(where: { $0.id == activeProjectID }) { activeProjectID = nil }
+        } catch { errorMessage = "本地工作资料读取失败，原文件已保留：\(error.localizedDescription)" }
+    }
+    func addPreset(_ item: SavedCameraPreset) throws {
+        try validate(item)
+        var updated = presets; var saved = item; saved.id = UUID(); updated.insert(saved, at:0)
+        try write(updated, name:"presets.json"); presets = updated
+    }
+    func importPreset(_ url: URL) throws {
+        let access = url.startAccessingSecurityScopedResource(); defer { if access { url.stopAccessingSecurityScopedResource() } }
+        let size = try url.resourceValues(forKeys:[.fileSizeKey]).fileSize ?? 0
+        guard size > 0, size <= 2_000_000 else { throw failure("配方文件为空或超过 2 MB。") }
+        try addPreset(JSONDecoder().decode(SavedCameraPreset.self, from:Data(contentsOf:url)))
+    }
+    func removePreset(_ id: UUID) throws {
+        let updated = presets.filter { $0.id != id }; try write(updated, name:"presets.json"); presets = updated
+    }
+    func exportPreset(_ item: SavedCameraPreset) throws -> URL {
+        let url = try exportDirectory().appendingPathComponent("相机配方-\(item.id.uuidString).json")
+        try encoder().encode(item).write(to:url, options:.atomic); return url
+    }
+    @discardableResult func createProject(_ name: String) throws -> UUID {
+        let clean = name.trimmingCharacters(in:.whitespacesAndNewlines)
+        guard !clean.isEmpty, clean.count <= 100 else { throw failure("项目名称请输入 1–100 个字。") }
+        let item = CaptureProject(name:clean); var updated = projects; updated.insert(item, at:0)
+        try write(updated, name:"projects.json"); projects = updated; activeProjectID = item.id; return item.id
+    }
+    func updateProject(_ item: CaptureProject) throws {
+        guard let i = projects.firstIndex(where: { $0.id == item.id }), !item.name.trimmingCharacters(in:.whitespacesAndNewlines).isEmpty else { return }
+        var updated = projects; updated[i] = item; try write(updated, name:"projects.json"); projects = updated
+    }
+    func removeProject(_ id: UUID) throws {
+        let updated = projects.filter { $0.id != id }; try write(updated, name:"projects.json"); projects = updated
+        if activeProjectID == id { activeProjectID = nil }
+    }
+    @discardableResult func addPhotos(_ assets: [PhotoAsset], projectID: UUID? = nil) throws -> Int {
+        guard let id = projectID ?? activeProjectID, let i = projects.firstIndex(where: { $0.id == id }) else { return 0 }
+        var updated = projects, seen = Set(updated[i].photos.map(\.id)); var added = 0
+        for photo in assets {
+            guard let key = photo.libraryFingerprint, seen.insert(key).inserted else { continue }
+            updated[i].photos.append(ProjectPhoto(id:key, originalName:photo.fileName, captureDate:photo.captureDate,
+                byteSize:photo.byteSize, pairKey:photo.companionGroup, camera:photo.sourceScope?.components(separatedBy:"|").prefix(2).joined(separator:" · ") ?? "未知相机")); added += 1
+        }
+        if added > 0 { try write(updated, name:"projects.json"); projects = updated }; return added
+    }
+    func exportDirectory() throws -> URL {
+        let url = FileManager.default.urls(for:.documentDirectory, in:.userDomainMask).first!.appendingPathComponent("项目与配方导出", isDirectory:true)
+        try FileManager.default.createDirectory(at:url, withIntermediateDirectories:true); return url
+    }
+    private func validate(_ item: SavedCameraPreset) throws {
+        guard item.formatVersion == 1, ["fuji","nikon","standard"].contains(item.brand),
+              !item.model.isEmpty, item.model.count <= 200, !item.name.isEmpty, item.name.count <= 100,
+              item.note.count <= 10000, !item.values.isEmpty, item.values.count <= 80,
+              Set(item.values.map(\.kind)).count == item.values.count,
+              item.values.allSatisfy({ CameraParameterKind(rawValue:$0.kind) != nil && !$0.data.isEmpty && $0.data.count <= 1024 && $0.title.count <= 300 }) else {
+            throw failure("配方格式或内容无效，未导入。")
+        }
+    }
+    private func encoder() -> JSONEncoder { let e = JSONEncoder(); e.outputFormatting = [.prettyPrinted,.sortedKeys]; return e }
+    private func write<T: Encodable>(_ value: T, name: String) throws { try encoder().encode(value).write(to:directory.appendingPathComponent(name), options:.atomic) }
+    private func failure(_ text: String) -> CameraAppError { .unsupportedOperation(text) }
+}
+
+actor CaptureProjectExporter {
+    func export(_ project: CaptureProject, records: [DownloadRecord], directory: URL, prefix: String, metadataOnly: Bool) throws -> URL {
+        let safe = sanitize(prefix.isEmpty ? project.name : prefix)
+        let folder = directory.appendingPathComponent(safe + "-" + UUID().uuidString.prefix(8), isDirectory:true)
+        try FileManager.default.createDirectory(at:folder, withIntermediateDirectories:true)
+        var csv = "序号,原文件名,导出文件名,拍摄时间,文件大小,相机,状态\n"
+        var pairs: [String:Int] = [:], number = 0
+        for photo in project.photos.sorted(by: { $0.captureDate < $1.captureDate }) {
+            try Task.checkCancellation()
+            let key = photo.pairKey ?? photo.id
+            if pairs[key] == nil { number += 1; pairs[key] = number }
+            let index = pairs[key]!
+            let ext = (photo.originalName as NSString).pathExtension.lowercased().filter { $0.isASCII && $0.isLetter || $0.isNumber }
+            let name = String(format:"%@_%04d",safe,index) + (ext.isEmpty ? "" : "." + ext)
+            var state = metadataOnly ? "仅导出清单" : "未下载"
+            if !metadataOnly, let record = records.first(where: { $0.assetFingerprint == photo.id }) {
+                let destination = folder.appendingPathComponent(name)
+                // 同组同扩展名也不能覆盖；保留唯一后缀。
+                let target = FileManager.default.fileExists(atPath:destination.path)
+                    ? folder.appendingPathComponent((name as NSString).deletingPathExtension + "-" + photo.id.prefix(8) + "." + ext) : destination
+                if FileManager.default.fileExists(atPath:record.savedURL.path) {
+                    try FileManager.default.copyItem(at:record.savedURL, to:target); state = "已复制"
+                    csv += row([String(index),photo.originalName,target.lastPathComponent,ISO8601DateFormatter().string(from:photo.captureDate),String(photo.byteSize),photo.camera,state]); continue
+                } else { state = "本地文件不存在" }
+            }
+            csv += row([String(index),photo.originalName,"",ISO8601DateFormatter().string(from:photo.captureDate),String(photo.byteSize),photo.camera,state])
+        }
+        try Data(("\u{feff}" + csv).utf8).write(to:folder.appendingPathComponent("照片清单.csv"), options:.atomic)
+        let e = JSONEncoder(); e.outputFormatting = [.prettyPrinted,.sortedKeys]
+        try e.encode(project).write(to:folder.appendingPathComponent("项目资料.json"), options:.atomic)
+        return folder
+    }
+    private func sanitize(_ name: String) -> String {
+        let bad = CharacterSet(charactersIn:"/\\:*?\"<>|\r\n\t").union(.controlCharacters)
+        let result = name.components(separatedBy:bad).joined(separator:"_").trimmingCharacters(in:CharacterSet(charactersIn:". "))
+        return result.isEmpty ? "拍摄项目" : String(result.prefix(60))
+    }
+    private func row(_ fields: [String]) -> String {
+        fields.map { value in
+            let safe = ["=","+","-","@"].contains(value.first.map(String.init) ?? "") ? "'" + value : value
+            return "\"" + safe.replacingOccurrences(of:"\"",with:"\"\"") + "\""
+        }.joined(separator:",") + "\n"
+    }
+}
