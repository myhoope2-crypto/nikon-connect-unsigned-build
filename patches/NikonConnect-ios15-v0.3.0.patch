--- /dev/null
+++ b/Features/ConnectionSetup/CameraRemoteViewModel.swift
@@ -0,0 +1,520 @@
+import Foundation
+import SwiftUI
+import UIKit
+
+@MainActor
+final class CameraRemoteViewModel: ObservableObject {
+    @Published var liveFrame: Data?
+    @Published var isLive = false
+    @Published var isStoppingLive = false
+    @Published var isWatching = false
+    @Published var isBusy = false
+    @Published var isRecovering = false
+    @Published var parameters: [CameraParameter] = []
+    @Published var parametersLoaded = false
+    @Published var parameterStatus = "进入实时取景后自动读取相机参数。"
+    @Published var parameterUpdatedAt: Date?
+    @Published var liveAlert: AlertContext?
+    @Published var focusCapabilities = CameraFocusCapabilities()
+    @Published var focusMarker: CameraFocusPoint?
+    @Published var focusStatus = "进入取景后读取遥控对焦能力。"
+    @Published var isScheduling = false
+    @Published var scheduleStatus = "设置倒计时、间隔和张数；仅在应用前台执行。"
+    @Published var scheduleCompleted = 0
+    @Published var presetStatus = "预设按机型保存，应用前重新读取机身允许值。"
+    @Published var liveHistogram: [Double] = []
+    @Published var zebraFrame: Data?
+    private let frameAnalyzer = LiveFrameAnalyzer()
+    private var scheduleTask: Task<Void, Never>?
+    private var scheduleID: UUID?
+    private var watchKnownFingerprints: Set<String>?
+    private var watchBaselineIdentity: String?
+    private var needsFullParameterRefresh = false
+    var cameraModel: String { connection.activeSession?.cameraName ?? "未连接相机" }
+    var cameraProfile: CameraParameterDecoder.Profile { CameraSettingCatalog.profile(for: connection.activeSession) }
+    var settingDefinitions: [CameraSettingDefinition] {
+        CameraSettingCatalog.visible(profile: cameraProfile, model: cameraModel, parameters: parameters)
+    }
+
+    var livePageIsPresented = false
+    private var frameInFlight = false
+    private var controlInFlight = false
+    private var autoParameterRefresh = true
+    @Published var status = "连接相机后可查看可用功能。"
+    private let connection: ConnectionViewModel
+    private let gallery: GalleryViewModel
+    private let downloads: DownloadManagerViewModel
+    private let shell: AppShellViewModel
+    private var liveTask: Task<Void, Never>?
+    private var watchTask: Task<Void, Never>?
+    private var healthTask: Task<Void, Never>?
+    private var monitorID: UUID?
+    private var foreground = true
+    private var wantsLive = false
+    private var wantsWatch = false
+
+    init(connection: ConnectionViewModel, gallery: GalleryViewModel, downloads: DownloadManagerViewModel, shell: AppShellViewModel) {
+        self.connection = connection; self.gallery = gallery; self.downloads = downloads; self.shell = shell
+    }
+    private var remote: (any CameraRemoteControlling)? { connection.sessionCoordinator.activeTransport as? any CameraRemoteControlling }
+    func supports(_ capability: CameraCapability) -> Bool { connection.activeSession?.capabilities.contains(capability) == true }
+
+    func startLive() {
+        guard foreground, !isBusy, !controlInFlight, !isScheduling, liveTask == nil, supports(.liveView), let remote, let sessionID = connection.activeSession?.id else { return }
+        guard !downloads.isDownloading, !gallery.isLoading else {
+            status = "请等待照片读取结束，并暂停下载后再开始取景。"; return
+        }
+        stopWatching(); isBusy = true; wantsLive = true; isStoppingLive = false
+        liveTask = Task { [weak self] in
+            guard let self else { return }
+            await self.watchTask?.value
+            do {
+                guard self.connection.activeSession?.id == sessionID, self.wantsLive else { throw CancellationError() }
+                try await remote.startLiveView()
+                guard self.connection.activeSession?.id == sessionID, self.wantsLive else { throw CancellationError() }
+                self.isLive = true; self.status = "实时取景中（实验）。"
+                self.autoParameterRefresh = true
+                self.focusStatus = "进入取景后读取遥控对焦能力。"
+                self.focusMarker = nil
+                await self.readParameters(remote, sessionID: sessionID, reportErrors: false)
+                if self.connection.activeSession?.id == sessionID { self.isBusy = false }
+                var lastParameterRead = Date()
+                var lastAnalysis = Date.distantPast
+                var unavailableFrames = 0
+                while self.wantsLive && self.connection.activeSession?.id == sessionID {
+                    // 参数读写在完整帧之间进行；不取消正在接收的帧，不截断 TCP 数据包。
+                    if self.isBusy { try await Task.sleep(nanoseconds: 30_000_000); continue }
+                    if self.autoParameterRefresh && Date().timeIntervalSince(lastParameterRead) >= 3 {
+                        self.isBusy = true
+                        await self.readParameters(remote, sessionID: sessionID, reportErrors: false, full: self.needsFullParameterRefresh)
+                        self.needsFullParameterRefresh = false
+                        self.focusCapabilities = await remote.focusCapabilities()
+                        if self.connection.activeSession?.id == sessionID { self.isBusy = false }
+                        lastParameterRead = Date()
+                        continue
+                    }
+                    do {
+                        self.frameInFlight = true
+                        defer { self.frameInFlight = false }
+                        let data = try await remote.liveViewFrame()
+                        guard self.connection.activeSession?.id == sessionID else { break }
+                        self.liveFrame = data; unavailableFrames = 0
+                        let histogram = UserDefaults.standard.bool(forKey:"liveHistogram.v1")
+                        let zebra = UserDefaults.standard.bool(forKey:"liveZebra.v1")
+                        if (histogram || zebra), Date().timeIntervalSince(lastAnalysis) >= 0.5 {
+                            let threshold = UserDefaults.standard.object(forKey:"liveZebraThreshold.v1") as? Int ?? 245
+                            let analysis = await self.frameAnalyzer.analyze(data, threshold:UInt8(clamping:threshold), includeZebra:zebra)
+                            if self.connection.activeSession?.id == sessionID {
+                                self.liveHistogram = analysis?.histogram ?? []; self.zebraFrame = analysis?.zebraPNG
+                            }
+                            lastAnalysis = Date()
+                        }
+                        if self.focusStatus == "进入取景后读取遥控对焦能力。" {
+                            self.focusCapabilities = await remote.focusCapabilities()
+                            self.focusStatus = self.focusCapabilities.reason
+                        }
+                    } catch let error as PTPIPError {
+                        if case .unexpectedResponse(let code) = error, code == 0x2019, unavailableFrames < 8 { unavailableFrames += 1 }
+                        else { throw error }
+                    }
+                    try await Task.sleep(nanoseconds: 120_000_000)
+                }
+            } catch is CancellationError {}
+            catch {
+                if self.connection.activeSession?.id == sessionID {
+                    self.status = "取景已停止：\(self.shell.userFacingMessage(for: error))"; self.shell.appendLog(self.status)
+                }
+            }
+            // 离开页面或点停止时，先等待已经发出的参数事务完整收尾。
+            while self.controlInFlight { try? await Task.sleep(nanoseconds: 20_000_000) }
+            await remote.stopLiveView()
+            self.isLive = false; self.liveFrame = nil; self.liveTask = nil; self.wantsLive = false
+            self.liveHistogram = []; self.zebraFrame = nil
+            self.frameInFlight = false; self.isStoppingLive = false
+            if self.status == "实时取景中（实验）。" || self.status == "正在停止实时取景…" { self.status = "实时取景已停止。" }
+            if self.connection.activeSession?.id == sessionID { self.isBusy = false }
+        }
+    }
+    // 让已经发送的命令完整收尾，避免取消读取而破坏共享 TCP 会话。
+    func stopLive() {
+        wantsLive = false
+        if liveTask != nil { isStoppingLive = true; status = "正在停止实时取景…" }
+    }
+    func shutter() {
+        guard foreground, !isBusy, !controlInFlight, !isStoppingLive, !isScheduling, supports(.capture), let remote, let sessionID = connection.activeSession?.id else { return }
+        isBusy = true; controlInFlight = true
+        Task {
+            defer { controlInFlight = false; isBusy = false }
+            do {
+                try await waitForFrameBoundary(sessionID)
+                try await remote.releaseShutter()
+                guard connection.activeSession?.id == sessionID else { return }
+                status = "已发送快门指令，请以相机实际拍摄结果为准。"
+            } catch { if connection.activeSession?.id == sessionID { status = shell.userFacingMessage(for: error); presentControlError(error) } }
+        }
+    }
+    private func presentControlError(_ error: Error) {
+        if livePageIsPresented {
+            let message = shell.userFacingMessage(for: error)
+            shell.appendLog(message); liveAlert = AlertContext(title: "出现问题", message: message)
+        } else { shell.handle(error) }
+    }
+    private func waitForFrameBoundary(_ sessionID: UUID) async throws {
+        while frameInFlight {
+            guard foreground, connection.activeSession?.id == sessionID else { throw CancellationError() }
+            try await Task.sleep(nanoseconds: 20_000_000)
+        }
+        guard foreground, connection.activeSession?.id == sessionID else { throw CancellationError() }
+    }
+    private func acceptParameters(_ result: [CameraParameter], replacing codes: Set<UInt16>? = nil) {
+        if let codes { parameters.removeAll { codes.contains($0.id) }; parameters.append(contentsOf: result) }
+        else { parameters = result }
+        parametersLoaded = true; parameterUpdatedAt = Date()
+        parameterStatus = parameters.isEmpty ? "相机未开放参数，请检查连接模式和拍摄模式。" : "常用曝光约每 3 秒同步；更多设置进入时读取，点刷新可重新读取全部设置。"
+    }
+    private func readParameters(_ remote: any CameraRemoteControlling, sessionID: UUID, reportErrors: Bool, full: Bool = true) async {
+        guard supports(.parameters) else { parameterStatus = "当前连接协议未开放相机参数。"; return }
+        do {
+            let codes = Set(CameraSettingCatalog.definitions(profile: cameraProfile)
+                .filter { $0.group == .core }.flatMap(\.codes))
+            let result: [CameraParameter]
+            if full { result = try await remote.cameraParameters() }
+            else { result = try await remote.cameraParameters(only: codes) }
+            guard connection.activeSession?.id == sessionID else { return }
+            acceptParameters(result, replacing: full ? nil : codes)
+        } catch {
+            guard connection.activeSession?.id == sessionID else { return }
+            // 错误后停止轮询，保留取景连接；由用户刷新重试，避免持续占用相机。
+            autoParameterRefresh = false
+            parameterStatus = "参数同步失败，显示值可能已过期。请刷新重试。"
+            shell.appendLog("相机参数读取失败：\(shell.userFacingMessage(for: error))")
+            if reportErrors { presentControlError(error) }
+        }
+    }
+    func refreshParameters() {
+        guard foreground, !isBusy, !controlInFlight, !isStoppingLive, supports(.parameters), let remote, let sessionID = connection.activeSession?.id else { return }
+        guard !downloads.isDownloading, !gallery.isLoading else {
+            parameterStatus = "请等待照片读取或下载结束后再刷新参数。"; return
+        }
+        isBusy = true; controlInFlight = true; autoParameterRefresh = true
+        Task {
+            defer { controlInFlight = false; isBusy = false }
+            do { try await waitForFrameBoundary(sessionID) } catch { return }
+            await readParameters(remote, sessionID: sessionID, reportErrors: true)
+        }
+    }
+    func setParameter(_ parameter: UInt16, choice: CameraParameterChoice) {
+        guard foreground, !isBusy, !controlInFlight, !isStoppingLive, let remote, let sessionID = connection.activeSession?.id,
+              let current = parameters.first(where: { $0.id == parameter }), current.canChange,
+              current.editableChoices.contains(where: { $0.data == choice.data }) else { return }
+        guard !downloads.isDownloading, !gallery.isLoading else {
+            parameterStatus = "请等待照片读取或下载结束后再调整参数。"; return
+        }
+        if current.current.data == choice.data { return }
+        isBusy = true; controlInFlight = true; parameterStatus = "正在设置\(current.title)，等待相机确认…"
+        Task {
+            defer { controlInFlight = false; isBusy = false }
+            do {
+                try await waitForFrameBoundary(sessionID)
+                try await remote.setCameraParameter(parameter, to: choice)
+                // 某些相机确认响应早于属性更新，最多回读三次；不自动重复写入。
+                for attempt in 0..<3 {
+                    guard foreground, connection.activeSession?.id == sessionID else { return }
+                    if attempt > 0 { try await Task.sleep(nanoseconds: 250_000_000) }
+                    let result = try await remote.cameraParameters(only: [parameter])
+                    guard connection.activeSession?.id == sessionID else { return }
+                    acceptParameters(result, replacing: [parameter])
+                    if let actual = result.first(where: { $0.id == parameter }), actual.confirms(choice) {
+                        needsFullParameterRefresh = true
+                        parameterStatus = "相机已确认：\(actual.title) · \(actual.current.title)"
+                        return
+                    }
+                }
+                parameterStatus = "相机回读值与选择不同，已显示实际返回值。请检查拍摄模式、拨盘或相机锁定状态。"
+                shell.appendLog(parameterStatus)
+            } catch {
+                guard connection.activeSession?.id == sessionID else { return }
+                // 写入失败也回读实际状态，不在界面假定设置成功。
+                if let result = try? await remote.cameraParameters(only: [parameter]), connection.activeSession?.id == sessionID {
+                    acceptParameters(result, replacing: [parameter])
+                }
+                guard connection.activeSession?.id == sessionID else { return }
+                parameterStatus = "设置未确认：\(shell.userFacingMessage(for: error))"
+                presentControlError(error)
+            }
+        }
+    }
+    func focus(at point: CameraFocusPoint? = nil) {
+        guard foreground, isLive, !isBusy, !controlInFlight, !isStoppingLive, let remote,
+              let sessionID = connection.activeSession?.id else { return }
+        guard point == nil ? focusCapabilities.autofocus : focusCapabilities.touchFocus else {
+            focusStatus = focusCapabilities.reason; return
+        }
+        isBusy = true; controlInFlight = true
+        focusStatus = "正在发送对焦指令…"
+        Task {
+            defer { controlInFlight = false; isBusy = false }
+            do {
+                try await waitForFrameBoundary(sessionID)
+                try await remote.focus(at: point)
+                guard connection.activeSession?.id == sessionID else { return }
+                focusMarker = point
+                focusStatus = point == nil ? "已发送半按对焦，请以机身合焦结果为准。" : "已发送焦点位置，请以机身实际焦点与合焦结果为准。"
+            } catch {
+                guard connection.activeSession?.id == sessionID else { return }
+                focusStatus = shell.userFacingMessage(for: error); presentControlError(error)
+            }
+        }
+    }
+    var canPrepareWorkflow: Bool { foreground && !isBusy && !isScheduling && !isWatching && !downloads.isDownloading && !gallery.isLoading }
+    var presetBrand: String { cameraProfile == .fuji ? "fuji" : cameraProfile == .nikon ? "nikon" : "standard" }
+    func savePreset(name: String, note: String, recipe: Bool) {
+        do {
+            guard parametersLoaded else { throw CameraAppError.unsupportedOperation("请先读取相机参数。") }
+            let values = parameters.filter { parameter in
+                guard parameter.canChange, parameter.editableChoices.contains(where: { $0.data == parameter.current.data }) else { return false }
+                if !recipe { return true }
+                let group = CameraSettingCatalog.definition(code:parameter.id, profile:cameraProfile)?.group
+                return group == .fuji || group == .whiteBalance || parameter.kind == .whiteBalance
+            }.map { SavedCameraValue(kind:$0.kind.rawValue, title:$0.title, data:$0.current.data) }
+            guard !values.isEmpty else { throw CameraAppError.unsupportedOperation("没有已确认且可写的当前参数可保存。") }
+            try WorkflowLibrary.shared.addPreset(SavedCameraPreset(name:name, note:note, model:cameraModel,
+                brand:presetBrand, recipe:recipe, values:values))
+            presetStatus = "已保存 \(values.count) 项\(recipe ? "配方" : "参数")，未包含只读和未知编码。"
+        } catch { presetStatus = shell.userFacingMessage(for:error) }
+    }
+    func applyPreset(_ preset: SavedCameraPreset) {
+        guard canPrepareWorkflow, let remote, let sessionID = connection.activeSession?.id else { return }
+        guard preset.brand == presetBrand, CameraSettingCatalog.compact(preset.model) == CameraSettingCatalog.compact(cameraModel) else {
+            presetStatus = "此预设来自 \(preset.model)，当前为 \(cameraModel)。型号不匹配，未写入。"; return
+        }
+        isBusy = true; controlInFlight = true
+        Task {
+            defer { isBusy = false; controlInFlight = false }
+            var applied = 0, skipped: [String] = []
+            do {
+                try await waitForFrameBoundary(sessionID)
+                // 白平衡、胶片等先设置；每项重新取描述，处理模式切换产生的依赖。
+                let ordered = preset.values.sorted { a,b in
+                    func rank(_ value: SavedCameraValue) -> Int {
+                        ["exposureMode","filmSimulation","pictureControl","whiteBalance","dynamicRangePriority"].firstIndex(of:value.kind) ?? 100
+                    }
+                    return rank(a) < rank(b)
+                }
+                for saved in ordered {
+                    guard foreground, connection.activeSession?.id == sessionID else { throw CancellationError() }
+                    presetStatus = "正在检查并应用：\(saved.title)…"
+                    guard let kind = CameraParameterKind(rawValue:saved.kind),
+                          let definition = CameraSettingCatalog.definitions(profile:cameraProfile).first(where: { $0.kind == kind }) else { skipped.append(saved.title); continue }
+                    let available = try await remote.cameraParameters(only:Set(definition.codes))
+                    guard let current = available.first(where: { $0.canChange && $0.editableChoices.contains(where: { $0.data == saved.data }) }),
+                          let choice = current.editableChoices.first(where: { $0.data == saved.data }) else { skipped.append(saved.title); continue }
+                    try await remote.setCameraParameter(current.id, to:choice)
+                    var confirmed = false
+                    for attempt in 0..<3 {
+                        if attempt > 0 { try await Task.sleep(nanoseconds:250_000_000) }
+                        let actual = try await remote.cameraParameters(only:[current.id])
+                        if actual.first(where: { $0.id == current.id })?.confirms(choice) == true { confirmed = true; break }
+                    }
+                    guard confirmed else { throw CameraAppError.unsupportedOperation("\(saved.title)回读未确认，已停止后续写入。此前已确认的设置保留；本操作不是一次性原子修改。") }
+                    applied += 1
+                }
+                await readParameters(remote, sessionID:sessionID, reportErrors:false)
+                presetStatus = "已确认 \(applied) 项；跳过 \(skipped.count) 项" + (skipped.isEmpty ? "。" : "：" + skipped.joined(separator:"、"))
+            } catch { presetStatus = "已确认 \(applied) 项后停止：\(shell.userFacingMessage(for:error))" }
+            shell.appendLog(presetStatus)
+        }
+    }
+    func startSchedule(delay: TimeInterval, interval: TimeInterval, count: Int) {
+        guard canPrepareWorkflow, !isLive, supports(.capture), let remote, let sessionID = connection.activeSession?.id,
+              (0...86400).contains(delay), (1...86400).contains(interval), (1...9999).contains(count) else { return }
+        let id = UUID(); scheduleID = id; isScheduling = true; scheduleCompleted = 0
+        scheduleTask = Task {
+            let previousIdle = UIApplication.shared.isIdleTimerDisabled
+            UIApplication.shared.isIdleTimerDisabled = true
+            defer {
+                UIApplication.shared.isIdleTimerDisabled = previousIdle
+                isScheduling = false; scheduleTask = nil; scheduleID = nil
+            }
+            do {
+                for index in 0..<count {
+                    let deadline = ProcessInfo.processInfo.systemUptime + (index == 0 ? delay : interval)
+                    while ProcessInfo.processInfo.systemUptime < deadline {
+                        guard scheduleID == id, foreground, connection.activeSession?.id == sessionID else { throw CancellationError() }
+                        scheduleStatus = "等待 \(Int(ceil(deadline - ProcessInfo.processInfo.systemUptime))) 秒 · 已发送 \(scheduleCompleted)/\(count) 张"
+                        try await Task.sleep(nanoseconds:200_000_000)
+                    }
+                    guard scheduleID == id, foreground, connection.activeSession?.id == sessionID else { throw CancellationError() }
+                    guard !downloads.isDownloading, !gallery.isLoading else {
+                        throw CameraAppError.unsupportedOperation("照片读取或下载正在占用相机，拍摄计划已停止。")
+                    }
+                    isBusy = true; controlInFlight = true
+                    do { try await remote.releaseShutter() }
+                    catch { isBusy = false; controlInFlight = false; throw error }
+                    isBusy = false; controlInFlight = false; scheduleCompleted += 1
+                }
+                scheduleStatus = "计划完成，已发送 \(scheduleCompleted) 次快门指令；实际成片以相机为准。"
+            } catch is CancellationError { scheduleStatus = "计划已停止，已发送 \(scheduleCompleted) 次；已发出的快门不会撤回。" }
+            catch { scheduleStatus = "计划已停止（不重发快门）：\(shell.userFacingMessage(for:error))" }
+            shell.appendLog(scheduleStatus)
+        }
+    }
+    func stopSchedule() { scheduleID = nil; if !controlInFlight { scheduleTask?.cancel() } }
+    func capabilityReport() -> String {
+        var lines = ["Nikon Connect 0.3.0 · 机型能力与连接报告", "生成时间：\(Date().formatted())", "机型：\(cameraModel)",
+                     "状态：\(status)", "参数状态：\(parameterStatus)", "参数读取时间：\(parameterUpdatedAt?.formatted() ?? "尚未读取")",
+                     "说明：能力是协议报告和当前状态，不是实际相机功能验证；未知编码禁止写入。", ""]
+        for capability in CameraCapability.allCases { lines.append("\(capability.title)：\(supports(capability) ? "协议提供" : "当前未提供")") }
+        lines += ["自动对焦：\(focusCapabilities.autofocus ? "协议提供" : "未开放")", "点击对焦：\(focusCapabilities.touchFocus ? "协议提供" : "未开放")", focusCapabilities.reason, "", "逐项参数："]
+        for item in settingDefinitions {
+            if let p = parameters.first(where: { item.codes.contains($0.id) }) {
+                lines.append("\(item.title)：\(p.current.title) / \(p.availabilityTitle) / \(p.restriction ?? "可修改")")
+            } else { lines.append("\(item.title)：\(item.limitation ?? "尚未读取或当前连接未开放")") }
+        }
+        lines += ["", "近期运行记录（不包含 Wi-Fi 密码）："]
+        lines += shell.activityLog.map { "\($0.timestamp.formatted()) \($0.message)" }
+        return lines.joined(separator:"\n")
+    }
+    func startWatching(resuming: Bool = false) {
+        guard watchTask == nil, !isLive, liveTask == nil, !isBusy, !isScheduling, supports(.watchCapture),
+              let remote, let session = connection.activeSession else { return }
+        wantsWatch = true; isWatching = true; status = "建立存储卡基线中，已有照片不会自动下载。"
+        watchTask = Task { [weak self] in
+            guard let self else { return }
+            defer { self.isWatching = false; self.watchTask = nil }
+            do {
+                guard self.wantsWatch else { return }
+                let snapshot = try await self.gallery.completeLibrarySnapshot(keepGoing: { self.wantsWatch && self.foreground })
+                guard self.wantsWatch, self.connection.activeSession?.id == session.id else { return }
+                let keys = Set(snapshot.compactMap(\.libraryFingerprint))
+                if resuming, self.watchBaselineIdentity == session.persistentIdentity, let known = self.watchKnownFingerprints {
+                    let missed = snapshot.filter { $0.libraryFingerprint.map { !known.contains($0) } ?? false }
+                    if !missed.isEmpty {
+                        _ = await self.downloads.enqueueDownloads(missed, autoExportToPhotoLibrary:self.connection.autoExportToPhotoLibrary,
+                            prioritizeJPEGDownloads:self.connection.prioritizeJPEGDownloads)
+                        self.shell.appendLog("身份核对通过，已补入断线期间的 \(missed.count) 个文件。")
+                    }
+                }
+                self.watchKnownFingerprints = keys.count == snapshot.count ? keys : nil
+                self.watchBaselineIdentity = session.persistentIdentity
+                if self.watchKnownFingerprints == nil {
+                    self.shell.appendLog("部分文件缺少稳定身份，自动补传已禁用；边拍边传继续运行。")
+                }
+                await remote.beginCaptureWatch()
+                _ = try await remote.newlyCapturedAssets(in: session)
+                guard self.wantsWatch, self.connection.activeSession?.id == session.id else { return }
+                self.status = "正在监测新照片，请保持应用在前台。"
+                while self.wantsWatch {
+                    try await Task.sleep(nanoseconds: 3_000_000_000)
+                    guard self.wantsWatch, self.connection.activeSession?.id == session.id else { return }
+                    if self.downloads.isDownloading || self.gallery.isLoading || self.isLive || self.isBusy { continue }
+                    let incoming = try await remote.newlyCapturedAssets(in: session)
+                    guard self.wantsWatch, self.connection.activeSession?.id == session.id else { return }
+                    if !incoming.isEmpty {
+                        self.gallery.mergeNewCaptures(incoming)
+                        let queued = await self.downloads.enqueueDownloads(incoming,
+                            autoExportToPhotoLibrary: self.connection.autoExportToPhotoLibrary,
+                            prioritizeJPEGDownloads: self.connection.prioritizeJPEGDownloads)
+                        if queued { self.watchKnownFingerprints?.formUnion(incoming.compactMap(\.libraryFingerprint)) }
+                        self.status = "发现 \(incoming.count) 个新文件，已加入队列。"
+                    }
+                }
+            } catch {
+                if self.connection.activeSession?.id == session.id {
+                    self.status = "边拍边传已暂停：\(self.shell.userFacingMessage(for: error))"; self.shell.appendLog(self.status)
+                }
+            }
+        }
+    }
+    func stopWatching() {
+        wantsWatch = false
+        if let remote { Task { await remote.stopCaptureWatch() } }
+    }
+    func sessionChanged() {
+        guard !isRecovering else { return }
+        stopSchedule()
+        stopWatching(); stopLive(); parameters = []; parametersLoaded = false; parameterUpdatedAt = nil
+        focusCapabilities = CameraFocusCapabilities(); focusMarker = nil; focusStatus = "进入取景后读取遥控对焦能力。"
+        needsFullParameterRefresh = false
+        parameterStatus = "进入实时取景后自动读取相机参数。"; isBusy = controlInFlight; monitorID = nil
+        if connection.activeSession != nil && foreground { startHealthMonitor() }
+        else { status = "相机已断开。" }
+    }
+    func pauseForBackground() {
+        foreground = false; stopSchedule(); stopWatching(); stopLive(); monitorID = nil
+        if isRecovering { connection.stopConnecting() }
+        status = "应用进入后台，已停止监测和取景。回到前台后可重新开启。"
+    }
+    func resumeForeground() {
+        foreground = true
+        if connection.activeSession != nil { startHealthMonitor() }
+    }
+    func stopRecovery() {
+        monitorID = nil; connection.stopConnecting()
+        status = "已停止自动重连，可手动连接相机。"
+    }
+    private func startHealthMonitor() {
+        let id = UUID(); monitorID = id
+        healthTask = Task { [weak self] in
+            guard let self else { return }
+            while self.monitorID == id && self.foreground {
+                do {
+                    try await Task.sleep(nanoseconds: 15_000_000_000)
+                    guard self.monitorID == id, self.foreground,
+                          let session = self.connection.activeSession,
+                          let transport = self.connection.sessionCoordinator.activeTransport as? any CameraConnectionChecking else { return }
+                    if self.downloads.isDownloading || self.gallery.isLoading || self.isBusy || self.isLive || self.isWatching { continue }
+                    do { try await transport.checkConnection() }
+                    catch {
+                        guard self.connection.activeSession?.id == session.id, self.monitorID == id, self.foreground else { return }
+                        if let error = error as? PTPIPError, case .unexpectedResponse(let code) = error, [0x2005, 0x200a, 0x2019].contains(code) { continue }
+                        await self.recoverConnection(previousIdentity: session.persistentIdentity, monitor: id)
+                        guard self.monitorID == id, self.connection.activeSession != nil else { return }
+                    }
+                } catch { return }
+            }
+        }
+    }
+    private func recoverConnection(previousIdentity: String, monitor: UUID) async {
+        isRecovering = true
+        defer { isRecovering = false }
+        let resumeWatch = wantsWatch
+        stopSchedule(); stopWatching(); stopLive()
+        await watchTask?.value
+        await liveTask?.value
+        downloads.interruptActiveDownload(reason: "相机连接中断，等待重新连接。")
+        let stopCounter = connection.userStopCounter
+        await connection.disconnectForRecovery()
+        gallery.resetForDisconnectedSession()
+        guard monitorID == monitor, foreground, connection.userStopCounter == stopCounter else { return }
+        let autoReconnect = UserDefaults.standard.object(forKey: "autoReconnectCamera") as? Bool ?? true
+        guard autoReconnect else { status = "检测到连接已断开，请手动重连。"; return }
+        for attempt in 1...3 {
+            status = "连接已断开，准备第 \(attempt)/3 次重连。"; shell.appendLog(status)
+            do { try await Task.sleep(nanoseconds: UInt64(1 << (attempt - 1)) * 1_000_000_000) }
+            catch { return }
+            guard monitorID == monitor, foreground, connection.userStopCounter == stopCounter else { return }
+            let connected = await connection.connect(quietly: true)
+            guard monitorID == monitor, foreground, connection.userStopCounter == stopCounter else { return }
+            if connected {
+                guard connection.activeSession?.persistentIdentity == previousIdentity else {
+                    connection.disconnect(); status = "重连后的相机身份无法确认，已停止恢复下载。"; return
+                }
+                status = resumeWatch ? "已核对同一台相机，准备扫描漏传照片。" : "已核对同一台相机，恢复中断的下载队列。"
+                await gallery.refreshPhotos()
+                if downloads.canAutomaticallyRecoverQueue { await downloads.startQueueIfPossible() }
+                if resumeWatch {
+                    // 先恢复队列；等当前文件传输结束后再占用相机做整卡补传扫描。
+                    while downloads.isDownloading {
+                        guard monitorID == monitor, foreground, connection.userStopCounter == stopCounter else { return }
+                        try? await Task.sleep(nanoseconds:250_000_000)
+                    }
+                    startWatching(resuming:true)
+                }
+                startHealthMonitor()
+                return
+            }
+        }
+        status = "三次重连未成功。请确认相机未休眠、手机仍连接相机 Wi-Fi，再手动连接。"
+    }
+}
