diff --git a/Services/ExperimentalCanonTransport.swift b/Services/ExperimentalCanonTransport.swift
new file mode 100644
index 0000000..edcaa41
--- /dev/null
+++ b/Services/ExperimentalCanonTransport.swift
@@ -0,0 +1,105 @@
+import Foundation
+
+actor ExperimentalCanonTransport: CameraTransport, CameraConnectionChecking {
+    private var client: CameraHTTPClient?
+    private var contentsPath = ""
+    private var containers: [(path: String, page: Int, pages: Int)] = []
+    private var files: [String] = []
+    private var visited: Set<String> = []
+    private var seenFiles: Set<String> = []
+
+    func connect(using config: CameraConnectionConfig) async throws -> CameraSession {
+        let http = try CameraHTTPClient(host: config.normalizedHost, port: config.port)
+        do {
+            let advertised = try await http.json("/ccapi")
+            let endpoints = advertised.object.values.flatMap(\.array)
+            guard let infoPath = endpoints.compactMap({ $0["url"].string }).first(where: { $0.hasSuffix("/deviceinformation") }),
+                  let listPath = endpoints.compactMap({ $0["url"].string }).first(where: { $0.hasSuffix("/contents") }) else {
+                throw CameraAppError.unsupportedOperation("相机没有公布 CCAPI 设备信息和照片接口。请在相机菜单中启用 CCAPI。")
+            }
+            let info = try await http.json(infoPath)
+            try Task.checkCancellation()
+            client = http; contentsPath = listPath
+            let name = info["productname"].string ?? "佳能相机"
+            return CameraSession(cameraName: name, connectedHost: config.normalizedHost, port: config.port,
+                capabilities: [.connectionProbe, .listAssets, .downloadAssets],
+                persistentIdentity: "canon|\(name)|\(info["serialnumber"].string ?? info["guid"].string ?? UUID().uuidString)")
+        } catch { http.close(); throw error }
+    }
+
+    func fetchAssetsPage(for session: CameraSession, resetTraversal: Bool, limit: Int) async throws -> PhotoAssetPage {
+        guard let client else { throw CameraAppError.notConnected }
+        if resetTraversal { containers = [(contentsPath, 0, 0)]; files = []; visited = []; seenFiles = [] }
+        var result: [PhotoAsset] = []
+        while result.count < max(limit, 1) {
+            try Task.checkCancellation()
+            if !files.isEmpty {
+                let path = files[0]
+                let info = try await client.json(path, query: "kind=info")
+                let name = (path as NSString).lastPathComponent
+                files.removeFirst()
+                guard let kind = CameraMediaFormat.kind(for: name) else { continue }
+                // CCAPI 文件信息提供修改时间；此字段在产品界面标为相机文件时间。
+                result.append(PhotoAsset(remoteIdentifier: path, fileName: name, kind: kind,
+                    byteSize: info["filesize"].integer ?? 0,
+                    captureDate: CameraHTTPClient.date(info["lastmodifieddate"].string),
+                    sourceScope: session.persistentIdentity, directoryIdentifier: (path as NSString).deletingLastPathComponent))
+                continue
+            }
+            guard !containers.isEmpty else { break }
+            var container = containers[0]
+            if container.page == 0 {
+                guard visited.insert(container.path).inserted else { containers.removeFirst(); continue }
+                // 有的根目录不支持 kind=number，仅对这类目录使用无分页列表。
+                do {
+                    let count = try await client.json(container.path, query: "kind=number")
+                    let pages = count["pagenumber"].integer ?? 0
+                    guard pages >= 0, pages <= 100000 else { throw PTPIPError.malformedPayload("佳能分页数量无效") }
+                    container.pages = Int(pages)
+                } catch let error as CameraAppError {
+                    if case .networkProbeFailed(let detail) = error, detail.contains("404") || detail.contains("400") {
+                        container.pages = 0
+                    } else { throw error }
+                }
+                container.page = 1
+            }
+            let body = try await client.json(container.path, query: container.pages > 0 ? "page=\(container.page)" : nil)
+            let paths = (body["path"].array + body["url"].array).compactMap(\.string)
+            for reference in paths {
+                let url = try client.url(reference)
+                let path = url.path
+                guard path.hasPrefix("/ccapi/") else { throw PTPIPError.malformedPayload("佳能文件路径无效") }
+                if CameraMediaFormat.kind(for: path) != nil {
+                    if seenFiles.insert(path).inserted { files.append(path) }
+                } else if !visited.contains(path) { containers.append((path, 0, 0)) }
+            }
+            if container.pages > 0 && container.page < container.pages {
+                container.page += 1; containers[0] = container
+            } else { containers.removeFirst() }
+        }
+        return PhotoAssetPage(assets: result, hasMore: !files.isEmpty || !containers.isEmpty)
+    }
+    func downloadThumbnail(_ asset: PhotoAsset, from session: CameraSession) async throws -> Data? {
+        guard let client else { throw CameraAppError.notConnected }
+        return try await client.thumbnail(asset.remoteIdentifier, query: "kind=thumbnail")
+    }
+    func downloadAsset(_ asset: PhotoAsset, from session: CameraSession) async throws -> Data {
+        let file = try await downloadAssetToTemporaryFile(asset, from: session)
+        defer { try? FileManager.default.removeItem(at: file) }; return try Data(contentsOf: file)
+    }
+    func downloadAssetToTemporaryFile(_ asset: PhotoAsset, from session: CameraSession) async throws -> URL {
+        try await downloadAssetToTemporaryFile(asset, from: session, onProgress: nil)
+    }
+    func downloadAssetToTemporaryFile(_ asset: PhotoAsset, from session: CameraSession,
+        onProgress: (@Sendable (DownloadTransferProgress) async -> Void)?) async throws -> URL {
+        guard let client else { throw CameraAppError.notConnected }
+        return try await client.download(asset.remoteIdentifier, expectedSize: asset.byteSize, progress: onProgress)
+    }
+    func downloadTransferMode(for asset: PhotoAsset) async -> DownloadThroughputTransferMode { .httpStream }
+    func disconnect() async { client?.close(); client = nil }
+    func checkConnection() async throws {
+        guard let client else { throw CameraAppError.notConnected }
+        _ = try await client.json("/ccapi")
+    }
+    func consumeDiagnostics() async -> [String] { [] }
+}
diff --git a/Services/ExperimentalFujiTransport.swift b/Services/ExperimentalFujiTransport.swift
new file mode 100644
index 0000000..df0ac59
--- /dev/null
+++ b/Services/ExperimentalFujiTransport.swift
@@ -0,0 +1,338 @@
+// 富士无线协议参考 libfuji（MIT），网络、状态和 Swift 接口由本项目实现。
+import Foundation
+
+actor ExperimentalFujiTransport: CameraRemoteControlling, CameraConnectionChecking {
+    private let xapp: Bool
+    private var wire: PTPIPTCPConnection?
+    private var eventWire: PTPIPTCPConnection?
+    private var videoWire: PTPIPTCPConnection?
+    private var nextTransaction: UInt32 = 1
+    private var liveTransaction: UInt32?
+    private var isTransferring = false
+    private var busy = false
+    private var waiters: [CheckedContinuation<Void, Never>] = []
+    private var cameraSession: CameraSession?
+    private var events: [UInt16: UInt32] = [:]
+    private var handles: [UInt32] = []
+    private var cursor = 0
+    private var pairedBluetoothID: String?
+    private var watchCount: Int?
+    private var watchEdgeKeys: [String] = []
+    private var watchPoll = 0
+    private var watchEnabled = false
+    private var watchBaseline: Set<String>?
+    private var diagnostics: [String] = []
+    private let parser = PTPIPSession(host: "localhost", port: 1)
+
+    init(xapp: Bool = true) { self.xapp = xapp }
+
+    func connect(using config: CameraConnectionConfig) async throws -> CameraSession {
+        guard (1...65535).contains(config.port), !config.normalizedHost.isEmpty else { throw CameraAppError.invalidPort }
+        let connection = PTPIPTCPConnection(host: config.normalizedHost, port: UInt16(config.port))
+        wire = connection
+        do {
+            return try await withTaskCancellationHandler {
+                try await connection.open()
+                var initPacket = Data()
+                for value: UInt32 in [82, 1, 0x8f53e4f2, 0x5d48a5ad, 0x0b7fb287, 0xd0ded5d3, 0] {
+                    initPacket.appendUInt32LE(value)
+                }
+                var name = PTPIPBinary.encodeUTF16NullTerminatedString("CameraConnect iOS")
+                name.append(Data(repeating: 0, count: max(54 - name.count, 0)))
+                initPacket.append(name.prefix(54))
+                try await connection.send(initPacket)
+                var header = PTPDataReader(data: try await connection.readRaw(length: 8))
+                let length = Int(try header.readUInt32()), type = try header.readUInt32()
+                guard length >= 28, length <= 512, type == 2 else { throw PTPIPError.malformedPayload("富士拒绝无线握手，请在相机上确认连接。") }
+                let payload = try await connection.readRaw(length: length - 8)
+                let cameraName = PTPIPBinary.decodeUTF16NullTerminated(Data(payload.dropFirst(20)))
+                try await Task.sleep(nanoseconds: 70_000_000)
+                _ = try await transaction(0x1002, parameters: [1])
+                try await updateEvents()
+                let accessDeadline = Date().addingTimeInterval(30)
+                while events[0xdf00] == 0 && Date() < accessDeadline {
+                    try await Task.sleep(nanoseconds: 300_000_000); try await updateEvents()
+                }
+                guard events[0xdf00] != 0 else { throw PTPIPError.timeout("请在富士相机屏幕允许访问") }
+                let remoteVersion = try await property(0xdf24)
+                try await set16(0xdf01, xapp ? 20 : 5)
+                if xapp { try await configureXAppGallery() }
+                else { try await set32(0xdf24, min(remoteVersion, 0x2000c)); try await set32(0xdf25, 5) }
+                try await set16(0xd226, xapp ? 2 : 0)
+                try await set16(0xd227, 1)
+                var resolvedModel = cameraName.isEmpty ? "富士相机" : cameraName
+                var identity = resolvedModel
+                if let raw = try? await transaction(0x1001), let info = try? await parser.parseDeviceInfo(raw) {
+                    resolvedModel = info.model ?? resolvedModel
+                    let bluetoothID = await FujiBluetoothController.shared.connectedIdentifier
+                    identity = "\(resolvedModel)|\(info.serialNumber ?? bluetoothID ?? UUID().uuidString)"
+                } else {
+                    let bluetoothID = await FujiBluetoothController.shared.connectedIdentifier
+                    identity += "|\(bluetoothID ?? UUID().uuidString)"
+                }
+                let session = CameraSession(cameraName: resolvedModel,
+                    connectedHost: config.normalizedHost, port: config.port,
+                    capabilities: [.connectionProbe, .listAssets, .downloadAssets, .liveView, .capture, .parameters, .watchCapture],
+                    persistentIdentity: "fuji|\(identity)")
+                pairedBluetoothID = await FujiBluetoothController.shared.connectedIdentifier
+                cameraSession = session; try Task.checkCancellation()
+                diagnostics.append("富士 \(xapp ? "XApp" : "传统无线") 实验通道；拍摄功能以 X-T30 III 为适配目标，未经真机验证。")
+                return session
+            } onCancel: { Task { await connection.close() } }
+        } catch { await disconnect(); throw error }
+    }
+
+    private func configureXAppGallery() async throws {
+        let version = try await property(0xdf28); try await set32(0xdf28, version)
+        try await set16(0xd226, 0); try await set16(0xd227, 0)
+        _ = try await transaction(0x9054, parameters: [0x10000001])
+        _ = try await transaction(0x9055, parameters: [0x10000001])
+        _ = try await transaction(0x9050)
+        _ = try await property(0xd22b)
+        _ = try await transaction(0x9053, parameters: [0, 30000])
+        _ = try await property(0xd620)
+        _ = try await transaction(0x1015, parameters: [0xd621])
+    }
+
+    private func transaction(_ code: UInt16, parameters: [UInt32] = [], output: Data? = nil) async throws -> Data {
+        await acquire(); defer { release() }; try Task.checkCancellation()
+        guard let wire else { throw CameraAppError.notConnected }
+        let id = nextTransaction; nextTransaction &+= 1
+        if code == 0x101c { liveTransaction = id }
+        func packet(type: UInt16, body: Data) -> Data {
+            var data = Data(); data.appendUInt32LE(UInt32(12 + body.count)); data.appendUInt16LE(type)
+            data.appendUInt16LE(code); data.appendUInt32LE(id); data.append(body); return data
+        }
+        var params = Data(); for value in parameters { params.appendUInt32LE(value) }
+        try await wire.send(packet(type: 1, body: params))
+        if let output { try await wire.send(packet(type: 2, body: output)) }
+        var collected = Data()
+        while true {
+            var header = PTPDataReader(data: try await wire.readRaw(length: 12, timeout: 15))
+            let size = Int(try header.readUInt32()), type = try header.readUInt16()
+            let responseCode = try header.readUInt16(), receivedID = try header.readUInt32()
+            guard size >= 12, size <= 32 * 1024 * 1024, receivedID == id else { throw PTPIPError.malformedPayload("富士数据包编号或长度不符") }
+            let payload = try await wire.readRaw(length: size - 12, timeout: 30)
+            if type == 3 {
+                guard responseCode == 0x2001 || (code == 0x1002 && responseCode == 0x201e) else {
+                    throw PTPIPError.unexpectedResponse(code: responseCode)
+                }
+                return collected
+            }
+            guard type == 2, responseCode == code, collected.count + payload.count <= 32 * 1024 * 1024 else {
+                throw PTPIPError.malformedPayload("富士返回了无效的数据阶段")
+            }
+            collected.append(payload)
+        }
+    }
+    private func acquire() async {
+        if !busy { busy = true; return }
+        await withCheckedContinuation { waiters.append($0) }
+    }
+    private func release() { if waiters.isEmpty { busy = false } else { waiters.removeFirst().resume() } }
+    private func property(_ code: UInt16) async throws -> UInt32 {
+        let data = try await transaction(0x1015, parameters: [UInt32(code)])
+        var r = PTPDataReader(data: data)
+        return data.count >= 4 ? try r.readUInt32() : UInt32(try r.readUInt16())
+    }
+    private func set16(_ code: UInt16, _ value: UInt16) async throws {
+        var data = Data(); data.appendUInt16LE(value)
+        _ = try await transaction(0x1016, parameters: [UInt32(code)], output: data)
+    }
+    private func set32(_ code: UInt16, _ value: UInt32) async throws {
+        var data = Data(); data.appendUInt32LE(value)
+        _ = try await transaction(0x1016, parameters: [UInt32(code)], output: data)
+    }
+    private func updateEvents() async throws {
+        let data = try await transaction(0x1015, parameters: [0xd212])
+        var r = PTPDataReader(data: data); let count = Int(try r.readUInt16())
+        guard count <= r.remainingCount / 6 else { throw PTPIPError.malformedPayload("富士事件列表不完整") }
+        for _ in 0..<count { let code = try r.readUInt16(); events[code] = try r.readUInt32() }
+    }
+    private func objectHandles() async throws -> [UInt32] {
+        try await updateEvents()
+        let count = xapp ? (try await property(0xd620)) : (events[0xd222] ?? 0)
+        guard count <= 500000 else { throw PTPIPError.malformedPayload("富士对象数量无效") }
+        return count == 0 ? [] : Array(1...count)
+    }
+    private func asset(handle: UInt32, session: CameraSession) async throws -> PhotoAsset? {
+        let data = try await transaction(0x1008, parameters: [handle])
+        let info = try await parser.parseObjectInfo(data: data, handle: handle)
+        guard info.objectFormat != 0x3001, let kind = CameraMediaFormat.kind(for: info.fileName) else { return nil }
+        return PhotoAsset(remoteIdentifier: String(handle), fileName: info.fileName, kind: kind,
+            byteSize: Int64(info.compressedSize), captureDate: info.captureDate ?? info.modificationDate ?? .distantPast,
+            thumbnailInfo: info.thumbnailInfo, sourceScope: session.persistentIdentity,
+            directoryIdentifier: "\(info.storageID)/\(info.parentObject)")
+    }
+    func fetchAssetsPage(for session: CameraSession, resetTraversal: Bool, limit: Int) async throws -> PhotoAssetPage {
+        guard liveTransaction == nil else { throw CameraAppError.unsupportedOperation("富士实时取景期间请先停止取景，再读取存储卡。") }
+        if resetTraversal { handles = try await objectHandles(); cursor = 0 }
+        var result: [PhotoAsset] = []
+        while cursor < handles.count, result.count < max(limit, 1) {
+            if let photo = try await asset(handle: handles[cursor], session: session) { result.append(photo) }
+            cursor += 1
+        }
+        return PhotoAssetPage(assets: result, hasMore: cursor < handles.count)
+    }
+    func downloadThumbnail(_ asset: PhotoAsset, from session: CameraSession) async throws -> Data? {
+        guard liveTransaction == nil, let handle = UInt32(asset.remoteIdentifier) else { return nil }
+        return try await transaction(0x100a, parameters: [handle])
+    }
+    func downloadAsset(_ asset: PhotoAsset, from session: CameraSession) async throws -> Data {
+        let url = try await downloadAssetToTemporaryFile(asset, from: session)
+        defer { try? FileManager.default.removeItem(at: url) }; return try Data(contentsOf: url)
+    }
+    func downloadAssetToTemporaryFile(_ asset: PhotoAsset, from session: CameraSession) async throws -> URL {
+        try await downloadAssetToTemporaryFile(asset, from: session, onProgress: nil)
+    }
+    func downloadAssetToTemporaryFile(_ asset: PhotoAsset, from session: CameraSession,
+        onProgress: (@Sendable (DownloadTransferProgress) async -> Void)?) async throws -> URL {
+        guard liveTransaction == nil, !isTransferring else { throw CameraAppError.unsupportedOperation("请先停止富士实时取景，再传输文件。") }
+        guard let handle = UInt32(asset.remoteIdentifier), asset.byteSize > 0, asset.byteSize <= Int64(UInt32.max) else {
+            throw CameraAppError.unsupportedOperation("此富士传输通道需要有效文件大小，单文件最大为 4 GiB。")
+        }
+        isTransferring = true; defer { isTransferring = false }
+        let refreshed = try await self.asset(handle: handle, session: session)
+        guard refreshed?.libraryFingerprint == asset.libraryFingerprint, asset.libraryFingerprint != nil else {
+            throw CameraAppError.unsupportedOperation("富士列表已变化，请重新读取照片后下载。")
+        }
+        let url = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString + ".camera")
+        FileManager.default.createFile(atPath: url.path, contents: nil)
+        let file = try FileHandle(forWritingTo: url); var offset: UInt32 = 0
+        do {
+            while Int64(offset) < asset.byteSize {
+                try Task.checkCancellation()
+                let size = UInt32(min(1_048_576, asset.byteSize - Int64(offset)))
+                let data = try await transaction(0x101b, parameters: [handle, offset, size])
+                guard !data.isEmpty, data.count <= Int(size) else { throw PTPIPError.malformedPayload("富士文件块长度不符") }
+                try file.write(contentsOf: data); offset += UInt32(data.count)
+                await onProgress?(DownloadTransferProgress(bytesTransferred: Int64(offset), totalBytes: asset.byteSize,
+                    resumedCount: 0, currentOffset: Int64(offset), chunkSize: Int64(data.count)))
+            }
+            try file.close(); return url
+        } catch { try? file.close(); try? FileManager.default.removeItem(at: url); throw error }
+    }
+    func startLiveView() async throws {
+        guard let session = cameraSession, !isTransferring, liveTransaction == nil else {
+            throw CameraAppError.unsupportedOperation("请等待当前富士传输结束。")
+        }
+        try await set16(0xdf00, 6); try await set16(0xdf01, xapp ? 22 : 5)
+        if xapp { let version = try await property(0xdf2a); try await set32(0xdf2a, version) }
+        do {
+            _ = try await transaction(0x101c, parameters: [0, 0])
+            try await Task.sleep(nanoseconds: 70_000_000)
+            let event = PTPIPTCPConnection(host: session.connectedHost, port: 55741)
+            eventWire = event; try await event.open()
+            let video = PTPIPTCPConnection(host: session.connectedHost, port: 55742)
+            videoWire = video; try await video.open()
+        } catch { await stopLiveView(); throw error }
+    }
+    func liveViewFrame() async throws -> Data {
+        guard liveTransaction != nil, let videoWire else { throw CameraAppError.notConnected }
+        var header = PTPDataReader(data: try await videoWire.readRaw(length: 18, timeout: 5))
+        let length = Int(try header.readUInt32())
+        guard length >= 18, length <= 8 * 1024 * 1024 else { throw PTPIPError.invalidPacketLength }
+        return try CameraMediaFormat.jpeg(in: await videoWire.readRaw(length: length - 18, timeout: 5))
+    }
+    func stopLiveView() async {
+        guard liveTransaction != nil || videoWire != nil else { return }
+        await videoWire?.close(); await eventWire?.close(); videoWire = nil; eventWire = nil
+        if let liveTransaction { _ = try? await transaction(0x1018, parameters: [liveTransaction]) }
+        liveTransaction = nil
+        if wire != nil {
+            try? await set16(0xdf00, 6); try? await set16(0xdf01, xapp ? 20 : 11)
+            if xapp { try? await configureXAppGallery() }
+            try? await set16(0xd226, xapp ? 2 : 0); try? await set16(0xd227, 1)
+        }
+    }
+    func releaseShutter() async throws {
+        let current = await FujiBluetoothController.shared.connectedIdentifier
+        guard let pairedBluetoothID, current == pairedBluetoothID else {
+            throw CameraAppError.unsupportedOperation("请先配对当前富士相机的蓝牙，再建立 Wi-Fi 连接。")
+        }
+        try await FujiBluetoothController.shared.releaseShutter()
+    }
+    func cameraParameters() async throws -> [CameraParameter] {
+        let definitions = CameraParameterDecoder.definitions(profile: .fuji)
+        var result: [CameraParameter] = []
+        // 富士 0x902b 返回带长度前缀的一组 PTP 属性描述。
+        let bulk = try await transaction(0x902b)
+        var r = PTPDataReader(data: bulk); let count = Int(try r.readUInt32())
+        guard count <= 2048 else { throw PTPIPError.malformedPayload("富士属性列表过长") }
+        for _ in 0..<count {
+            let length = Int(try r.readUInt32())
+            guard length >= 9 else { throw PTPIPError.malformedPayload("富士属性长度无效") }
+            let body = try r.readData(count: length - 4)
+            var descriptor = PTPDataReader(data: body); let code = try descriptor.readUInt16()
+            if let title = definitions.first(where: { $0.0 == code })?.1 {
+                do {
+                    result.append(try CameraParameterDecoder.decode(body, code: code, title: title,
+                        profile: .fuji, model: cameraSession?.cameraName ?? ""))
+                } catch CameraAppError.unsupportedOperation(let reason) {
+                    result.append(CameraParameter(id: code, title: title,
+                        current: .init(data: Data(), title: "数据格式未支持", recognized: false), choices: [], writable: false,
+                        profile: .fuji, unavailableReason: reason))
+                }
+            }
+        }
+        return CameraParameterDecoder.preferred(result, profile: .fuji)
+    }
+    func setCameraParameter(_ parameter: UInt16, to choice: CameraParameterChoice) async throws {
+        let parameters = try await cameraParameters()
+        guard let current = parameters.first(where: { $0.id == parameter }), current.canChange,
+              current.editableChoices.contains(where: { $0.data == choice.data }) else {
+            throw CameraAppError.unsupportedOperation("富士相机当前模式不允许设置该参数。")
+        }
+        if current.current.data == choice.data { return }
+        _ = try await transaction(0x1016, parameters: [UInt32(parameter)], output: choice.data)
+    }
+    func focusCapabilities() async -> CameraFocusCapabilities {
+        let current = await FujiBluetoothController.shared.connectedIdentifier
+        let ready = pairedBluetoothID != nil && current == pairedBluetoothID
+        return CameraFocusCapabilities(autofocus: ready, touchFocus: false,
+            reason: "富士点击画面对焦的无线坐标协议尚未接入；可使用蓝牙半按对焦，并在机身选择焦点。")
+    }
+    func focus(at point: CameraFocusPoint?) async throws {
+        guard point == nil else {
+            throw CameraAppError.unsupportedOperation("富士当前仅支持蓝牙半按对焦，点击画面选择焦点尚未接入。")
+        }
+        let current = await FujiBluetoothController.shared.connectedIdentifier
+        guard let pairedBluetoothID, current == pairedBluetoothID else {
+            throw CameraAppError.unsupportedOperation("请先配对当前富士相机的蓝牙，再使用自动对焦。")
+        }
+        try await FujiBluetoothController.shared.autofocus()
+    }
+    func beginCaptureWatch() async { watchEnabled = true; watchBaseline = nil; watchCount = nil; watchEdgeKeys = []; watchPoll = 0 }
+    func stopCaptureWatch() async { watchEnabled = false }
+    func checkConnection() async throws { try await updateEvents() }
+    func newlyCapturedAssets(in session: CameraSession) async throws -> [PhotoAsset] {
+        guard liveTransaction == nil, !isTransferring else { return [] }
+        let currentHandles = try await objectHandles()
+        watchPoll += 1
+        var edgeKeys: [String] = []
+        for handle in Set([currentHandles.first, currentHandles.last].compactMap { $0 }) {
+            guard watchEnabled else { return [] }
+            if let photo = try await asset(handle: handle, session: session), let key = photo.libraryFingerprint { edgeKeys.append(key) }
+        }
+        edgeKeys.sort()
+        // 无变化时只检查数量及首尾身份，每 20 轮仍做一次完整复核。
+        if watchBaseline != nil, watchCount == currentHandles.count, watchEdgeKeys == edgeKeys, watchPoll % 20 != 0 { return [] }
+        // 索引可能重排，因此用完整文件身份比较，不把旧句柄当作新照片。
+        var photos: [PhotoAsset] = []
+        for handle in currentHandles {
+            guard watchEnabled else { return [] }
+            if let photo = try await asset(handle: handle, session: session) { photos.append(photo) }
+        }
+        watchCount = currentHandles.count; watchEdgeKeys = edgeKeys
+        let keys = Set(photos.compactMap(\.libraryFingerprint))
+        guard let baseline = watchBaseline else { watchBaseline = keys; return [] }
+        watchBaseline = keys.union(baseline)
+        return photos.filter { $0.libraryFingerprint.map { !baseline.contains($0) } == true }
+    }
+    func downloadTransferMode(for asset: PhotoAsset) async -> DownloadThroughputTransferMode { .getPartialObject }
+    func disconnect() async {
+        await videoWire?.close(); await eventWire?.close(); await wire?.close()
+        videoWire = nil; eventWire = nil; wire = nil; cameraSession = nil; liveTransaction = nil; watchBaseline = nil
+    }
+    func consumeDiagnostics() async -> [String] { let result = diagnostics; diagnostics = []; return result }
+}
