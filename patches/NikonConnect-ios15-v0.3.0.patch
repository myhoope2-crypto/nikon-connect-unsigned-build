diff --git a/Domain/CameraRemoteControl.swift b/Domain/CameraRemoteControl.swift
new file mode 100644
index 0000000..5d66692
--- /dev/null
+++ b/Domain/CameraRemoteControl.swift
@@ -0,0 +1,225 @@
+import Foundation
+
+struct CameraParameterChoice: Identifiable, Equatable, Sendable {
+    let data: Data
+    let title: String
+    var recognized: Bool = true
+    var id: String { data.base64EncodedString() }
+}
+
+struct CameraParameter: Identifiable, Sendable {
+    let id: UInt16
+    let title: String
+    let current: CameraParameterChoice
+    let choices: [CameraParameterChoice]
+    let writable: Bool
+    var profile: CameraParameterDecoder.Profile = .standard
+    var unavailableReason: String? = nil
+    var kind: CameraParameterKind { CameraParameterKind.property(id, profile: profile) }
+    var editableChoices: [CameraParameterChoice] { choices.filter(\.recognized) }
+    var restriction: String? {
+        if let unavailableReason { return unavailableReason }
+        if !writable { return "相机将此参数报告为只读，需在机身设置。" }
+        if choices.isEmpty { return "相机未提供可选值或步进范围，无法可靠写入。" }
+        if choices.count < 2 { return "相机当前只允许一个值，请检查拍摄模式、镜头及实体拨盘。" }
+        if editableChoices.count < 2 { return "当前选项编码未完全确认，保留原始值，仅供查看。" }
+        return nil
+    }
+    var canChange: Bool { restriction == nil }
+    func confirms(_ requested: CameraParameterChoice) -> Bool {
+        if current.data == requested.data { return true }
+        // 富士颗粒“关闭”写 1 后，机身可能回读 6/7 以保留上次颗粒大小。
+        if profile == .fuji, id == 0xd023 {
+            func scalar(_ data: Data) -> UInt32 {
+                data.prefix(4).enumerated().reduce(0) { $0 | UInt32($1.element) << ($1.offset * 8) }
+            }
+            return scalar(requested.data) == 1 && [6, 7].contains(scalar(current.data))
+        }
+        return false
+    }
+    var availabilityTitle: String {
+        if canChange { return "可修改" }
+        if unavailableReason != nil { return "协议未支持" }
+        if !writable { return "只读" }
+        if choices.count > 1 && editableChoices.count < 2 { return "编码待确认" }
+        return "暂不可改"
+    }
+
+}
+
+enum CameraParameterKind: String, CaseIterable, Identifiable, Sendable {
+    case shutter, aperture, iso, whiteBalance, exposureCompensation, focusMode, focusArea, faceDetection, eyeDetection, exposureMode, metering, driveMode, selfTimer, shutterType, bracketing, bracketStep, bracketCount, imageQuality, imageSize, rawCompression, rawBitDepth, colorSpace, colorTemperature, wbRed, wbBlue, wbPreset, wbAutoTune, wbDaylightTune, wbCloudyTune, wbShadeTune, wbTungstenTune, wbFluorescentTune, wbFlashTune, filmSimulation, dynamicRange, dynamicRangePriority, highlightTone, shadowTone, grain, colorChrome, colorChromeBlue, color, sharpness, noiseReduction, clarity, pictureControl, activeDLighting, autoISO, autoISOMax, autoISOMinShutter, stabilization, customWhiteBalanceMeasure, pictureSharpening, pictureMidrange, pictureClarity, pictureContrast, pictureBrightness, pictureSaturation, pictureHue, other
+    var id: String { rawValue }
+    static let core: [Self] = [.shutter, .aperture, .iso, .whiteBalance, .exposureCompensation]
+    var title: String {
+        for profile in [CameraParameterDecoder.Profile.standard, .fuji, .nikon] {
+            if let item = CameraSettingCatalog.definitions(profile: profile).first(where: { $0.kind == self }) { return item.title }
+        }
+        return "其他参数"
+    }
+    static func property(_ code: UInt16, profile: CameraParameterDecoder.Profile = .standard) -> Self {
+        CameraSettingCatalog.definition(code: code, profile: profile)?.kind ?? .other
+    }
+}
+
+protocol CameraRemoteControlling: CameraTransport {
+    func startLiveView() async throws
+    func liveViewFrame() async throws -> Data
+    func stopLiveView() async
+    func releaseShutter() async throws
+    func cameraParameters() async throws -> [CameraParameter]
+    func cameraParameters(only codes: Set<UInt16>) async throws -> [CameraParameter]
+    func focusCapabilities() async -> CameraFocusCapabilities
+    func focus(at point: CameraFocusPoint?) async throws
+    func setCameraParameter(_ parameter: UInt16, to choice: CameraParameterChoice) async throws
+    // 首次调用只建立基线，之后返回新增文件；不改变照片页的分页游标。
+    func beginCaptureWatch() async
+    func stopCaptureWatch() async
+    func newlyCapturedAssets(in session: CameraSession) async throws -> [PhotoAsset]
+}
+
+enum CameraMediaFormat {
+    static func kind(for filename: String) -> PhotoAssetKind? {
+        switch (filename as NSString).pathExtension.lowercased() {
+        case "jpg", "jpeg", "heif", "heic", "hif": return .jpeg
+        case "png": return .png
+        case "nef", "nrw", "arw", "cr2", "cr3", "raf", "dng": return .raw
+        case "mov", "mp4", "avi", "mxf": return .movie
+        default: return nil
+        }
+    }
+
+    static func jpeg(in data: Data) throws -> Data {
+        guard let begin = data.range(of: Data([0xff, 0xd8, 0xff])),
+              let end = data.range(of: Data([0xff, 0xd9]), options: .backwards),
+              end.upperBound > begin.lowerBound else {
+            throw CameraAppError.unsupportedOperation("相机本次没有返回可显示的 JPEG 画面。")
+        }
+        return Data(data[begin.lowerBound..<end.upperBound])
+    }
+}
+
+// 选项顺序、数据宽度及写入值均保留相机描述，不用界面显示文字反算协议值。
+enum CameraParameterDecoder {
+    enum Profile: Equatable, Sendable { case standard, nikon, fuji }
+    static func definitions(profile: Profile) -> [(UInt16, String)] {
+        CameraSettingCatalog.definitions(profile: profile).flatMap { item in item.codes.map { ($0, item.title) } }
+    }
+    static func decode(_ data: Data, code: UInt16, title: String, profile: Profile = .standard, model: String = "") throws -> CameraParameter {
+        var r = PTPDataReader(data: data)
+        guard try r.readUInt16() == code else { throw PTPIPError.malformedPayload("参数编号不符") }
+        let type = try r.readUInt16()
+        if type == 0xffff {
+            let writable = try r.readUInt8() != 0
+            func readString(_ reader: inout PTPDataReader) throws -> CameraParameterChoice {
+                let value = try reader.readPTPString()
+                var bytes = Data()
+                if value.isEmpty { bytes.append(0) }
+                else {
+                    let utf16 = Array(value.utf16)
+                    guard utf16.count <= 254 else { throw PTPIPError.malformedPayload("参数字符串过长") }
+                    bytes.append(UInt8(utf16.count + 1))
+                    for unit in utf16 { bytes.appendUInt16LE(unit) }
+                    bytes.appendUInt16LE(0)
+                }
+                return CameraParameterChoice(data: bytes, title: value.isEmpty ? "相机未提供文字" : value,
+                    recognized: !value.isEmpty)
+            }
+            _ = try readString(&r)
+            let current = try readString(&r)
+            let form = try r.readUInt8()
+            var choices: [CameraParameterChoice] = []
+            if form == 2 {
+                let count = Int(try r.readUInt16())
+                guard count <= 4096 else { throw PTPIPError.malformedPayload("参数选项过多") }
+                for _ in 0..<count { choices.append(try readString(&r)) }
+            } else if form != 0 { throw CameraAppError.unsupportedOperation("尚未支持该字符串参数的范围格式。") }
+            var seen = Set<Data>()
+            return CameraParameter(id: code, title: title, current: current,
+                choices: choices.filter { seen.insert($0.data).inserted }, writable: writable, profile: profile)
+        }
+        let width: Int
+        switch type { case 1, 2: width = 1; case 3, 4: width = 2; case 5, 6: width = 4
+        default: throw CameraAppError.unsupportedOperation("暂不支持该参数的数据类型。") }
+        let writable = try r.readUInt8() != 0
+        _ = try r.readData(count: width)
+        let current = try r.readData(count: width)
+        let form = try r.readUInt8()
+        var values: [Data] = []
+        if form == 2 {
+            let count = Int(try r.readUInt16())
+            guard count <= 4096 else { throw PTPIPError.malformedPayload("参数选项过多") }
+            for _ in 0..<count { values.append(try r.readData(count: width)) }
+        } else if form == 1 {
+            let minimum = try r.readData(count: width), maximum = try r.readData(count: width)
+            let step = try r.readData(count: width)
+            let low = number(minimum, type: type), high = number(maximum, type: type)
+            let increment = number(step, type: type)
+            if increment > 0, high >= low, (high - low) / increment <= 1024 {
+                var value = low
+                while value <= high {
+                    var bits = UInt32(truncatingIfNeeded: value).littleEndian
+                    values.append(withUnsafeBytes(of: &bits) { Data($0.prefix(width)) })
+                    value += increment
+                }
+            }
+        }
+        let choice: (Data) -> CameraParameterChoice = { bytes in
+            CameraParameterChoice(data: bytes, title: CameraParameterLabels.title(
+                code: code, value: number(bytes, type: type), profile: profile, model: model))
+        }
+        var seen = Set<Data>()
+        let choices = values.filter { seen.insert($0).inserted }.map { bytes -> CameraParameterChoice in
+            var item = choice(bytes)
+            item.recognized = !item.title.hasPrefix("未识别")
+            if profile == .fuji, code == 0xd023, [6, 7].contains(number(bytes, type: type)) { item.recognized = false }
+            return item
+        }
+        return CameraParameter(id: code, title: title, current: choice(current),
+            choices: choices, writable: writable, profile: profile)
+    }
+
+    // 同一功能只保留一个属性，优先使用目录前列的可写参数；只读厂商项不遮住可写标准项。
+    static func preferred(_ parameters: [CameraParameter], profile: Profile) -> [CameraParameter] {
+        var result = parameters
+        for definition in CameraSettingCatalog.definitions(profile: profile) where definition.codes.count > 1 {
+            let candidates = definition.codes.compactMap { code in parameters.first { $0.id == code } }
+            guard candidates.count > 1 else { continue }
+            let chosen = candidates.first(where: \.canChange) ?? candidates.first(where: { $0.unavailableReason == nil }) ?? candidates[0]
+            result.removeAll { definition.codes.contains($0.id) && $0.id != chosen.id }
+        }
+        return result.sorted { $0.kind.rawValue < $1.kind.rawValue }
+    }
+
+    private static func number(_ data: Data, type: UInt16) -> Int64 {
+        var value: UInt32 = 0
+        for (i, byte) in data.enumerated() { value |= UInt32(byte) << (i * 8) }
+        if type == 1 { return Int64(Int8(bitPattern: UInt8(truncatingIfNeeded: value))) }
+        if type == 3 { return Int64(Int16(bitPattern: UInt16(truncatingIfNeeded: value))) }
+        if type == 5 { return Int64(Int32(bitPattern: value)) }
+        return Int64(value)
+    }
+}
+
+struct CameraFocusPoint: Equatable, Sendable {
+    let x: Double
+    let y: Double
+}
+
+struct CameraFocusCapabilities: Sendable {
+    var autofocus = false
+    var touchFocus = false
+    var reason = "当前连接未开放遥控对焦。"
+}
+
+extension CameraRemoteControlling {
+    func cameraParameters(only codes: Set<UInt16>) async throws -> [CameraParameter] {
+        try await cameraParameters().filter { codes.contains($0.id) }
+    }
+    func focusCapabilities() async -> CameraFocusCapabilities { CameraFocusCapabilities() }
+    func focus(at point: CameraFocusPoint?) async throws {
+        throw CameraAppError.unsupportedOperation("当前连接未开放遥控对焦。")
+    }
+    func beginCaptureWatch() async {}
+    func stopCaptureWatch() async {}
+}
