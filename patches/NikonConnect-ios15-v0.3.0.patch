index 0000000..8ddce62
--- /dev/null
+++ b/Domain/AssetLibraryIdentity.swift
@@ -0,0 +1,54 @@
+import Foundation
+import CryptoKit
+
+extension PhotoAsset {
+    // 对象句柄重启后可能变化；文件名、目录、大小、拍摄时间及相机身份共同确定记录。
+    var libraryFingerprint: String? {
+        guard let sourceScope, !sourceScope.isEmpty,
+              let directoryIdentifier, captureDate > Date(timeIntervalSince1970: 0), byteSize > 0 else { return nil }
+        let fields = [sourceScope, directoryIdentifier, fileName, String(byteSize),
+                      String(Int64(captureDate.timeIntervalSince1970))]
+        guard let data = try? JSONEncoder().encode(fields) else { return nil }
+        return SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+    }
+
+    func scoped(to session: CameraSession) -> PhotoAsset {
+        var copy = self
+        copy.sourceScope = session.persistentIdentity
+        return copy
+    }
+
+    func isRAWCompanion(of other: PhotoAsset) -> Bool {
+        let kinds: Set<PhotoAssetKind> = [kind, other.kind]
+        guard kinds == [.jpeg, .raw], let sourceScope, sourceScope == other.sourceScope,
+              let directoryIdentifier, directoryIdentifier == other.directoryIdentifier,
+              captureDate > Date(timeIntervalSince1970: 0),
+              abs(captureDate.timeIntervalSince(other.captureDate)) <= 2 else { return false }
+        return (fileName as NSString).deletingPathExtension.caseInsensitiveCompare(
+            (other.fileName as NSString).deletingPathExtension) == .orderedSame
+    }
+}
+
+extension PhotoAsset {
+    var companionGroup: String? {
+        guard let sourceScope, let directoryIdentifier else { return nil }
+        let fields = [sourceScope, directoryIdentifier, (fileName as NSString).deletingPathExtension.lowercased()]
+        return (try? JSONEncoder().encode(fields)).flatMap { String(data: $0, encoding: .utf8) }
+    }
+}
+enum AssetCompanionIndex {
+    static func groups(_ assets: [PhotoAsset]) -> [String: [PhotoAsset]] {
+        var groups: [String: [PhotoAsset]] = [:]
+        for asset in assets where asset.kind == .jpeg || asset.kind == .raw {
+            if let key = asset.companionGroup { groups[key, default: []].append(asset) }
+        }
+        return groups
+    }
+    static func pairedIDs(_ assets: [PhotoAsset]) -> Set<UUID> {
+        var ids = Set<UUID>()
+        for group in groups(assets).values {
+            for asset in group where group.contains(where: { asset.isRAWCompanion(of: $0) }) { ids.insert(asset.id) }
+        }
+        return ids
+    }
+}
