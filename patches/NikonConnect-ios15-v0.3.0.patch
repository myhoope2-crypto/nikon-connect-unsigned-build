+                                .font(.caption).foregroundColor(AppTheme.inkMuted)
+                            Text("设置影响之后拍摄的文件。选项与读写权限来自机身，写入后回读确认；模式、镜头和实体拨盘可能使设置无效。扩展项目为实验支持，尚未逐机验证。")
+                                .font(.caption).foregroundColor(AppTheme.inkMuted)
+                        }.padding(.bottom, 16)
+                    }
+                }.padding(.horizontal, 16).padding(.top, 8)
+            }
+            .foregroundColor(AppTheme.ink).background(AppTheme.canvas.ignoresSafeArea())
+            .navigationTitle("实时取景").navigationBarTitleDisplayMode(.inline)
+            .toolbar {
+                ToolbarItem(placement: .navigationBarLeading) {
+                    Button { model.stopLive(); dismiss() } label: { Label("退出取景", systemImage: "xmark") }
+                }
+                ToolbarItem(placement: .navigationBarTrailing) {
+                    Text(model.cameraModel).font(.caption).foregroundColor(AppTheme.inkMuted).lineLimit(1)
+                }
+            }
+            .alert(item: Binding(get: { selectedSetting == nil ? model.liveAlert : nil }, set: { model.liveAlert = $0 })) { alert in
+                Alert(title: Text(alert.title), message: Text(alert.message), dismissButton: .default(Text("确定")))
