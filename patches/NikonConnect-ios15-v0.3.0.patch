diff --git a/Domain/CameraSettingCatalog.swift b/Domain/CameraSettingCatalog.swift
new file mode 100644
index 0000000..49197fd
--- /dev/null
+++ b/Domain/CameraSettingCatalog.swift
@@ -0,0 +1,173 @@
+import Foundation
+
+// 按连接品牌解码，再按机身型号选择目录。描述中的值、顺序、读写权限始终来自相机。
+enum CameraSettingGroup: String, CaseIterable, Identifiable, Sendable {
+    case core
+    case focus
+    case shooting
+    case quality
+    case whiteBalance
+    case fuji
+    case nikon
+    var id: String { rawValue }
+    var title: String {
+        switch self {
+        case .core: return "常用曝光"
+        case .focus: return "对焦与识别"
+        case .shooting: return "拍摄方式"
+        case .quality: return "文件与画质"
+        case .whiteBalance: return "白平衡细调"
+        case .fuji: return "富士成像设置"
+        case .nikon: return "尼康成像设置"
+        }
+    }
+}
+
+struct CameraSettingDefinition: Identifiable, Sendable {
+    let kind: CameraParameterKind
+    let title: String
+    let group: CameraSettingGroup
+    let codes: [UInt16]
+    var help: String = ""
