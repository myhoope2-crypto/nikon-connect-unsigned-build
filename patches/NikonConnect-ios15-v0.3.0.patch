new file mode 100644
index 0000000..77472e8
--- /dev/null
+++ b/Features/ConnectionSetup/LiveViewAssistance.swift
@@ -0,0 +1,71 @@
+import SwiftUI
+import UIKit
+
+struct LiveViewAssistanceControls: View {
+    @ObservedObject var model: CameraRemoteViewModel
+    @AppStorage("liveGrid.v1") private var grid = false
+    @AppStorage("liveFrameGuide.v1") private var guide = "off"
+    @AppStorage("liveHistogram.v1") private var histogram = false
+    @AppStorage("liveZebra.v1") private var zebra = false
+    @AppStorage("liveZebraThreshold.v1") private var threshold = 245
+    var body: some View {
+        DisclosureGroup("取景辅助") {
+            VStack(alignment:.leading,spacing:12) {
+                Toggle("九宫格",isOn:$grid)
+                Picker("画幅参考线",selection:$guide) {
+                    Text("关闭").tag("off"); Text("3:2").tag("3:2"); Text("16:9").tag("16:9"); Text("1:1").tag("1:1")
+                }.pickerStyle(.segmented)
+                Toggle("亮度直方图",isOn:$histogram)
+                Toggle("过曝斑马纹",isOn:$zebra)
+                if zebra { Stepper("提示阈值：\(threshold)/255",value:$threshold,in:220...255) }
+                if histogram {
+                    GeometryReader { geometry in
+                        Path { path in
+                            let bins = model.liveHistogram
+                            guard !bins.isEmpty else { return }
+                            let step = geometry.size.width/CGFloat(bins.count)
+                            for (i,value) in bins.enumerated() {
+                                let height = CGFloat(value)*geometry.size.height
+                                path.addRect(CGRect(x:CGFloat(i)*step,y:geometry.size.height-height,width:max(1,step-1),height:height))
+                            }
+                        }.fill(AppTheme.accentStrong)
+                    }.frame(height:60).padding(8).background(AppTheme.surfaceMuted,in:RoundedRectangle(cornerRadius:8))
+                }
+                Text("分析的是低分辨率取景图，约每半秒更新。斑马纹提示任一颜色通道接近阈值，不代表 RAW 已过曝；画幅参考线只辅助构图，不改变机身记录画幅。")
+                    .font(.caption).foregroundColor(AppTheme.inkMuted)
+            }.padding(.top,10)
+        }.padding(12).background(AppTheme.surface,in:RoundedRectangle(cornerRadius:12))
+    }
+}
+
+struct LiveViewAssistanceOverlay: View {
+    let rect: CGRect
+    let zebraData: Data?
+    @AppStorage("liveGrid.v1") private var grid = false
+    @AppStorage("liveFrameGuide.v1") private var guide = "off"
+    @AppStorage("liveZebra.v1") private var zebra = false
+    var body: some View {
+        ZStack {
+            if zebra, let zebraData, let image = UIImage(data:zebraData) {
+                Image(uiImage:image).resizable().interpolation(.none).frame(width:rect.width,height:rect.height)
+                    .position(x:rect.midX,y:rect.midY)
+            }
+            if grid {
+                gridPath.stroke(.black.opacity(0.7),lineWidth:3)
+                gridPath.stroke(.white.opacity(0.85),lineWidth:1)
+            }
+            if let ratio = ratio {
+                let size = ratio > rect.width/max(1,rect.height) ? CGSize(width:rect.width,height:rect.width/ratio) : CGSize(width:rect.height*ratio,height:rect.height)
+                Rectangle().stroke(.black,lineWidth:3).overlay(Rectangle().stroke(.white,style:StrokeStyle(lineWidth:1,dash:[5,4])))
+                    .frame(width:size.width,height:size.height).position(x:rect.midX,y:rect.midY)
+            }
+        }.allowsHitTesting(false).accessibilityHidden(true)
+    }
+    private var ratio: CGFloat? { ["3:2":CGFloat(1.5),"16:9":CGFloat(16.0/9.0),"1:1":CGFloat(1)][guide] }
+    private var gridPath: Path {
+        Path { p in for fraction in [CGFloat(1.0/3.0),CGFloat(2.0/3.0)] {
+            p.move(to:CGPoint(x:rect.minX+rect.width*fraction,y:rect.minY)); p.addLine(to:CGPoint(x:rect.minX+rect.width*fraction,y:rect.maxY))
+            p.move(to:CGPoint(x:rect.minX,y:rect.minY+rect.height*fraction)); p.addLine(to:CGPoint(x:rect.maxX,y:rect.minY+rect.height*fraction))
+        } }
+    }
+}
