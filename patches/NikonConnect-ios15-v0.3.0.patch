+struct CaptureScheduleView: View {
+    @ObservedObject var model: CameraRemoteViewModel
+    @State private var delay = 5.0
+    @State private var interval = 10.0
+    @State private var count = 10
+    var body: some View {
+        Form {
+            Section(header:Text("前台定时与间隔拍摄")) {
+                Stepper("开始倒计时：\(Int(delay)) 秒", value:$delay, in:0...3600, step:1)
+                Stepper("每次指令完成后等待：\(Int(interval)) 秒", value:$interval, in:1...3600, step:1)
+                Stepper("拍摄次数：\(count)", value:$count, in:1...9999)
+            }.disabled(model.isScheduling)
+            Section {
+                Text(model.scheduleStatus)
+                if model.isScheduling { Button("停止拍摄计划", role:.destructive) { model.stopSchedule() } }
+                else {
+                    Button("开始定时拍摄") { model.startSchedule(delay:delay, interval:interval, count:count) }
+                        .disabled(!model.canPrepareWorkflow || model.isLive || !model.supports(.capture))
+                }
+                Text("只在应用前台执行，运行时保持屏幕亮起。请先停止取景、边拍边传、照片读取和下载。进入后台或连接变化会停止，不会追补错过的快门，也不会在失败时重复拍摄。间隔以指令完成后计时，不保证精确曝光间隔；长曝光请留足等待时间。")
+                    .font(.footnote).foregroundColor(AppTheme.inkMuted)
+            }
+        }.foregroundColor(AppTheme.ink).navigationTitle("间隔与定时快门")
+    }
+}
