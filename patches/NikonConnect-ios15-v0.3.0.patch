@@ -0,0 +1,112 @@
+import SwiftUI
+
+struct CaptureProjectsView: View {
+    @ObservedObject private var library = WorkflowLibrary.shared
+    @ObservedObject var downloads: DownloadManagerViewModel
+    let selectedAssets: [PhotoAsset]
+    @State private var name = ""
+    @State private var message: String?
+    var body: some View {
+        List {
+            Section(header:Text("当前拍摄项目")) {
+                Text(library.projects.first(where: { $0.id == library.activeProjectID })?.name ?? "未选择项目")
+                Text("选中项目后，新加入下载队列的照片自动归档；原照片与下载路径保持不变。项目记录保存在手机。")
+                    .font(.footnote).foregroundColor(AppTheme.inkMuted)
+                Button("暂停自动归档") { library.activeProjectID = nil }
+                Button("将照片页所选 \(selectedAssets.count) 个文件加入当前项目") {
+                    do { message = "已加入 \(try library.addPhotos(selectedAssets)) 个文件；重复项或身份不完整的文件会跳过。" }
+                    catch { message = error.localizedDescription }
+                }.disabled(selectedAssets.isEmpty || library.activeProjectID == nil)
+            }
+            Section(header:Text("新建项目")) {
+                TextField("例如：十月旅行 / 人像约拍", text:$name)
+                Button("创建并设为当前项目") {
+                    do { try library.createProject(name); name = "" } catch { message = error.localizedDescription }
+                }.disabled(name.trimmingCharacters(in:.whitespacesAndNewlines).isEmpty)
+            }
+            Section(header:Text("所有项目")) {
+                ForEach(library.projects) { project in
+                    VStack(alignment:.leading, spacing:8) {
+                        NavigationLink { CaptureProjectDetailView(projectID:project.id, downloads:downloads) } label: {
+                            VStack(alignment:.leading) {
+                                Text(project.name).font(.headline)
+                                Text("\(project.photos.count) 个文件" + (project.id == library.activeProjectID ? " · 当前归档项目" : "")).font(.caption).foregroundColor(AppTheme.inkMuted)
+                            }
+                        }
+                        Button("设为当前项目") { library.activeProjectID = project.id }.buttonStyle(.borderless)
+                    }
+                }
+            }
+            if let message { Text(message).font(.footnote) }
+            if let error = library.errorMessage { Text(error).foregroundColor(AppTheme.danger) }
+        }.foregroundColor(AppTheme.ink).navigationTitle("拍摄项目")
+    }
+}
+
+private struct CaptureProjectDetailView: View {
+    let projectID: UUID
+    @ObservedObject var downloads: DownloadManagerViewModel
+    @ObservedObject private var library = WorkflowLibrary.shared
+    @State private var name = ""
+    @State private var note = ""
+    @State private var prefix = ""
+    @State private var exporting = false
+    @State private var share: WorkflowShareItem?
+    @State private var message: String?
+    @State private var confirmDelete = false
+    @Environment(\.dismiss) private var dismiss
+    private var project: CaptureProject? { library.projects.first { $0.id == projectID } }
+    var body: some View {
+        List {
+            if let project {
+                Section(header:Text("项目资料")) {
+                    TextField("项目名称",text:$name); TextField("备注",text:$note)
+                    Button("保存名称与备注") {
+                        do { var copy = project; copy.name = name; copy.note = note; try library.updateProject(copy); message = "已保存。" }
+                        catch { message = error.localizedDescription }
+                    }
+                    Text("已关联 \(project.photos.count) 个文件，本地已下载 \(project.photos.filter { photo in downloads.downloads.contains { $0.assetFingerprint == photo.id } }.count) 个。")
+                        .font(.footnote).foregroundColor(AppTheme.inkMuted)
+                }
+                Section(header:Text("批量命名与导出")) {
+                    TextField("导出文件名前缀，留空用项目名",text:$prefix)
+                    Button("导出照片副本与拍摄清单") { export(project, metadataOnly:false) }.disabled(exporting || downloads.isDownloading)
+                    Button("只导出拍摄清单") { export(project, metadataOnly:true) }.disabled(exporting)
+                    if exporting { ProgressView("正在复制文件…") }
+                    Text("仅复制已下载文件，按前缀与序号重命名；JPG/RAW 同组保留相同序号。未下载或丢失的文件写入清单，原文件不改名。导出文件夹可保存到“文件”或分享。")
+                        .font(.footnote).foregroundColor(AppTheme.inkMuted)
+                }
+                Section(header:Text("项目照片")) {
+                    ForEach(project.photos) { photo in
+                        VStack(alignment:.leading) {
+                            Text(photo.originalName)
+                            Text(photo.captureDate.formatted()).font(.caption).foregroundColor(AppTheme.inkMuted)
+                        }.swipeActions { Button("移出项目",role:.destructive) {
+                            do { var copy = project; copy.photos.removeAll { $0.id == photo.id }; try library.updateProject(copy) }
+                            catch { message = error.localizedDescription }
+                        } }
+                    }
+                }
+                Button("删除项目记录",role:.destructive) { confirmDelete = true }
+            }
+            if let message { Text(message).font(.footnote) }
+        }.foregroundColor(AppTheme.ink).navigationTitle(project?.name ?? "拍摄项目")
+            .onAppear { name = project?.name ?? ""; note = project?.note ?? "" }
+            .sheet(item:$share) { WorkflowShareView(url:$0.url) }
+            .alert("删除项目记录？",isPresented:$confirmDelete) {
+                Button("删除",role:.destructive) { do { try library.removeProject(projectID); dismiss() } catch { message = error.localizedDescription } }
+                Button("取消",role:.cancel) {}
+            } message: { Text("会删除归档关系和备注，保留下载文件与导出副本。") }
+    }
+    private func export(_ project: CaptureProject, metadataOnly: Bool) {
+        exporting = true
+        Task {
+            defer { exporting = false }
+            do {
+                let directory = try library.exportDirectory()
+                let url = try await CaptureProjectExporter().export(project, records:downloads.downloads, directory:directory, prefix:prefix, metadataOnly:metadataOnly)
+                message = "导出已保存：\(url.lastPathComponent)"; share = WorkflowShareItem(url:url)
+            } catch { message = "导出未完成：\(error.localizedDescription)。已复制部分可能仍保留在导出目录。" }
+        }
+    }
+}
