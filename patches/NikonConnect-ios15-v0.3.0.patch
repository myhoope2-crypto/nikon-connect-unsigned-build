new file mode 100644
index 0000000..f801c87
--- /dev/null
+++ b/AppearanceChecks/ThemeContrastTests.swift
@@ -0,0 +1,69 @@
+import XCTest
+import SwiftUI
+import UIKit
+@testable import NikonConnectIOS
+
+@MainActor
+final class ThemeContrastTests: XCTestCase {
+    private func rgb(_ color: Color, _ traits: UITraitCollection) -> [Double] {
+        var r: CGFloat = 0, g: CGFloat = 0, b: CGFloat = 0, a: CGFloat = 0
+        XCTAssertTrue(UIColor(color).resolvedColor(with: traits).getRed(&r, green: &g, blue: &b, alpha: &a))
+        return [Double(r), Double(g), Double(b)]
+    }
+    private func ratio(_ foreground: [Double], _ background: [Double]) -> Double {
+        func luminance(_ rgb: [Double]) -> Double {
+            let linear = rgb.map { $0 <= 0.04045 ? $0 / 12.92 : pow(($0 + 0.055) / 1.055, 2.4) }
+            return linear[0] * 0.2126 + linear[1] * 0.7152 + linear[2] * 0.0722
+        }
+        let a = luminance(foreground), b = luminance(background)
+        return (max(a, b) + 0.05) / (min(a, b) + 0.05)
+    }
+    func testTextAndControlContrastInEveryAppearance() {
+        var checks = 0
+        for style in [UIUserInterfaceStyle.light, .dark] {
+            for contrast in [UIAccessibilityContrast.normal, .high] {
+                let traits = UITraitCollection(traitsFrom: [UITraitCollection(userInterfaceStyle: style), UITraitCollection(accessibilityContrast: contrast)])
+                let foregrounds: [(String, Color)] = [("正文", AppTheme.ink), ("辅助文字", AppTheme.inkMuted),
+                    ("信息", AppTheme.info), ("成功", AppTheme.success), ("警告", AppTheme.warning), ("错误", AppTheme.danger)]
+                let backgrounds: [(String, Color)] = [("页面", AppTheme.canvas), ("卡片", AppTheme.surface),
+                    ("高层卡片", AppTheme.surfaceElevated), ("次级卡片", AppTheme.surfaceMuted)]
+                for (name, fg) in foregrounds {
+                    for (surface, bg) in backgrounds {
+                        let result = ratio(rgb(fg, traits), rgb(bg, traits))
+                        XCTAssertGreaterThanOrEqual(result, 4.5, "\(style.rawValue)/\(contrast.rawValue) \(name)/\(surface): \(result)")
+                        checks += 1
+                    }
+                }
+                for (name, fg, bg) in [("主按钮", AppTheme.onAction, AppTheme.actionFill),
+                    ("RAW 标签", AppTheme.onAccent, AppTheme.accentStrong), ("连接图标", AppTheme.onSuccess, AppTheme.success),
+                    ("视频标签", AppTheme.onDanger, AppTheme.danger)] {
+                    XCTAssertGreaterThanOrEqual(ratio(rgb(fg, traits), rgb(bg, traits)), 4.5, name)
+                    checks += 1
+                }
+                for (_, bg) in backgrounds {
+                    XCTAssertGreaterThanOrEqual(ratio(rgb(AppTheme.border, traits), rgb(bg, traits)), 3, "按钮轮廓")
+                    checks += 1
+                }
+                // 小状态文字有同色 12% 底色时也需保持清晰。
+                for (name, fg) in foregrounds.dropFirst(2) {
+                    let text = rgb(fg, traits), card = rgb(AppTheme.surfaceElevated, traits)
+                    let tinted = zip(text, card).map { $0 * 0.12 + $1 * 0.88 }
+                    XCTAssertGreaterThanOrEqual(ratio(text, tinted), 4.5, "状态标签 \(name)")
+                    checks += 1
+                }
+                // 选中圆圈放在 82% 黑底上，即使照片是白色也能辨认。
+                XCTAssertGreaterThanOrEqual(ratio(rgb(AppTheme.accent, traits), [0.18, 0.18, 0.18]), 3)
+                checks += 1
+            }
+        }
+        print("外观对比度检查数量：\(checks)")
+    }
+    func testThemeModesAndDynamicColors() {
+        XCTAssertNil(AppAppearance.system.colorScheme)
+        XCTAssertEqual(AppAppearance.system.interfaceStyle, .unspecified)
+        XCTAssertEqual(AppAppearance.light.interfaceStyle, .light)
+        XCTAssertEqual(AppAppearance.dark.interfaceStyle, .dark)
+        XCTAssertNotEqual(rgb(AppTheme.ink, UITraitCollection(userInterfaceStyle: .light)), rgb(AppTheme.ink, UITraitCollection(userInterfaceStyle: .dark)))
+        XCTAssertNil(Bundle.main.object(forInfoDictionaryKey: "UIUserInterfaceStyle"))
+    }
+}
