+struct CameraPresetsView: View {
+    @ObservedObject var model: CameraRemoteViewModel
+    @ObservedObject private var library = WorkflowLibrary.shared
+    @State private var name = ""
+    @State private var note = ""
+    @State private var recipe = false
+    @State private var importing = false
+    @State private var share: WorkflowShareItem?
+    @State private var message: String?
+    var body: some View {
+        List {
+            Section(header: Text("保存当前设置")) {
+                Text(model.cameraModel)
+                TextField("预设或配方名称", text:$name)
+                TextField("备注与拍摄用途", text:$note)
+                if model.cameraProfile == .fuji { Toggle("只保存富士成像配方", isOn:$recipe) }
+                Button("读取相机当前参数") { model.refreshParameters() }.disabled(!model.canPrepareWorkflow)
+                Button("保存当前已确认的设置") { model.savePreset(name:name, note:note, recipe:recipe); name = "" }
+                    .disabled(name.trimmingCharacters(in:.whitespacesAndNewlines).isEmpty || !model.parametersLoaded || model.isBusy)
+                Text(model.presetStatus).font(.footnote).foregroundColor(AppTheme.inkMuted)
+            }
+            Section(header: Text("本机预设与富士配方")) {
+                Button("从文件导入预设 / 配方") { importing = true }
+                ForEach(library.presets) { item in
+                    VStack(alignment:.leading, spacing:8) {
+                        Text(item.name).font(.headline)
+                        Text("\(item.model) · \(item.recipe ? "富士配方" : "拍摄预设") · \(item.values.count) 项").font(.caption).foregroundColor(AppTheme.inkMuted)
+                        if !item.note.isEmpty { Text(item.note).font(.footnote) }
+                        HStack {
+                            Button("应用并回读") { model.applyPreset(item) }.disabled(!model.canPrepareWorkflow)
+                            Spacer()
+                            Button("分享") { do { share = WorkflowShareItem(url:try library.exportPreset(item)) } catch { message = error.localizedDescription } }
+                            Button("删除", role:.destructive) { do { try library.removePreset(item.id) } catch { message = error.localizedDescription } }
+                        }.buttonStyle(.borderless)
+                    }.padding(.vertical,6)
+                }
+            }
+            Text("只向相同型号写入机身当前允许的值。不允许或不认识的项会跳过；回读失败后停止后续设置。预设可能只应用了一部分，请检查结果。配方保存在手机，不直接占用相机自定义槽。")
+                .font(.footnote).foregroundColor(AppTheme.inkMuted)
+            if let message { Text(message).foregroundColor(AppTheme.danger) }
+            if let error = library.errorMessage { Text(error).foregroundColor(AppTheme.danger) }
+        }.foregroundColor(AppTheme.ink).navigationTitle("参数预设与富士配方")
+            .fileImporter(isPresented:$importing, allowedContentTypes:[.json]) { result in
+                do { try library.importPreset(result.get()); message = "已导入，应用前仍会检查型号、权限和允许值。" }
+                catch { message = error.localizedDescription }
+            }
+            .sheet(item:$share) { WorkflowShareView(url:$0.url) }
+    }
+}
