+                                .overlay(RoundedRectangle(cornerRadius: 10).stroke(AppTheme.border, lineWidth: 1))
+                            }.buttonStyle(.plain)
+                            .disabled(!parameter.canChange || !choice.recognized || model.isBusy || model.isStoppingLive)
+                        }
+                    }
+                    if model.isBusy { ProgressView("等待相机确认…").tint(AppTheme.accentStrong).foregroundColor(AppTheme.ink) }
+                    Text(model.parameterStatus).font(.footnote).foregroundColor(AppTheme.inkMuted)
+                    Button("重新读取全部设置") { model.refreshParameters() }
+                        .disabled(model.isBusy || model.isStoppingLive || !model.supports(.parameters))
+                }.padding(16).frame(maxWidth: .infinity, alignment: .leading)
+            }
+            .foregroundColor(AppTheme.ink).background(AppTheme.canvas.ignoresSafeArea())
+            .navigationTitle(definition.title).navigationBarTitleDisplayMode(.inline)
+            .toolbar { ToolbarItem(placement: .navigationBarTrailing) { Button("完成") { dismiss() } } }
+            .alert(item: $model.liveAlert) { alert in
+                Alert(title: Text(alert.title), message: Text(alert.message), dismissButton: .default(Text("确定")))
+            }
+        }.navigationViewStyle(.stack).tint(AppTheme.accentStrong)
+    }
+    private var missingReason: String? {
+        guard parameter == nil else { return nil }
+        if !model.parametersLoaded { return "尚未成功读取参数；请开始取景或重新读取设置。" }
+        return "相机未通过当前无线连接返回这个设置，可能受连接方式、拍摄模式、镜头或实体拨盘限制。此状态不代表机身没有该功能。"
+    }
+}
