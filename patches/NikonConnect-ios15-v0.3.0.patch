+import XCTest
+
+@MainActor
+final class AppearanceUITests: XCTestCase {
+    private let app = XCUIApplication()
+    override func setUpWithError() throws { continueAfterFailure = false }
+    private func launch(connected: Bool = true, reset: Bool = true) {
+        app.launchArguments = ["-appearance-fixtures", "-AppleLanguages", "(zh-Hans)", "-AppleLocale", "zh_CN"]
+        if connected { app.launchArguments.append("-appearance-connected") }
+        if reset { app.launchArguments.append("-appearance-reset") }
+        app.launch()
+        XCTAssertTrue(app.tabBars.buttons["设置"].waitForExistence(timeout: 30))
+        if connected { XCTAssertTrue(app.staticTexts["外观验证相机"].firstMatch.waitForExistence(timeout: 15)) }
+    }
+    private func shot(_ name: String) {
+        Thread.sleep(forTimeInterval: 0.6) // 等待页面和系统弹层过渡完成后再截图。
+        let attachment = XCTAttachment(screenshot: app.screenshot())
+        attachment.name = name; attachment.lifetime = .keepAlways; add(attachment)
+    }
+    private func tab(_ name: String) { app.tabBars.buttons[name].tap() }
+    private func tapFixedControl(_ element: XCUIElement) {
+        XCTAssertTrue(element.waitForExistence(timeout: 10))
+        // 固定导航按钮不应被 XCTest 自动滚动到屏幕中央。
+        element.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.5)).tap()
+    }
+    private func scrollUp() {
+        // 从内容中部向上拖动，避免触碰固定在底部的下载操作栏。
+        let content = app.scrollViews.firstMatch
+        content.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.50)).press(forDuration: 0.05,
+            thenDragTo: content.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.15)))
+    }
+    private func show(_ element: XCUIElement, maxSwipes: Int = 8) {
+        for _ in 0..<maxSwipes {
+            if element.exists && element.isHittable { return }
+            scrollUp()
+        }
+        XCTAssertTrue(element.exists && element.isHittable, "需要检查的控件未显示：\(element)")
+    }
+    private func showPhotoAboveDownloadBar(_ filename: XCUIElement) {
+        // SwiftUI 有时把固定下载栏后方的元素也报告为可点击，需检查实际屏幕位置。
+        let screen = app.frame
+        for _ in 0..<8 {
+            if filename.exists, filename.frame.midY > screen.height * 0.18,
+               filename.frame.midY < screen.height * 0.55 { break }
+            app.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.48)).press(forDuration: 0.05,
+                thenDragTo: app.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.20)))
+        }
+        XCTAssertTrue(filename.exists && filename.isHittable)
+        XCTAssertLessThan(filename.frame.midY, screen.height * 0.55)
+    }
+    private func setMode(_ mode: String) {
+        tab("设置")
+        let picker = app.segmentedControls["appearance.mode"]
+        XCTAssertTrue(picker.waitForExistence(timeout: 10))
+        picker.buttons[mode].tap()
+        XCTAssertTrue(picker.buttons[mode].isSelected)
+    }
+    func testSettingsThemeSwitchAndPersistence() {
+        launch()
+        setMode("浅色"); shot("01-浅色设置")
+        setMode("暗黑")
+        XCTAssertTrue(app.switches["允许自动导出到系统相册"].exists)
+        XCTAssertTrue(app.switches["启用 JPEG 优先 / RAW 后补"].exists)
+        shot("02-暗黑设置与下载开关")
+        app.terminate(); launch(reset: false); tab("设置")
+        XCTAssertTrue(app.segmentedControls["appearance.mode"].buttons["暗黑"].isSelected)
+        shot("03-重启记住暗黑模式")
+        setMode("跟随系统"); shot("04-恢复跟随系统")
+        show(app.buttons["关于此版本"]); app.buttons["关于此版本"].tap()
+        shot("05-暗黑版本信息")
+        let logs = app.buttons["运行记录"]
+        show(logs); logs.tap(); scrollUp(); shot("06-暗黑运行记录")
+    }
+    func testConnectedPhotosAndDownloads() {
+        launch(); setMode("暗黑"); tab("相机"); shot("07-暗黑相机已连接")
+        tab("照片"); shot("08-暗黑照片筛选与下载条")
+        let dateToggle = app.switches["按相机文件日期筛选"]
+        show(dateToggle)
+        dateToggle.coordinate(withNormalizedOffset: CGVector(dx: 0.95, dy: 0.5)).tap()
+        XCTAssertEqual(dateToggle.value as? String, "1")
+        let start = app.descendants(matching: .any).matching(identifier: "photos.dateStart").firstMatch
+        show(start); shot("09-暗黑日期筛选")
+        start.coordinate(withNormalizedOffset: CGVector(dx: 0.90, dy: 0.5)).tap()
+        shot("10-暗黑日期弹层"); app.coordinate(withNormalizedOffset: CGVector(dx: 0.08, dy: 0.12)).tap()
+        show(dateToggle)
+        dateToggle.coordinate(withNormalizedOffset: CGVector(dx: 0.95, dy: 0.5)).tap()
+        XCTAssertEqual(dateToggle.value as? String, "0")
+        showPhotoAboveDownloadBar(app.staticTexts["photo.filename.2"])
+        shot("11-暗黑照片网格格式星标与选中状态")
+        app.staticTexts["photo.filename.2"].tap()
+        XCTAssertTrue(app.buttons["关闭预览"].waitForExistence(timeout: 10))
+        shot("12-暗黑全屏预览")
+        tapFixedControl(app.buttons["关闭预览"])
+        let dismissed = XCTNSPredicateExpectation(predicate: NSPredicate(format: "exists == false"), object: app.buttons["关闭预览"])
+        XCTAssertEqual(XCTWaiter.wait(for: [dismissed], timeout: 10), .completed)
+        tapFixedControl(app.buttons["photos.options"])
+        XCTAssertTrue(app.buttons["清空选择"].waitForExistence(timeout: 10))
+        shot("13-暗黑全选范围菜单")
+        app.buttons["清空选择"].tap()
+        tab("下载"); shot("14-暗黑下载总览")
+        scrollUp(); shot("15-暗黑下载队列状态")
+        scrollUp(); shot("16-暗黑下载错误与重试")
+        show(app.staticTexts["传输进度"]); shot("17-暗黑传输进度与测速")
+        show(app.staticTexts["最近完成"]); scrollUp(); shot("18-暗黑下载完成记录")
+    }
+    func testRemoteControlsMenusAndAlert() {
+        launch(); setMode("暗黑"); tab("拍摄"); shot("19-暗黑拍摄控制")
+        app.buttons["进入实时取景"].tap()
+        XCTAssertTrue(app.buttons["停止实时取景"].waitForExistence(timeout: 10))
+        shot("20-暗黑独立实时取景与核心参数")
+        app.buttons["停止实时取景"].tap()
+        XCTAssertTrue(app.buttons["开始实时取景"].waitForExistence(timeout: 10))
+        show(app.buttons["live.parameter.iso"]); shot("23-暗黑取景相机参数")
+        app.buttons["live.parameter.iso"].tap(); shot("24-暗黑取景参数菜单"); app.buttons["200"].tap()
+        show(app.buttons["live.parameter.filmSimulation"]); shot("32-暗黑富士胶片模拟与色温")
+        app.buttons["live.parameter.filmSimulation"].tap(); shot("33-暗黑胶片模拟选项菜单")
+        app.buttons["CLASSIC CHROME / 经典正片"].tap()
+        tapFixedControl(app.buttons["退出取景"])
+        Thread.sleep(forTimeInterval: 0.6)
+        XCTAssertTrue(app.buttons["进入实时取景"].waitForExistence(timeout: 10))
+        app.buttons["遥控快门"].tap()
+        XCTAssertTrue(app.alerts.firstMatch.waitForExistence(timeout: 10))
+        shot("21-暗黑系统错误弹窗"); app.alerts.buttons["确定"].tap()
+        show(app.buttons["开始边拍边传"]); app.buttons["开始边拍边传"].tap()
+        XCTAssertTrue(app.buttons["停止边拍边传"].waitForExistence(timeout: 10))
+        shot("22-暗黑边拍边传"); app.buttons["停止边拍边传"].tap()
+    }
+    func testConnectionSetupBrandMenuPairingAndDisabledControls() {
+        launch(connected: false); setMode("暗黑"); tab("相机"); shot("25-暗黑连接表单")
+        app.buttons["connection.mode"].tap(); shot("26-暗黑相机品牌菜单")
+        app.buttons["富士 XApp 协议（实验）"].tap()
+        tapFixedControl(app.buttons["富士蓝牙配对 / 启动 Wi-Fi"])
+        XCTAssertTrue(app.buttons["搜索附近的富士相机"].waitForExistence(timeout: 10))
+        shot("27-暗黑富士配对弹层"); app.buttons["完成"].tap()
+        show(app.buttons["连接相机"]); app.buttons["连接相机"].tap()
+        XCTAssertTrue(app.buttons["停止连接"].waitForExistence(timeout: 3))
+        shot("28-暗黑停止连接按钮"); app.buttons["停止连接"].tap()
+        tab("拍摄"); XCTAssertFalse(app.buttons["进入实时取景"].isEnabled)
+        shot("29-暗黑未连接禁用状态")
+        tab("照片"); shot("30-暗黑照片空状态")
+        tab("下载"); shot("31-暗黑下载空状态")
+    }
+}
