+struct CameraCapabilityReportView: View {
+    @ObservedObject var model: CameraRemoteViewModel
+    @State private var share: WorkflowShareItem?
+    @State private var error: String?
+    var body: some View {
+        ScrollView {
+            VStack(alignment:.leading, spacing:16) {
+                Button("读取当前相机设置") { model.refreshParameters() }.disabled(!model.canPrepareWorkflow)
+                Text(model.capabilityReport()).font(.system(.footnote, design:.monospaced)).textSelection(.enabled)
+                Button("导出机型能力与连接报告") {
+                    do {
+                        let url = try WorkflowLibrary.shared.exportDirectory().appendingPathComponent("相机能力-\(UUID().uuidString.prefix(8)).txt")
+                        try Data(model.capabilityReport().utf8).write(to:url, options:.atomic); share = WorkflowShareItem(url:url)
